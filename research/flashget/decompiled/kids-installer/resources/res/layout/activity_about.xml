<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/app_bar_no_title"/>
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="14dp"
        android:onClick="onDebugClicked"
        app:layout_constraintBottom_toTopOf="@+id/tvAppName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/logo_kids_installer"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/black_de000000"
        android:layout_gravity="center"
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Common_KidsInstaller_ApkName"
        app:layout_constraintBottom_toTopOf="@+id/tvVersionName"
        app:layout_constraintEnd_toEndOf="@+id/ivLogo"
        app:layout_constraintStart_toStartOf="@+id/ivLogo"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textColor="@color/c_514c5d"
        android:layout_gravity="center"
        android:id="@+id/tvVersionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Version 1.0.0.0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        style="@style/TextStyle.Center"/>
    <com.flashget.kidsdownloader.widget.MorePreferenceTri_
        android:id="@+id/mpCheckUpdate"
        android:background="@drawable/base_list_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:title="au_check_update"
        android:onClick="appUpdate"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        app:dividerMargin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVersionName"
        app:showMoreDivider="false"/>
    <View
        android:id="@+id/divider"
        android:background="@color/ad_base_divider3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mpCheckUpdate"/>
    <com.flashget.kidsdownloader.widget.MorePreferenceTri_
        android:id="@+id/mpFeatureIntroduce"
        android:background="@drawable/base_list_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:title="@string/kid_about_feature_introduce"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        app:dividerMargin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:showMoreDivider="false"/>
    <View
        android:id="@+id/divider1"
        android:background="@color/ad_base_divider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mpFeatureIntroduce"/>
    <com.flashget.kidsdownloader.widget.MorePreferenceTri_
        android:id="@+id/mpTOS"
        android:background="@drawable/base_list_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/Common_TOS"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        app:dividerMargin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider1"
        app:showMoreDivider="false"/>
    <View
        android:id="@+id/divider2"
        android:background="@color/ad_base_divider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mpTOS"/>
    <com.flashget.kidsdownloader.widget.MorePreferenceTri_
        android:id="@+id/mpPP"
        android:background="@drawable/base_list_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Common_PrivacyPolicy"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        app:dividerMargin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        app:showMoreDivider="false"/>
    <com.flashget.kidsdownloader.widget.MorePreferenceTri_
        android:id="@+id/mpSendError"
        android:background="@drawable/base_list_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Common_SendErrorLogs_Button"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        app:dividerMargin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        app:showMoreDivider="false"/>
    <View
        android:id="@+id/divider3"
        android:background="@color/ad_base_divider3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mpPP"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/gray_a7a7a7"
        android:gravity="center"
        android:id="@+id/tvAboutPolicy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/Common_copyright_info"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
