<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_main_0"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/gradient_up2down"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/app_bar"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:paddingEnd="8dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_service"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_customer_service"/>
        <ImageView
            android:id="@+id/iv_about"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_more_black"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom"
        app:layout_constraintTop_toBottomOf="@+id/app_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                app:layout_constraintBottom_toTopOf="@+id/tvAppName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/logo_kids_installer"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_main_text"
                android:layout_gravity="center"
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Common_KidsInstaller_ApkName"
                app:layout_constraintEnd_toEndOf="@+id/ivLogo"
                app:layout_constraintStart_toStartOf="@+id/ivLogo"
                app:layout_constraintTop_toBottomOf="@+id/ivLogo"
                style="@style/TextStyle.Center"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_tips_parent"
                android:background="@drawable/corners_main_tips_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@+id/tvAppName">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/c_514089"
                    android:id="@+id/tv_faq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="FAQ"
                    android:layout_marginStart="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Center"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/corners_fff_r20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginHorizontal="1dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_faq">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_faq3"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintTop_toTopOf="parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_faq3_click"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">
                            <View
                                android:background="@drawable/corners_b596f7_r20"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"/>
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/main_title_color"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:text="@string/KidsInstaller_Faq3_Title"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp"
                                style="@style/TextStyle.Start"/>
                            <ImageView
                                android:id="@+id/iv_faq3_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:src="@drawable/icon_list_arrow_right"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="@color/c_514c5d"
                            android:id="@+id/tv_faq_content3"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/KidsInstaller_Faq3_Des"
                            android:layout_marginStart="14dp"
                            style="@style/TextStyle.Start"/>
                    </LinearLayout>
                    <View
                        android:background="@color/c_e8e6ec"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/ll_faq2"
                        app:layout_constraintTop_toBottomOf="@+id/ll_faq1"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_faq1"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintTop_toTopOf="parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_faq1_click"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">
                            <View
                                android:background="@drawable/corners_b596f7_r20"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"/>
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/main_title_color"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:text="@string/KidsInstaller_Faq1_Title"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp"
                                style="@style/TextStyle.Start"/>
                            <ImageView
                                android:id="@+id/iv_faq1_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:src="@drawable/icon_list_arrow_right"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="@color/c_514c5d"
                            android:id="@+id/tv_faq_content1"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/KidsInstaller_Faq1_Des"
                            android:layout_marginStart="14dp"
                            style="@style/TextStyle.Start"/>
                    </LinearLayout>
                    <View
                        android:background="@color/c_e8e6ec"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/ll_faq2"
                        app:layout_constraintTop_toBottomOf="@+id/ll_faq1"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_faq2"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/ll_faq1">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_faq2_click"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">
                            <View
                                android:background="@drawable/corners_b596f7_r20"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"/>
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/main_title_color"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:text="@string/KidsInstaller_Faq2_Title"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp"
                                style="@style/TextStyle.Start"/>
                            <ImageView
                                android:id="@+id/iv_faq2_arrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:src="@drawable/icon_list_arrow_right"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="@color/c_514c5d"
                            android:id="@+id/tv_faq_content2"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/KidsInstaller_Faq2_Des"
                            android:layout_marginStart="14dp"
                            style="@style/TextStyle.Start"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/iv_faq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp"
                android:src="@drawable/pic_installer_faq"
                android:translationY="-7dp"
                android:layout_marginEnd="14dp"
                app:layout_constraintEnd_toEndOf="@+id/cl_tips_parent"
                app:layout_constraintTop_toTopOf="@+id/cl_tips_parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bottom"
        android:background="@color/color_white"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:id="@+id/btn_install_kid"
            android:background="@drawable/corners_bg_btn"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:paddingBottom="7dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/Common_InstallChildApp_Button"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_open_kid"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/c_7e4ded"
            android:id="@+id/btn_open_kid"
            android:background="@drawable/corners_border_btn"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:paddingBottom="7dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="36dp"
            android:text="@string/Download_Page_Button4"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
