<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llDialog"
    android:background="@drawable/corners_fff_r16"
    android:visibility="visible"
    style="@style/ad_dlg3">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/btn_pop_update_close"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="36dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pic_pop_download_app"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/ad_dlg_content"
                    android:id="@+id/tvMessage1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/App_Cell_Downloading"
                    android:maxLines="3"
                    android:layout_weight="1"
                    style="@style/TextStyle.Center"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:textColor="@color/ad_dlg_content"
                    android:id="@+id/tvPercent"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    style="@style/TextStyle.Start"/>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/pbProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:progress="26"
                style="@style/ad_uc_progress_bar"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ad_dlg_content"
                android:gravity="end"
                android:id="@+id/tvMessage2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="7.9MB/34MB"
                android:layout_weight="1"
                style="@style/TextStyle.Start"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/c_66646a"
            android:background="@drawable/corners_rectangle_7993ff_9e81ff_10"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Download_UnknownSource_Notice"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            style="@style/TextStyle.Start"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/kid_btn_blue_p"
                android:id="@+id/tvCancel"
                android:background="@drawable/ad_dlg_btn_color_bg"
                android:layout_width="wrap_content"
                android:textDirection="locale"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@style/ad_dlg_base_btn"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
