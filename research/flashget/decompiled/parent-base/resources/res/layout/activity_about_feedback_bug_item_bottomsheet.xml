<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/feedback_bug_item_bottomsheet_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:tag="@string/BottomSheetBodyStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BottomSheetBodyStyle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/c_404040"
                android:gravity="center"
                android:id="@+id/btFeedBackItemTitle"
                android:background="@color/color_bg_2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/ad_setting_about_feedback_type"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider1"
                android:background="@color/color_border_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btFeedBackItemTitle"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:id="@+id/btFeedBackItemBugReport"
                android:background="@color/color_bg_2"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:text="@string/ad_setting_about_feedback_type_bug"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider1"
                style="@style/kid_borderless_button"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:id="@+id/btFeedBackItemSuggest"
                android:background="@color/blue_eef2ff"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:text="@string/ad_setting_about_feedback_type_suggest"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btFeedBackItemBugReport"
                style="@style/kid_borderless_button"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:id="@+id/btFeedBackItemOther"
                android:background="@color/color_bg_2"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:text="@string/ad_setting_about_feedback_type_other"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btFeedBackItemSuggest"
                style="@style/kid_borderless_button"/>
            <View
                android:id="@+id/divider2"
                android:background="@color/color_border_2"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btFeedBackItemOther"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:id="@+id/btFeedBackItemCancel"
                android:background="@color/color_bg_2"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:text="@string/Common_Cancel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider2"
                style="@style/kid_borderless_button"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
