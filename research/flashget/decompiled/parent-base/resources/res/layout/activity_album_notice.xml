<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_album_notice_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/parent_album_selected_device"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_AlbumsSafety_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view_content"
        android:tag="@string/ContentBodyStyle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:emptyResId="@layout/empty_report_data"
        style="@style/ContentBodyStyle">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <include
                android:id="@+id/cly_alert_free"
                layout="@layout/notice_payment_layout"/>
            <com.flashget.parentalcontrol.ui.component.SwitchDayPreference
                android:id="@+id/switch_day"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/dp_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cly_alert_free"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_download_mode"
                android:background="@drawable/corners_rectangle_7993ff_9e81ff_12"
                android:paddingLeft="@dimen/dp_12"
                android:paddingTop="@dimen/dp_6"
                android:paddingRight="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_6"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/AlbumsSafety_PicturesWillBeDownloaded_Des"
                android:drawablePadding="@dimen/dp_8"
                android:lineSpacingMultiplier="1.2"
                android:drawableStart="@drawable/ic_tips_purple"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_6"/>
            <com.flashget.kid.common.ui.base.views.MultiStateView
                android:id="@+id/multi_state_view"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:emptyResId="@layout/common_notification_empty"
                app:errorResId="@layout/common_notification_error"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/switch_day">
                <com.jcodecraeer.xrecyclerview.XRecyclerView
                    android:id="@+id/recycler_view"
                    android:background="@android:color/transparent"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="3"/>
            </com.flashget.kid.common.ui.base.views.MultiStateView>
            <com.flashget.kid.common.widget.WarnTipsView
                android:id="@+id/wtv_permissions"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:warn_endIconMode="close"
                app:warn_itemBackground="@drawable/bg_warn"
                app:warn_itemCornerRadius="@dimen/dp_12"
                app:warn_showMessageArrowWhenClose="true"
                app:warn_textColor="@color/color_warn_text"
                app:warn_textSize="@dimen/sp_12"/>
        </LinearLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</LinearLayout>
