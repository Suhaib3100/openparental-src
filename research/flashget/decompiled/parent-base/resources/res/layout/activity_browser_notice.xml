<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_browser_notice_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/parent_selected_device"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_BrowserSafety_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:tag="@string/ContentBodyStyle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:emptyResId="@layout/empty_report_data"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cly_browser_free"
        style="@style/ContentBodyStyle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_header"
                android:background="@drawable/corners_rectangle_e8e6ec_20"
                android:padding="@dimen/dp_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_history"
                    android:tag="binding_1"
                    android:background="@drawable/tab_selected_bg"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/guide_line"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        android:textColor="@color/tab_selected_text_color"
                        android:gravity="center"
                        android:id="@+id/tv_history"
                        android:tag="binding_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/GuideMirror_Send_HistroyTip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/img_history_tips"
                        android:visibility="gone"
                        android:layout_marginStart="@dimen/dp_2"
                        app:layout_constraintStart_toEndOf="@+id/tv_history"
                        app:layout_constraintTop_toTopOf="@+id/tv_history"
                        style="@style/Dot_No_Border"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_interception"
                    android:tag="binding_3"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guide_line"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/img_balck_tips"
                        android:layout_marginStart="@dimen/dp_2"
                        app:layout_constraintStart_toEndOf="@+id/tv_interception"
                        app:layout_constraintTop_toTopOf="@+id/tv_interception"
                        style="@style/Dot_No_Border"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        android:textColor="@color/tab_selected_text_color"
                        android:gravity="center"
                        android:id="@+id/tv_interception"
                        android:tag="binding_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_Blocked"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guide_line"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_percent="0.5"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cly_header"/>
            <com.flashget.kid.common.widget.WarnTipsView
                android:id="@+id/wtv_permissions"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:warn_endIconMode="close"
                app:warn_itemBackground="@drawable/bg_warn"
                app:warn_itemCornerRadius="@dimen/dp_12"
                app:warn_showMessageArrowWhenClose="true"
                app:warn_textColor="@color/color_warn_text"
                app:warn_textSize="@dimen/sp_12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
    <include
        android:id="@+id/cly_browser_free"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/notice_payment_layout"
        style="@style/ContentBodyStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
