<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_browser_safety_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_BrowserSafety_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:errorDrawableId="@drawable/pic_nonetwork"
        app:errorResId="@layout/activity_keyword_app_manager_error"
        app:errorTitle="@string/Common_PageLoadingFailed_Des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:tag="@string/CardBodyStyle"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CardBodyStyle">
            <com.flashget.kid.common.widget.WarnTipsView
                android:id="@+id/wtv_exceptions"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toTopOf="parent"
                app:warn_endIconMode="none"
                app:warn_iconCenterVertically="true"
                app:warn_leftIcon="@drawable/ic_tips_abnormal"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_browser_status"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:padding="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/wtv_exceptions">
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:gravity="center"
                    android:id="@+id/tv_browser_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Parent_BrowserSafety_Title"
                    android:drawablePadding="@dimen/dp_10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/img_browser_status"
                    android:tag="binding_1"
                    android:layout_width="@dimen/dp_38"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/switch_on"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_browser_status"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_browser_status"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_tertiary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@string/BrowserSafety_Feature_Des"
                    app:layout_constraintTop_toBottomOf="@+id/tv_browser_status"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/cly_browser_status_mark"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.6"
                app:layout_constraintBottom_toBottomOf="@+id/cly_browser_status"
                app:layout_constraintEnd_toEndOf="@+id/cly_browser_status"
                app:layout_constraintStart_toStartOf="@+id/cly_browser_status"
                app:layout_constraintTop_toTopOf="@+id/cly_browser_status"/>
            <com.flashget.kid.common.widget.WarnTipsView
                android:id="@+id/wtv_upgrade"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/cly_browser_status"
                app:warn_endIconMode="chevron"
                app:warn_iconCenterVertically="true"
                app:warn_leftIcon="@drawable/ic_tips_abnormal"
                app:warn_textColor="@color/color_warn_text"
                app:warn_textSize="@dimen/sp_12"/>
            <com.flashget.kid.common.widget.WarnTipsView
                android:id="@+id/wtv_all_manager_permissions"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/wtv_upgrade"
                app:warn_endIconMode="chevron"
                app:warn_itemBackground="@drawable/bg_warn"
                app:warn_itemCornerRadius="@dimen/dp_12"
                app:warn_showMessageArrowWhenClose="true"
                app:warn_textColor="@color/color_warn_text"
                app:warn_textSize="@dimen/sp_12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_intercept_mode"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/wtv_all_manager_permissions">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_intercept_mode_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/BrowserSafety_BrowserBlockingMode_Title"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_intercept_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_22"
                    android:text="@string/BrowserSafety_BlockingMode_Title"
                    android:singleLine="true"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@drawable/ic_browser_intercept"
                    android:layout_marginEnd="@dimen/dp_5"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/tv_intercept_mode_detail"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_intercept_mode_title"/>
                <com.flashget.parentalcontrol.widget.icon_text.IconTextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_intercept_mode_detail"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/BlockingMode_Option_BlockBlacklist"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_intercept_mode"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_intercept_mode"
                    app:layout_constraintTop_toTopOf="@+id/tv_intercept_mode"
                    style="@style/IconTextViewArrowStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/cly_intercept_mode_mark"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.6"
                app:layout_constraintBottom_toBottomOf="@+id/cly_intercept_mode"
                app:layout_constraintEnd_toEndOf="@+id/cly_intercept_mode"
                app:layout_constraintStart_toStartOf="@+id/cly_intercept_mode"
                app:layout_constraintTop_toTopOf="@+id/cly_intercept_mode"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_url_setting"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_13"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/cly_intercept_mode">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_url_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/BrowserSafety_URLSettings_Title"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_white_url_manager"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_url_setting">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:gravity="center"
                        android:id="@+id/tv_app_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_14"
                        android:layout_marginBottom="@dimen/dp_14"
                        android:text="@string/BrowserSafety_URLWhitelist_Title"
                        android:drawablePadding="@dimen/dp_10"
                        android:drawableStart="@drawable/ic_white_list"
                        android:layout_marginVertical="@dimen/dp_14"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_list_more_arrow"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/divider"
                        android:background="@color/color_border_2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_app_content"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_black_url_manager"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/cly_white_url_manager">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:gravity="center"
                        android:id="@+id/tv_keyword_manager"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_14"
                        android:layout_marginBottom="@dimen/dp_14"
                        android:text="@string/BrowserSafety_URLBlacklist_Title"
                        android:drawablePadding="@dimen/dp_10"
                        android:drawableStart="@drawable/ic_black_list"
                        android:layout_marginVertical="@dimen/dp_14"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/img_balck_tips"
                        android:layout_marginTop="-6dp"
                        android:layout_marginStart="@dimen/dp_24"
                        app:layout_constraintStart_toStartOf="@+id/tv_keyword_manager"
                        app:layout_constraintTop_toTopOf="@+id/tv_keyword_manager"
                        style="@style/Dot_No_Border"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_kwyword_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_list_more_arrow"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/cly_url_setting_mark"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.6"
                app:layout_constraintBottom_toBottomOf="@+id/cly_url_setting"
                app:layout_constraintEnd_toEndOf="@+id/cly_url_setting"
                app:layout_constraintStart_toStartOf="@+id/cly_url_setting"
                app:layout_constraintTop_toTopOf="@+id/cly_url_setting"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
