<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_camera_record_config_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Common_FrequencyDaily"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@android:color/black"/>
    <androidx.core.widget.NestedScrollView
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_20"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_save"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:background="@drawable/corners_rectangle_white"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16">
                <ImageView
                    android:id="@+id/img_start_now"
                    android:tag="binding_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/check_box_selector"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_start_now"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_start_now"/>
                <ImageView
                    android:id="@+id/img_start_custom"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/check_box_selector"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_start_custom"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_start_custom"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_start_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Calendars_StartTime"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_start_custom"
                    android:tag="binding_3"
                    android:paddingTop="@dimen/dp_17"
                    android:paddingBottom="@dimen/dp_17"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/UsageLimit_EveryDay_Custom_Period"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_17"
                    app:layout_constraintEnd_toStartOf="@+id/img_start_custom"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_start_now"
                    android:tag="binding_4"
                    android:paddingTop="@dimen/dp_17"
                    android:paddingBottom="@dimen/dp_17"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Parent_Device_Update_Time_Now"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_17"
                    app:layout_constraintEnd_toStartOf="@+id/img_start_now"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_start_time"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_start_custom_time"
                    android:tag="binding_5"
                    android:paddingTop="@dimen/dp_17"
                    android:paddingBottom="@dimen/dp_17"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/LimitFeature_SetTime_Title"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_17"
                    app:layout_constraintEnd_toStartOf="@+id/tv_start_custom_time_show"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider2"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_start_custom_time_show"
                    android:tag="binding_6"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:drawablePadding="@dimen/dp_3"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_start_custom_time"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_start_custom_time"
                    style="@style/TextStyle.Start"/>
                <View
                    android:id="@+id/divider"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    app:layout_constraintTop_toBottomOf="@+id/tv_start_now"/>
                <View
                    android:id="@+id/divider2"
                    android:tag="binding_7"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    app:layout_constraintTop_toBottomOf="@+id/tv_start_custom"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/corners_rectangle_white"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_timer_frequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Calendars_Repeat"
                    style="@style/TextStyle.Start"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_frequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lly_timer_frequency_times"
                android:background="@drawable/corners_rectangle_white"
                android:paddingTop="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_timer_frequency_times"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingRight="@dimen/dp_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/NumberOfRepetitions_Title"
                    android:paddingHorizontal="@dimen/dp_16"
                    style="@style/TextStyle.Start"/>
                <com.flashget.parentalcontrol.widget.NumberSeekBar
                    android:id="@+id/numberSeekBar"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingRight="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_120"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="@dimen/dp_16"
                    app:maxValue="24"
                    app:minValue="1"
                    app:progressColor="@color/color_primary"
                    app:textColor="@color/color_text_primary"
                    app:thumbColor="#ffffff"
                    app:trackColor="#e0e0e0"
                    app:value="1"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textColor="@color/color_text_white"
        android:id="@+id/btn_save"
        android:tag="binding_8"
        android:background="@drawable/corners_rectangle_7e5ded_18"
        android:padding="@dimen/dp_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_36"
        android:text="@string/Common_ModifiedSettingsPopUp_Title"
        android:layout_marginHorizontal="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/TextStyle.Center"/>
</androidx.constraintlayout.widget.ConstraintLayout>
