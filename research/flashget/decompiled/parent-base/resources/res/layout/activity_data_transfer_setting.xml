<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_data_transfer_setting_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:enabled="false"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/c_7f7e5ded"
        android:id="@+id/tv_save"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_save_btn"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tv_save"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Common_DataTransferSettings_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@android:color/black"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/CardBodyStyle">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tv_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_4"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_4"
            android:text="@string/DataTransferSettings_Des"
            android:layout_marginHorizontal="@dimen/dp_4"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_parent_setting"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/tv_tips">
            <ImageView
                android:id="@+id/img_wifi_parent_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/check_box_selector"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_wifi_parent_setting"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_wifi_parent_setting"/>
            <ImageView
                android:id="@+id/img_wifi_data_parent_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/check_box_selector"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_wifi_data_parent_setting"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_wifi_data_parent_setting"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_parent_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/Parent_DownloadSettings_Title"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_wifi_parent_setting"
                android:paddingTop="@dimen/dp_17"
                android:paddingBottom="@dimen/dp_17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/UploadMethod_WiFiOnly"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_55"
                android:paddingVertical="@dimen/dp_17"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_parent_setting"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_wifi_data_parent_setting"
                android:paddingTop="@dimen/dp_17"
                android:paddingBottom="@dimen/dp_17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Common_WIFiAndMobileData"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_55"
                android:paddingVertical="@dimen/dp_17"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_wifi_parent_setting"
                style="@style/TextStyle.Start"/>
            <View
                android:background="@color/color_border_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tv_wifi_parent_setting"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_child_setting"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_13"
            app:layout_constraintTop_toBottomOf="@+id/cly_parent_setting">
            <ImageView
                android:id="@+id/img_wifi_child_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/check_box_selector"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_wifi_child_setting"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_wifi_child_setting"/>
            <ImageView
                android:id="@+id/img_wifi_data_child_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/check_box_selector"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_wifi_data_child_setting"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_wifi_data_child_setting"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_wifi_child_setting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_17"
                android:text="@string/UploadMethod_WiFiOnly"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_46"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_child_setting"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tv_wifi_child_setting_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/AlbumsSafety_WiFiUploadTip"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_46"
                app:layout_constraintTop_toBottomOf="@+id/tv_wifi_child_setting"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_wifi_data_child_setting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_17"
                android:text="@string/Common_WIFiAndMobileData"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_46"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_wifi_child_setting_divider"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginBottom="@dimen/dp_16"
                android:text="@string/AlbumsSafety_MobileDataUploadTip"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_46"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_wifi_data_child_setting"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_child_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/Child_UploadSettings_Title"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tv_wifi_child_setting_divider"
                android:background="@color/color_border_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tv_wifi_child_setting_tips"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
