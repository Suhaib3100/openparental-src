<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ad_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <include
        android:id="@+id/include"
        layout="@layout/app_bar"/>
    <ScrollView
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/include">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="@string/ContentBodyStyle"
            android:layout_margin="20dp"
            style="@style/ContentBodyStyle">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/llJIRAInfo"
                android:background="#e7f8ec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/c_6d7c8f"
                    android:id="@+id/tvJIRAInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Please fill JIRA Product abbr. and Number"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="10dp">
                    <EditText
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:id="@+id/etJIRAProduct"
                        android:background="#ffffff"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="AM"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="6"
                        android:inputType="textCapCharacters"
                        android:textAllCaps="true"
                        style="@style/TextStyle"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/c_de000000"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tvJIRAInfoHyphen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:layout_marginStart="10dp"/>
                    <EditText
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:id="@+id/etJIRANumber"
                        android:background="#ffffff"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="6"
                        android:inputType="number"
                        android:layout_marginStart="10dp"
                        style="@style/TextStyle"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/llLogInfo"
                android:background="#e7f8ec"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/c_6d7c8f"
                    android:id="@+id/tvDateTimeInfor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Please check Log Date and Time information. (Get current system time)"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <Button
                        android:textSize="14sp"
                        android:textColor="@color/color_text_white"
                        android:layout_gravity="center"
                        android:id="@+id/btChangeDate"
                        android:background="#42c662"
                        android:nextFocusDown="@+id/button_pass"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_margin="10dp"
                        android:text="Change issue Date"
                        android:layout_below="@+id/rlCodeBar"
                        android:layout_centerHorizontal="true"
                        style="?android:attr/borderlessButtonStyle"/>
                    <TextView
                        android:textSize="20sp"
                        android:textColor="@color/c_42c662"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="15dp"
                        android:text="2021.02.01"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <Button
                        android:textSize="14sp"
                        android:textColor="@color/color_text_white"
                        android:layout_gravity="center"
                        android:id="@+id/btChangeTime"
                        android:background="#42c662"
                        android:nextFocusDown="@+id/button_pass"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_margin="10dp"
                        android:text="Change issue Time"
                        android:layout_below="@+id/rlCodeBar"
                        android:layout_centerHorizontal="true"
                        style="?android:attr/borderlessButtonStyle"/>
                    <TextView
                        android:textSize="20sp"
                        android:textColor="@color/c_42c662"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="15dp"
                        android:text="12:00"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/c_de000000"
                        android:id="@+id/tvLogFileNameTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        android:text="Upload Log file :"
                        android:layout_marginStart="10dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/c_de000000"
                        android:id="@+id/tvLogFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:text=""/>
                </LinearLayout>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/color_text_white"
                    android:layout_gravity="center"
                    android:id="@+id/btUploadLog"
                    android:background="#42c662"
                    android:layout_width="@dimen/rs_shared_code"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="上传日志"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="?android:attr/borderlessButtonStyle"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="4"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/color_text_white"
                    android:layout_gravity="center"
                    android:id="@+id/btUploadImages"
                    android:background="#42c662"
                    android:layout_width="@dimen/rs_shared_code"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="上传图片"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="?android:attr/borderlessButtonStyle"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/color_text_white"
                    android:layout_gravity="center"
                    android:id="@+id/btUploadLogWithImage"
                    android:background="#42c662"
                    android:layout_width="@dimen/rs_shared_code"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="上传日志和图片"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="?android:attr/borderlessButtonStyle"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/c_de000000"
                        android:id="@+id/tvUploadLogStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:text="Upload Log Status : "
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/c_de000000"
                        android:id="@+id/tvLogStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:text=""/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
