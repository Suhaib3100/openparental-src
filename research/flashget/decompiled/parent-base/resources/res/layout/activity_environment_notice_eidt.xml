<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_environment_notice_eidt_0"
    android:background="@color/c_f4f2f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:layout_marginEnd="@dimen/dp_8"
        android:elevation="1dp"
        app:layout_constraintEnd_toStartOf="@+id/img_select_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/icon_close"
        app:title="已选择N项"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@android:color/black"/>
    <ImageView
        android:id="@+id/img_select_all"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@drawable/parent_setting_audio_recording_multi_selector"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/album_operate_selector"
            android:id="@+id/tv_download"
            android:background="@color/color_white"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/DownloadKids_Button_Download"
            android:drawableTop="@drawable/icon_operation_bar_download"
            android:drawablePadding="@dimen/dp_2"
            android:paddingVertical="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_share"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/album_operate_selector"
            android:id="@+id/tv_share"
            android:background="@color/color_white"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/common_share"
            android:drawableTop="@drawable/icon_operation_bar_share"
            android:drawablePadding="@dimen/dp_2"
            android:paddingVertical="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_rename"
            app:layout_constraintStart_toEndOf="@+id/tv_download"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/album_operate_selector"
            android:id="@+id/tv_rename"
            android:background="@color/color_white"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Setting_Records_Rename"
            android:drawableTop="@drawable/icon_operation_bar_edit"
            android:drawablePadding="@dimen/dp_2"
            android:paddingVertical="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_delete"
            app:layout_constraintStart_toEndOf="@+id/tv_share"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/album_operate_selector"
            android:id="@+id/tv_delete"
            android:background="@color/color_white"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Setting_Records_Delete"
            android:drawableTop="@drawable/icon_operation_bar_delect"
            android:drawablePadding="@dimen/dp_2"
            android:paddingVertical="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_rename"
            style="@style/TextStyle.Center"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:emptyDrawableId="@drawable/pic_nonews"
        app:emptyTitle="@string/Common_No_Data"
        app:errorResId="@layout/activity_report_error"
        app:layout_constraintBottom_toTopOf="@+id/clBottom"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/CardBodyStyle">
            <com.jcodecraeer.xrecyclerview.XRecyclerViewMulItem
                android:id="@+id/recycler_view"
                android:paddingBottom="@dimen/dp_25"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_8"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/view"
                android:layout_width="0dp"
                android:layout_height="0.1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top"/>
            <include
                android:id="@+id/top"
                android:background="@color/color_bg_1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/dp_0"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/item_trial_header"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
    <View
        android:id="@+id/divider"
        android:background="@drawable/shadow_105352"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:translationY="2dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
