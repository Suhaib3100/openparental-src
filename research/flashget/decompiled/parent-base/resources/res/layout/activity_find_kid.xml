<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:tag="@string/CardBodyStyle"
            style="@style/CardBodyStyle">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_title_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/Parent_Bind_Open_Kid_Title"
                android:lineSpacingMultiplier="1.3"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_method_1"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_tips">
                <ImageView
                    android:id="@+id/img_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:src="@drawable/icon_small_warming"
                    app:layout_constraintStart_toStartOf="@+id/tv_content_tips1"
                    app:layout_constraintTop_toTopOf="@+id/tv_content_tips3"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_content_tips2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/FindChildApp_Method1_Des2"
                    app:layout_constraintEnd_toEndOf="@+id/tv_content_tips1"
                    app:layout_constraintStart_toStartOf="@+id/tv_content_tips1"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content_tips1"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_method_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/Parent_Bind_Open_Kid_Step1_Title"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/tv_content_tips3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/FindChildApp_Tip_Des"
                    android:layout_marginStart="@dimen/dp_2"
                    app:layout_constraintEnd_toEndOf="@+id/tv_content_tips1"
                    app:layout_constraintStart_toEndOf="@+id/img_tips"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content_tips2"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_content_tips1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/FindChildApp_Method1_Des1"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_method_1"
                    app:layout_constraintTop_toBottomOf="@+id/tv_method_1"/>
                <TextView
                    android:id="@+id/tv_open_kid"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_32"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:text="@string/Download_Page_Button4"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content_tips3"
                    style="@style/ButtonStyle"/>
                <View
                    android:background="@color/c_7f7e5ded"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_2"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_method_1"
                    app:layout_constraintEnd_toEndOf="@+id/tv_method_1"
                    app:layout_constraintStart_toStartOf="@+id/tv_method_1"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_method_2"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/cly_method_1">
                <ImageView
                    android:id="@+id/img_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_share"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_copy_kid_url"
                    app:layout_constraintEnd_toEndOf="@+id/tv_copy_kid_url"
                    app:layout_constraintTop_toTopOf="@+id/tv_copy_kid_url"/>
                <ImageView
                    android:id="@+id/img_loading"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_26"
                    android:layout_height="@dimen/dp_26"
                    android:src="@drawable/positioning_btn_refresh"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_copy_kid_url"
                    app:layout_constraintEnd_toEndOf="@+id/tv_copy_kid_url"
                    app:layout_constraintTop_toTopOf="@+id/tv_copy_kid_url"/>
                <ImageView
                    android:id="@+id/img_qr_code"
                    android:background="@drawable/dot_f4f2f8"
                    android:padding="@dimen/dp_6"
                    android:layout_width="@dimen/dp_38"
                    android:layout_height="@dimen/dp_38"
                    android:src="@drawable/pic_qr_code"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_copy_kid_url"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_copy_kid_url"/>
                <ProgressBar
                    android:id="@+id/progress"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_26"
                    android:layout_height="@dimen/dp_26"
                    android:indeterminateDrawable="@drawable/refresh_drawable"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_copy_kid_url"
                    app:layout_constraintEnd_toEndOf="@+id/tv_copy_kid_url"
                    app:layout_constraintTop_toTopOf="@+id/tv_copy_kid_url"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_content_tips4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/Parent_Bind_Open_Kid_Step1_Subtitle1"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_method_2"
                    app:layout_constraintTop_toBottomOf="@+id/tv_method_2"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_primary"
                    android:id="@+id/tv_copy_kid_url"
                    android:background="@drawable/corners_recetangle_color_border_2_20"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_12"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_11"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:text="flashget.kids/openkidflashget.kids/openkid"
                    android:paddingEnd="@dimen/dp_48"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:paddingHorizontal="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/img_qr_code"
                    app:layout_constraintStart_toStartOf="@+id/tv_content_tips4"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content_tips4"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_method_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/Parent_Bind_Open_Kid_Step2_Title"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@color/c_7f7e5ded"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_2"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_method_2"
                    app:layout_constraintEnd_toEndOf="@+id/tv_method_2"
                    app:layout_constraintStart_toStartOf="@+id/tv_method_2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Home_Find_Kids"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
