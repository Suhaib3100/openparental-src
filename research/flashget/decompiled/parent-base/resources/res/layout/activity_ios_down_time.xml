<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ios_down_time_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/FeatureName_Downtime"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:errorDrawableId="@drawable/pic_nonetwork"
        app:errorResId="@layout/activity_keyword_app_manager_error"
        app:errorTitle="@string/Common_PageLoadingFailed_Des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <FrameLayout
            android:id="@+id/fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
