<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ios_down_time_edit_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Downtime_FeatureSwitch_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_primary"
        android:gravity="center"
        android:id="@+id/tv_save"
        android:tag="binding_1"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/common_save_btn"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_header"
        android:tag="@string/CardBodyStyle"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_19"
        android:layout_marginTop="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/CardBodyStyle">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Parent_UsageLimit_Settings_Title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_title_tips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/Parent_UsageLimit_Name"
            android:singleLine="true"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintEnd_toStartOf="@+id/ed_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_switch"/>
        <EditText
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_tertiary"
            android:gravity="end"
            android:id="@+id/ed_name"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_200"
            android:hint="@string/Parent_UsageLimit_Name_Placeholder"
            android:lines="1"
            android:maxLength="200"
            android:inputType="text"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_tips"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_tips"
            style="@style/TextStyle.End"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_content"
        android:tag="@string/CardBodyStyle"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cly_header"
        style="@style/CardBodyStyle">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_content_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Parent_UsageLimit_Settings_Title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_down_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/FeatureName_Downtime"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintEnd_toStartOf="@+id/tv_down_time_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content_title"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tv_down_time_content"
            android:tag="binding_2"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dp_4"
            android:drawableEnd="@drawable/icon_list_more_arrow"
            app:layout_constraintBottom_toBottomOf="@+id/tv_down_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_down_time"
            style="@style/TextStyle.Start"/>
        <View
            android:id="@+id/divider"
            android:background="@color/color_border_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/tv_down_time"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:spanCount="7"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:tag="@string/ContentBodyStyle"
        android:layout_marginBottom="@dimen/dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ContentBodyStyle">
        <TextView
            android:id="@+id/tv_delete_limit"
            android:tag="binding_3"
            android:background="@drawable/corners_rectangle_f55e61_24"
            android:text="@string/Parent_UsageLimit_Delete_Title"
            style="@style/ButtonStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
