<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ios_open_supervised_0"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:tag="@string/ContentBodyStyle"
        android:layout_height="wrap_content"
        android:text="@string/Common_EnableFullMode_PTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/ContentBodyStyle"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_20"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/fl_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:tag="@string/ContentBodyStyle"
            android:paddingBottom="@dimen/dp_20"
            android:layout_height="wrap_content"
            style="@style/ContentBodyStyle">
            <View
                android:id="@+id/view_step_title"
                android:background="@drawable/corners_rectangle_7e5ded_18"
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="@+id/tv_step_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_step_title"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_step_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/Common_HowToEnable"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintStart_toStartOf="@+id/view_step_title"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_step"
                android:background="@drawable/corners_rectangle_e9e8ec_12_w1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_14"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_step_title">
                <View
                    android:background="@color/color_yellow"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_14"
                    app:layout_constraintEnd_toEndOf="@+id/tv_step1"
                    app:layout_constraintStart_toStartOf="@+id/tv_step1"
                    app:layout_constraintTop_toTopOf="@+id/tv_step1"/>
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_step1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/BindNewDevice_Step1_Number"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_step1_desc1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/EnableFullModePage_Step1Des"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_step1"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_step1_desc2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/Common_DownloadLink_Des"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_step1_desc1"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_download_url"
                    android:background="@drawable/corners_recetangle_colorbg1_20"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_step1_desc2">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_primary"
                        android:id="@+id/tvDownloadUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textDirection="locale"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_share"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:id="@+id/iv_share"
                        android:tag="binding_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/icon_share"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="@color/color_yellow"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_14"
                    app:layout_constraintEnd_toEndOf="@+id/tv_step2"
                    app:layout_constraintStart_toStartOf="@+id/tv_step2"
                    app:layout_constraintTop_toTopOf="@+id/tv_step2"/>
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_step2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_24"
                    android:text="@string/BindNewDevice_Step2_Number"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cly_download_url"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_step2">
                    <ImageView
                        android:id="@+id/iv_connect_img"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pic_usb_connect"
                        android:scaleType="fitCenter"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_step2_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="@string/EnableFullModePage_Step2Des"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_connect_img"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_get_code"
                        android:background="@drawable/corners_recetangle_colorbg1_20"
                        android:paddingLeft="@dimen/dp_16"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingRight="@dimen/dp_16"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:paddingHorizontal="@dimen/dp_16"
                        android:paddingVertical="@dimen/dp_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_step2_desc">
                        <TextView
                            android:textSize="@dimen/sp_22"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:ellipsize="end"
                            android:id="@+id/tv_code"
                            android:background="@drawable/corners_recetangle_colorbg1_20"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:singleLine="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/iv_refresh"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextStyle.Center"/>
                        <ImageView
                            android:id="@+id/iv_refresh"
                            android:tag="binding_2"
                            android:layout_width="@dimen/dp_24"
                            android:layout_height="@dimen/dp_24"
                            android:src="@drawable/icon_refresh_purple"
                            android:layout_marginStart="8dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_code"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_code"
                            app:layout_constraintTop_toTopOf="@+id/tv_code"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view_feature"
                android:background="@drawable/corners_rectangle_7e5ded_18"
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="@+id/tv_feature_list"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_feature_list"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_feature_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/Common_FeaturesList"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintStart_toStartOf="@+id/view_feature"
                app:layout_constraintTop_toBottomOf="@+id/cly_step"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/rv_feature_list"
                android:background="@drawable/bg_ios_open_supervised_feature_list"
                android:padding="@dimen/dp_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:clipToOutline="true"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_feature_list"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/fl_feature_legend"
                android:paddingLeft="@dimen/dp_4"
                android:paddingRight="@dimen/dp_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:paddingHorizontal="@dimen/dp_4"
                app:alignContent="flex_start"
                app:alignItems="center"
                app:flexDirection="row"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_feature_list">
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_180"
                    android:text="@string/Common_ComingSoon"
                    android:drawablePadding="@dimen/dp_4"
                    android:drawableStart="@drawable/icon_coming_soon"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_flexShrink="1"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_180"
                    android:text="@string/PartialSupport_Tag"
                    android:drawablePadding="@dimen/dp_4"
                    android:drawableStart="@drawable/icon_part_available"
                    app:layout_flexShrink="1"/>
            </com.google.android.flexbox.FlexboxLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/fl_btn"
        android:tag="@string/ContentBodyStyle"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"
        style="@style/ContentBodyStyle">
        <TextView
            android:id="@+id/tv_complete"
            android:tag="binding_3"
            android:text="@string/Common_IHaveEnabled"
            style="@style/ButtonStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
