<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/parent_category_menu"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/KeywordsCategoryPage_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:emptyTitle="@string/KeywordsCategoryPage_Empty_Des"
        app:errorDrawableId="@drawable/pic_nonetwork"
        app:errorResId="@layout/activity_keyword_app_manager_error"
        app:errorTitle="@string/Common_PageLoadingFailed_Des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:tag="@string/CardBodyStyle"
            android:layout_height="match_parent"
            style="@style/CardBodyStyle">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_tips"
                android:background="@drawable/corners_rectangle_e5dffb_9e81ff_12"
                android:paddingLeft="@dimen/dp_12"
                android:paddingTop="@dimen/dp_6"
                android:paddingRight="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:drawablePadding="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_6">
                <ImageView
                    android:layout_gravity="top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_tips_purple"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/KeywordsCategoryPage_Feature_Des"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginStart="@dimen/dp_8"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_header"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingTop="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_below="@+id/ll_tips"
                app:layout_constraintEnd_toEndOf="@+id/ll_tips"
                app:layout_constraintStart_toStartOf="@+id/ll_tips"
                app:layout_constraintTop_toBottomOf="@+id/ll_tips">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_edit_name"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingRight="@dimen/dp_16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/KeywordsCategoryPage_List_Title1"
                    android:paddingHorizontal="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:id="@+id/edit_name"
                    android:background="@null"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:hint="@string/KeywordsCategoryPage_List_Des1"
                    android:maxLines="1"
                    android:inputType="text"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_edit_name"
                    app:maxChars="30"
                    app:showBackground="false"
                    app:textPassword="false"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_above="@+id/tv_delete"
                android:layout_below="@+id/cly_header">
                <RelativeLayout
                    android:orientation="vertical"
                    android:background="@drawable/corners_rectangle_white_16dp"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/cly_header"
                    android:paddingHorizontal="@dimen/dp_16">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_edit_keyword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_Keywords"
                        android:layout_alignParentTop="true"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_edit_keyword"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_edit_keyword"/>
                </RelativeLayout>
            </FrameLayout>
            <TextView
                android:id="@+id/tv_delete"
                android:background="@drawable/corners_recetangle_ff6497_24"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_36"
                android:text="@string/KeywordsCategoryPage_Delete_Title"
                android:layout_alignParentBottom="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/ButtonStyle"/>
        </RelativeLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
