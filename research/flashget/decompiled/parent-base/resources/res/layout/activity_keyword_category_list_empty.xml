<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:tag="@string/ContentBodyStyle"
    android:layout_height="match_parent"
    style="@style/ContentBodyStyle">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tv_empty_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/KeywordManagementPage_Empty_Des"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Center"/>
    <ImageView
        android:id="@+id/img_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:src="@drawable/pic_blankpage_no_picture"
        app:layout_constraintBottom_toTopOf="@+id/tv_empty_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_empty_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/dp_4"
        android:layout_marginHorizontal="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_empty_title"
        style="@style/TextStyle.Center"/>
    <TextView
        android:id="@+id/btn_create"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_36"
        android:text="@string/KeywordManagementPage_CreateButton"
        android:layout_marginHorizontal="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
