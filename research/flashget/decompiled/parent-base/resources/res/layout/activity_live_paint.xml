<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/barView"
        android:background="@color/color_bg_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sv_paint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:tag="@string/ContentBodyStyle"
                android:paddingTop="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_16"
                android:visibility="gone"
                android:layout_height="match_parent"
                android:paddingVertical="@dimen/dp_16"
                style="@style/ContentBodyStyle">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_tips"
                    android:background="@drawable/bg_tips_normal"
                    android:paddingLeft="@dimen/dp_12"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_10">
                    <ImageView
                        android:id="@+id/iv_tips_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_tips_normal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_tips_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_tips_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/fl_doodle_view"
                    android:background="@drawable/bg_white_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16">
                    <com.cby.shareboard.draw.widget.DrawBoardView
                        android:id="@+id/draw_board_view"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="4:2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_radius="@dimen/dp_16"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.flashget.parentalcontrol.widget.doodle.DoodleActionView
                    android:id="@+id/doodle_action_view"
                    android:background="@drawable/bg_white_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textStyle="italic|bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_connect_state"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    style="@style/TextStyle.Start"/>
                <Button
                    android:textColor="@color/color_text_white"
                    android:id="@+id/btn_disconnect"
                    android:padding="@dimen/dp_5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="断开连接"
                    android:backgroundTint="@color/color_primary"/>
                <Button
                    android:textColor="@color/color_text_white"
                    android:id="@+id/btn_switch_send_interval"
                    android:padding="@dimen/dp_5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="修改小数据发送间隔"
                    android:backgroundTint="@color/color_primary"/>
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/sv_test_send_log"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:fillViewport="true"
                    android:layout_weight="1"
                    android:overScrollMode="never">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_danger_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="新数据处于顶部"
                            style="@style/TextStyle.Start"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_text_secondary"
                            android:id="@+id/tv_test_send_log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/TextStyle.Start"/>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <include
            android:id="@+id/ll_how_to_use_doodle"
            layout="@layout/layout_how_to_use_doodle_explain"/>
    </RelativeLayout>
</LinearLayout>
