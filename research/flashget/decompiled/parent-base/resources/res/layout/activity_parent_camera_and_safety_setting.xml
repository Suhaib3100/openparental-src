<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_parent_camera_and_safety_setting_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.parentalcontrol.ui.component.ParentProfileToolbar
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rightText="@string/common_save_btn"
        app:title="@string/Common_Settings"
        app:titleTextColor="@color/color_text_primary"
        app:toolbarMode="4"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:errorResId="@layout/activity_time_limit_error"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ScrollView
            android:id="@+id/scrollView"
            android:paddingBottom="@dimen/dp_20"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center_horizontal"
                android:tag="@string/CardBodyStyle"
                android:layout_height="match_parent"
                style="@style/CardBodyStyle">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_camera_snap"
                    android:background="@drawable/corners_rectangle_white_16dp"
                    android:padding="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_snap_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/CameraSnapshot_Page_Title"
                        android:drawablePadding="@dimen/dp_10"
                        android:drawableStart="@drawable/icon_setting_camera_snapshot"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_snap_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_18"
                        android:text="@string/CameraSnapshot_WakeScreen_Title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_snap_title"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:id="@+id/img_snap_switch"
                        android:tag="binding_1"
                        android:layout_width="@dimen/dp_38"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/switch_on"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_snap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_snap_content"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_secondary"
                        android:background="@drawable/corners_rectangle_7993ff_9e81ff_10"
                        android:paddingLeft="@dimen/dp_12"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingRight="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_13"
                        android:text="@string/CameraSnapshot_WakeScreen_Des"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_8"
                        app:layout_constraintTop_toBottomOf="@+id/tv_snap_content"
                        style="@style/TextStyle.Start"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_camera_remote"
                    android:background="@drawable/corners_rectangle_white_16dp"
                    android:padding="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/cly_camera_snap">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_remote_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Device_Remote_Camera_Title"
                        android:drawablePadding="@dimen/dp_10"
                        android:drawableStart="@drawable/icon_setting_live_camera"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_remote_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_18"
                        android:text="@string/RemoteCamera_WakeScreen_Title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_remote_title"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:id="@+id/img_remote_switch"
                        android:tag="binding_2"
                        android:layout_width="@dimen/dp_38"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/switch_on"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_remote_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_remote_content"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_secondary"
                        android:background="@drawable/corners_rectangle_7993ff_9e81ff_10"
                        android:paddingLeft="@dimen/dp_12"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingRight="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_13"
                        android:text="@string/RemoteCamera_WakeScreen_Des"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_8"
                        app:layout_constraintTop_toBottomOf="@+id/tv_remote_content"
                        style="@style/TextStyle.Start"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_album_security"
                    android:background="@drawable/corners_rectangle_white_16dp"
                    android:padding="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/cly_camera_remote">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_album_security_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_AlbumsSafety_Title"
                        android:drawablePadding="@dimen/dp_10"
                        android:drawableStart="@drawable/icon_setting_live_camera"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_parent_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="@string/Common_ParentAppSettings"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_album_security_title"
                        style="@style/TextStyle.Start"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_parent_constraint"
                        android:tag="binding_3"
                        android:background="@drawable/corners_recetangle_ffffff_e8e6ec_12"
                        android:paddingLeft="@dimen/dp_16"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingRight="@dimen/dp_16"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:paddingHorizontal="@dimen/dp_16"
                        android:paddingVertical="@dimen/dp_8"
                        app:layout_constraintTop_toBottomOf="@+id/tv_parent_content">
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_text_tertiary"
                            android:id="@+id/tv_parent_content_des"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Common_AutoDownload"
                            app:layout_constraintBottom_toTopOf="@+id/tv_parent_content_mode"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextStyle.Start"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_parent_content_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="WIFi and Mobile Data"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_parent_content_des"
                            style="@style/TextStyle.Start"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/icon_list_arrow_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_kid_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/Common_ChildAppSettings"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cly_parent_constraint"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_tertiary"
                        android:id="@+id/tv_kid_content_tips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/AlbumsSafety_SettingsDes"
                        app:layout_constraintTop_toBottomOf="@+id/tv_kid_content"
                        style="@style/TextStyle.Start"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_kid_constraint"
                        android:tag="binding_4"
                        android:background="@drawable/corners_recetangle_ffffff_e8e6ec_12"
                        android:paddingLeft="@dimen/dp_16"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingRight="@dimen/dp_16"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:paddingHorizontal="@dimen/dp_16"
                        android:paddingVertical="@dimen/dp_8"
                        app:layout_constraintTop_toBottomOf="@+id/tv_kid_content_tips">
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_text_tertiary"
                            android:id="@+id/tv_kid_content_des"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Common_AutoUpload"
                            app:layout_constraintBottom_toTopOf="@+id/tv_kid_content_mode"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextStyle.Start"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_kid_content_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="WIFi and Mobile Data"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_kid_content_des"
                            style="@style/TextStyle.Start"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/icon_list_arrow_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_kid_mobile_tips"
                        android:background="@drawable/corners_rectangle_7993ff_9e81ff_10"
                        android:paddingLeft="@dimen/dp_12"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingRight="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_8"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_13"
                        android:text="@string/AlbumsSafety_MobileDataUploadTip"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_8"
                        app:layout_constraintTop_toBottomOf="@+id/cly_kid_constraint"
                        style="@style/TextStyle.Start"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
