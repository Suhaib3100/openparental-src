<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    style="@style/ContentBodyStyle">
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/barView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/cl_old"
        android:padding="@dimen/dp_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barView">
        <androidx.cardview.widget.CardView
            android:id="@+id/card_view"
            android:layout_width="@dimen/dp_280"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:cardCornerRadius="@dimen/dp_20"
            app:cardElevation="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:id="@+id/cly_activities"
                android:layout_width="@dimen/dp_280"
                android:layout_height="wrap_content"
                android:transitionName="activities">
                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_168"
                    android:scaleType="fitXY"
                    app:layout_constraintDimensionRatio="W,280:168"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/color_text_primary"
                    android:gravity="center"
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_20"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    app:layout_constraintTop_toBottomOf="@+id/icon"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColorHint="@color/color_text_secondary"
                    android:id="@+id/tv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_20"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_join"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_32"
                    android:layout_marginRight="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_24"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content"
                    style="@style/ButtonStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/img_close"
            android:background="@drawable/activities_dot"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_10"
            android:src="@drawable/icon_poster_close"
            android:scaleType="centerInside"
            android:layout_alignTop="@+id/card_view"
            android:layout_marginEnd="@dimen/dp_10"
            android:layout_alignEnd="@+id/card_view"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/cl_new"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barView">
        <com.flashget.parentalcontrol.widget.AspectRatioImageView
            android:id="@+id/ivPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pic_pop_poster_en"
            android:layout_below="@+id/ivPostClose"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/ivPostClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_poster_close"
            android:layout_alignEnd="@+id/ivPost"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
