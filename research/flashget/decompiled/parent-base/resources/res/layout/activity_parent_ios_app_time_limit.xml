<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_parent_ios_app_time_limit_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_UsageLimit_AppTime_Title"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:networkErrorResId="@layout/default_network_error">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="@string/CardBodyStyle"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_20"
            style="@style/CardBodyStyle">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_no_complete_tip"
                android:background="@drawable/corners_rectangle_ffefe4_ff9142_12"
                android:paddingLeft="@dimen/dp_12"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_10"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    android:textColor="@color/color_warn_text"
                    android:id="@+id/tv_upgrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/iOSK_NotEnabledFullMode_Title"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@drawable/ic_tips_abnormal"
                    android:drawableEnd="@drawable/icon_abnormal_more"
                    app:layout_constraintTop_toBottomOf="@+id/cly_browser_status"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_warn_text"
                    android:tag="binding_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    style="@style/TextStyle.Start"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_app_time_limit_switch"
                    android:background="@drawable/bg_white_16"
                    android:padding="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_app_time_limit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_UsageLimit_AppTime_Title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_tertiary"
                        android:id="@+id/tv_app_time_limit_tip"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:text="@string/AppTimeLimits_iOS_FeatureDesShort"
                        app:layout_constraintStart_toStartOf="@+id/tv_app_time_limit"
                        app:layout_constraintTop_toBottomOf="@+id/tv_app_time_limit"
                        style="@style/TextStyle.Start"/>
                    <ToggleButton
                        android:id="@+id/toggle_app_time_limit"
                        android:background="@drawable/toggle_button"
                        android:saveEnabled="false"
                        android:layout_width="38dp"
                        android:layout_height="24dp"
                        android:checked="false"
                        android:textOn=""
                        android:textOff=""
                        app:layout_constraintBottom_toBottomOf="@+id/tv_app_time_limit"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_app_time_limit"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/cl_app_time_limit_switch_mask"
                    android:background="@drawable/bg_white_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:alpha="0.4"
                    app:layout_constraintBottom_toBottomOf="@+id/cl_app_time_limit_switch"
                    app:layout_constraintTop_toTopOf="@+id/cl_app_time_limit_switch"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_effect_description"
                android:background="@drawable/bg_white_16"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_40"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LimitFeature_Effects_Title"
                    style="@style/TextStyle.Start"/>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:src="@drawable/pic_app_disappear"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/AppTimeLimits_iOS_FeatureDes"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_app_time_limit_added_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_12">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_app_time_limit_added"
                        android:background="@drawable/bg_white_16"
                        android:paddingLeft="@dimen/dp_16"
                        android:paddingTop="@dimen/dp_16"
                        android:paddingRight="@dimen/dp_16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dp_16">
                        <TextView
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp_4"
                            android:text="@string/Parent_UsageLimit_Added"
                            style="@style/TextStyle.Start"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_app_time_limit_added"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    </LinearLayout>
                </FrameLayout>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:id="@+id/tv_app_time_limit_add"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:text="@string/Parent_UsageLimit_Add"
                    style="@style/ButtonStyle"/>
            </LinearLayout>
        </LinearLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</LinearLayout>
