<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_parent_ios_app_time_limit_edit_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_12"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/fl_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="@dimen/dp_0">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="@string/CardBodyStyle"
            android:paddingBottom="@dimen/dp_24"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            style="@style/CardBodyStyle">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cly_limit_name"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tvLimitType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/Parent_UsageLimit_Type_Title"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/cl_available_time"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_12"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_12">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_available_time_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FeatureName_AvailableTime"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_tertiary"
                        android:id="@+id/tv_available_time_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/AppTimeLimits_AvailableTime_Des"
                        app:layout_constraintStart_toStartOf="@+id/tv_available_time_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_available_time_title"
                        style="@style/TextStyle.Start"/>
                    <RadioButton
                        android:id="@+id/rb_available_time"
                        android:background="@drawable/select_app_box_style"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:checked="true"
                        android:button="@null"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_available_time_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_available_time_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/cl_down_time"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_12"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_12">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_down_time_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FeatureName_Downtime"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_tertiary"
                        android:id="@+id/tv_down_time_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/AppTimeLimits_DownTime_Des"
                        app:layout_constraintStart_toStartOf="@+id/tv_down_time_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_down_time_title"
                        style="@style/TextStyle.Start"/>
                    <RadioButton
                        android:id="@+id/rb_down_time"
                        android:background="@drawable/select_app_box_style"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:checked="true"
                        android:button="@null"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_down_time_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_down_time_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_header"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_19"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/toolbar">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Parent_UsageLimit_Settings_Title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_title_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:text="@string/Parent_UsageLimit_Name"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/dp_10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_switch"/>
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:gravity="end|center_vertical"
                    android:id="@+id/et_limit_name"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_200"
                    android:minHeight="@dimen/dp_30"
                    android:hint="@string/Parent_UsageLimit_Name_Placeholder"
                    android:lines="1"
                    android:maxLength="200"
                    android:inputType="text"
                    android:layout_marginStart="@dimen/dp_20"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_title_tips"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_title_tips"
                    app:layout_constraintTop_toTopOf="@+id/tv_title_tips"
                    style="@style/TextStyle.End"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_content"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cly_header">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_content_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/LimitFeature_SetTime_Title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_limit_time_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:text="@string/FeatureName_AvailableTime"
                    android:layout_marginEnd="@dimen/dp_10"
                    app:layout_constraintEnd_toStartOf="@+id/tv_limit_time_type_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content_title"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tv_limit_time_type_content"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_40"
                    android:minHeight="@dimen/dp_36"
                    android:drawablePadding="@dimen/dp_4"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_limit_time_type"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_limit_time_type"
                    style="@style/TextStyle.Start"/>
                <View
                    android:id="@+id/divider"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_limit_time_type"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_limit_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/divider"
                    app:spanCount="7"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clCategoryApps"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clLimits">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tvCategoryAppsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/Parent_UsageLimit_Category_And_App"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAppLimits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCategoryAppsTitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/fl_delete"
        android:tag="@string/CardBodyStyle"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CardBodyStyle">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDeleteLimits"
            android:background="@drawable/corners_recetangle_ff6497_24"
            android:text="@string/Parent_UsageLimit_Delete_Title"
            style="@style/ButtonStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
