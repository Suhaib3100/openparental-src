<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rlTop"
        android:paddingTop="38dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="19dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_white"
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parent_app_name"
            style="@style/TextStyle"/>
        <TextView
            android:textSize="26sp"
            android:textColor="@color/color_text_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:text="Sign In"
            android:layout_below="@+id/tvAppName"
            style="@style/TextStyle"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rlMain"
        android:background="@drawable/login_shape"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rlTop">
        <LinearLayout
            android:orientation="vertical"
            android:padding="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/c_404040"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                style="@style/TextStyle"/>
            <AutoCompleteTextView
                android:textSize="16sp"
                android:textColor="@color/c_404040"
                android:textColorHint="@color/c_33000000"
                android:id="@+id/etAccount"
                android:background="@drawable/kid_base_edittext_bg"
                android:nextFocusDown="@+id/etPwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Enter email"
                android:lines="1"
                android:singleLine="true"
                style="@style/TextStyle.Start"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="25dp"
            android:paddingEnd="25dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/c_404040"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                style="@style/TextStyle"/>
            <AutoCompleteTextView
                android:textSize="14sp"
                android:textColor="@color/c_404040"
                android:textColorHint="@color/c_33000000"
                android:id="@+id/etPwd"
                android:background="@drawable/kid_base_edittext_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Enter password"
                android:lines="1"
                android:singleLine="true"
                style="@style/TextStyle.Start"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/c_a4a8b3"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Forget Password ？"/>
        <Button
            android:id="@+id/btnLogin"
            android:background="@color/color_primary"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="18dp"
            android:text="登入"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            style="@style/ad_base_btn_shadow"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/c_33000000"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="OR"
            style="@style/TextStyle.Center"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/pmGooglePlus"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ad_login_google_ic"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/pmFacebook"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ad_login_facebook_ic"
                android:layout_weight="1"
                android:layout_marginStart="34dp"/>
            <ImageView
                android:id="@+id/pmTwitter"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ad_login_twitter_ic"
                android:layout_weight="1"
                android:layout_marginStart="34dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/c_a4a8b3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don’t have a account ？"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/c_ff692d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
