<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/My_Account"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llContent"
        android:tag="@string/CardBodyStyle"
        android:background="@drawable/corners_rectangle_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/CardBodyStyle">
        <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
            android:id="@+id/itemGuestDeviceId"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/icon_list_device_id"
            app:isShowDivider="true"
            app:mode="oneLine"
            app:title="@string/DeviceId_Label"/>
        <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
            android:id="@+id/itemGuestResetPassword"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/icon_list_reset_password"
            app:isShowDivider="true"
            app:mode="oneLine"
            app:title="@string/fp_btn_reset"/>
        <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
            android:id="@+id/itemGuestLogin"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/icon_list_login"
            app:isShowDivider="false"
            app:mode="oneLine"
            app:title="@string/Common_signin"/>
        <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
            android:id="@+id/logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/icon_list_log_out"
            app:isShowDivider="false"
            app:layout_constraintTop_toBottomOf="@+id/itemDevice"
            app:mode="oneLine"
            app:title="@string/Profile_Logout_Title"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
