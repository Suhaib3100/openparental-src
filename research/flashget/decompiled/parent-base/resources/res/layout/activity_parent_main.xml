<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/flContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:layout_marginBottom="@dimen/dp_60"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageView
        android:id="@+id/ivBanner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/pic_bottom_banner_en"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/view"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bottom_navigation"
        android:background="@drawable/pic_menu_bar_bg"
        android:paddingTop="42dp"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:overScrollMode="never"
        android:layoutDirection="ltr"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:spanCount="3"/>
    <View
        android:id="@+id/bannerClick"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBanner"
        app:layout_constraintEnd_toEndOf="@+id/ivBanner"
        app:layout_constraintStart_toStartOf="@+id/ivBanner"
        app:layout_constraintTop_toTopOf="@+id/ivBanner"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/ivDevice"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/dp_76"
        android:layout_height="@dimen/dp_76"
        android:layout_marginBottom="8dp"
        android:translationZ="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="icon_tab_device_sel.json"
        app:lottie_imageAssetsFolder="main_tab"
        app:lottie_loop="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
