<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bgTop"
        android:background="@color/parent_device_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/barView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toBottomOf="@+id/barView"
        app:menu="@menu/menu_parent_report_ai_detail"
        app:navigationIcon="@drawable/nav_ic_back"
        app:titleTextColor="@color/color_text_white"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:emptyDrawableId="@drawable/pic_blankpage_data_expiration"
        app:emptyTitle="@string/ThisWeekData_Expired_Des"
        app:errorResId="@layout/default_network_error"
        app:errorTitle="@string/Common_PageLoadingFailed_Des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/primary_gradient_up2down1"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ContentBodyStyle">
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_white"
                        android:id="@+id/tvReportTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:layout_constraintEnd_toStartOf="@+id/ivReportIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:id="@+id/ivReportIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:src="@drawable/pic_ai_report"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_white"
                        android:id="@+id/tvDisclaimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/AIAnalysis_Tips"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:layout_constraintEnd_toStartOf="@+id/ivReportIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvReportTitle"
                        style="@style/TextStyle.Start"/>
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/barrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="tvDisclaimer,ivReportIcon"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/llExceptionTip"
                        android:background="@drawable/corners_rectangle_7993ff_9e81ff_12"
                        android:paddingLeft="@dimen/dp_16"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingRight="@dimen/dp_16"
                        android:paddingBottom="@dimen/dp_10"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20"
                        android:paddingHorizontal="@dimen/dp_16"
                        android:paddingVertical="@dimen/dp_10"
                        app:layout_constraintTop_toBottomOf="@+id/barrier">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_tips_purple"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/exception_info_next"
                            android:id="@+id/tvExceptionTip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingMultiplier="1.2"
                            android:layout_marginStart="@dimen/dp_8"
                            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:overScrollMode="never"
                        app:layout_constraintTop_toBottomOf="@+id/llExceptionTip"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/llOriginalReportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20"
                        app:layout_constraintTop_toBottomOf="@+id/rvContent">
                        <com.flashget.parentalcontrol.widget.line.DashedLine_007e5ded_7e5dedView
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="@dimen/dp_12"
                            android:layout_marginBottom="@dimen/dp_12"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="@color/color_text_white"
                            android:background="@drawable/corner_rectangle_7896ff_9070fb_16"
                            android:paddingLeft="@dimen/dp_16"
                            android:paddingTop="@dimen/dp_4"
                            android:paddingRight="@dimen/dp_16"
                            android:paddingBottom="@dimen/dp_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/WeeklyReport_Title"
                            android:layout_marginStart="@dimen/dp_12"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:paddingHorizontal="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_4"/>
                        <com.flashget.parentalcontrol.widget.line.DashedLine_7e5ded_007e5dedView
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="@dimen/dp_12"
                            android:layout_marginBottom="@dimen/dp_12"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/fragment_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/llOriginalReportTitle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
