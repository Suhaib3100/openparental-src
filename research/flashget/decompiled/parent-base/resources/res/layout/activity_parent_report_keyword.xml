<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_parent_report_keyword_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_KeywordDetection_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/rv_multi_state_view"
            android:tag="binding_1"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_12"
            app:emptyResId="@layout/activity_parent_report_keyword_empty"
            app:errorResId="@layout/common_notification_error"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_search"
            app:searchEmptyResId="@layout/common_notification_search_empty">
            <com.jcodecraeer.xrecyclerview.XRecyclerView
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/xrvList"
                android:tag="@string/CardBodyStyle"
                android:background="@android:color/transparent"
                android:paddingBottom="25dp"
                android:clipToPadding="false"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/parentSearchView"
                style="@style/CardBodyStyle"/>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
        <FrameLayout
            android:id="@+id/fl_search"
            android:tag="binding_2"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CardBodyStyle">
            <include
                android:id="@+id/parentSearchView"
                layout="@layout/parent_search_bar_layout"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
