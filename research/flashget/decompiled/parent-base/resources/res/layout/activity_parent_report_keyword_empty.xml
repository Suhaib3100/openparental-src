<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlRoot"
    android:tag="layout/activity_parent_report_keyword_empty_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_empty"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_130"
        android:src="@drawable/pic_blankpage_data_expiration"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingLeft="@dimen/dp_20"
        android:paddingRight="@dimen/dp_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_40"
        android:text="@string/Common_DataNotSync_Title"
        android:layout_below="@+id/img_empty"
        android:layout_centerHorizontal="true"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginHorizontal="@dimen/dp_40"
        android:paddingHorizontal="@dimen/dp_20"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_secondary"
        android:gravity="center"
        android:tag="@string/ContentBodyStyle"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_40"
        android:text="@string/Common_DataNotSync_Des"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/dp_40"
        style="@style/ContentBodyStyle"/>
</RelativeLayout>
