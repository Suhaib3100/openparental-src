<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_parent_snapshot_setting_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/ScreenSnapshot_Page_Title1"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:errorResId="@layout/activity_time_limit_error"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:tag="@string/CardBodyStyle"
            android:layout_height="match_parent"
            style="@style/CardBodyStyle">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_camera_snap"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_snap_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:text="@string/Snapshot_Settings_WakeScreenToSnapshot"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_marginVertical="@dimen/dp_16"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_snap_tips"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <ImageView
                    android:id="@+id/iv_snap_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:src="@drawable/ic_tips_grey"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_snap_content"
                    app:layout_constraintEnd_toStartOf="@+id/img_snap_switch"
                    app:layout_constraintStart_toEndOf="@+id/tv_snap_content"
                    app:layout_constraintTop_toTopOf="@+id/tv_snap_content"/>
                <View
                    android:id="@+id/view_snap_tips"
                    android:tag="binding_1"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_snap_tips"
                    app:layout_constraintEnd_toEndOf="@+id/iv_snap_tips"
                    app:layout_constraintStart_toStartOf="@+id/iv_snap_tips"
                    app:layout_constraintTop_toTopOf="@+id/iv_snap_tips"/>
                <ImageView
                    android:id="@+id/img_snap_switch"
                    android:tag="binding_2"
                    android:layout_width="@dimen/dp_38"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/switch_on"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_snap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_snap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_camera_black"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/cly_camera_snap">
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_black_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/CameraSnapshot_BlackImagesPopUp_Title"
                    android:maxLines="1"
                    android:singleLine="true"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/iv_black_tips"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <ImageView
                    android:id="@+id/iv_black_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:src="@drawable/ic_tips_grey"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_black_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_black_content"
                    app:layout_constraintTop_toTopOf="@+id/tv_black_content"/>
                <View
                    android:id="@+id/view_black_tips"
                    android:tag="binding_3"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_black_tips"
                    app:layout_constraintEnd_toEndOf="@+id/iv_black_tips"
                    app:layout_constraintStart_toStartOf="@+id/iv_black_tips"
                    app:layout_constraintTop_toTopOf="@+id/iv_black_tips"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_black"
                    android:tag="binding_4"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/Snapshot_Settings_CameraActivationTime"
                    android:paddingEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toStartOf="@+id/tv_black_status"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_black_content"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:id="@+id/tv_black_status"
                    android:tag="binding_5"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:includeFontPadding="false"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_black"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_warn_text"
                    android:id="@+id/tv_upgrade"
                    android:tag="binding_6"
                    android:background="@drawable/corners_rectangle_ffefe4_ff9142_12"
                    android:paddingLeft="@dimen/dp_12"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_10"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_KidsForChildOutdated_Des"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@drawable/ic_tips_abnormal"
                    android:drawableEnd="@drawable/icon_abnormal_more"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_10"
                    app:layout_constraintTop_toBottomOf="@+id/tv_black"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
