<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Common_Time_Title"
        app:titleMarginStart="0dp"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="16dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:text="@string/Kids_TimeFormatForData_Des"
                android:lineSpacingExtra="1dp"
                android:layout_marginHorizontal="4dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/time_card"
                android:background="@drawable/bg_white_16"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="70dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/time_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_TimeFormat_Title"
                        android:labelFor="@+id/use_24_hour"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_tertiary"
                        android:id="@+id/time_example"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                <ToggleButton
                    android:id="@+id/use_24_hour"
                    android:background="@drawable/toggle_button"
                    android:saveEnabled="false"
                    android:layout_width="38dp"
                    android:layout_height="24dp"
                    android:button="@null"
                    android:textOn=""
                    android:textOff=""
                    android:contentDescription="@string/Common_TimeFormat_Title"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
