<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_parent_web_rtc_setting_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Common_LiveMonitoringSettings"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:errorResId="@layout/activity_time_limit_error"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/cly_camera_remote"
            android:tag="@string/CardBodyStyle"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:padding="@dimen/dp_16"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CardBodyStyle">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_remote_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Parent_Device_Remote_Camera_Title"
                android:drawablePadding="@dimen/dp_10"
                android:drawableStart="@drawable/icon_setting_camera_snapshot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_remote_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:text="@string/RemoteCamera_WakeScreen_Title"
                android:maxLines="1"
                android:singleLine="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/iv_web_rtc_tips"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_remote_title"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/iv_web_rtc_tips"
                android:tag="binding_1"
                android:padding="@dimen/dp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_tips_grey"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintEnd_toStartOf="@+id/img_remote_switch"
                app:layout_constraintStart_toEndOf="@+id/tv_remote_content"
                app:layout_constraintTop_toTopOf="@+id/tv_remote_content"/>
            <ImageView
                android:id="@+id/img_remote_switch"
                android:tag="binding_2"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/switch_on"
                app:layout_constraintBottom_toBottomOf="@+id/tv_remote_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_remote_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
