<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_player_0"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/v_status_bar"
        android:background="@color/color_bg_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@color/color_bg_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:layout_below="@+id/v_status_bar"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/rl_player"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.tencent.rtmp.ui.TXCloudVideoView
            android:id="@+id/play_tx_cloud_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/ll_menu"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_camera_occupied_paused"
            android:background="#80000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_camera_occupied_paused_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ContentBodyStyle">
                <ImageView
                    android:id="@+id/iv_camera_occupied_paused"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/pic_remote_camera_pause"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_white"
                    android:id="@+id/tv_camera_occupied_paused_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/Camera_Video_Paused"
                    style="@style/TextStyle.Center"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_white"
                    android:id="@+id/tv_camera_occupied_paused_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/Camera_Service_Reconnecting"
                    style="@style/TextStyle.Center"/>
                <TextView
                    android:id="@+id/tv_camera_occupied_paused_retry"
                    android:layout_marginTop="40dp"
                    android:text="@string/Common_Retry_Title"
                    style="@style/ButtonStyle"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_camera_occupied_paused_tip"
                    android:background="@drawable/bg_camera_occupied_paused_tip"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:id="@+id/iv_camera_occupied_paused_tip"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_tips_white"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#cfcfd1"
                        android:ellipsize="end"
                        android:id="@+id/tv_camera_occupied_paused_tip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Camera_Manual_Retry_Tip"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/iv_player_back"
            android:background="@drawable/bg_webrtc_back"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/nav_ic_back_black"
            android:tint="@android:color/white"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_menu"
            android:background="#000000"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_switch_flash"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/ibtn_switch_flash"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_remote_camera_light"/>
                <ImageButton
                    android:id="@+id/ibtn_switch_flash_disable"
                    android:background="@null"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_remote_camera_light_disable"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_switch_voice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/ibtn_switch_voice"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_remote_camera_voice"/>
                <ImageButton
                    android:id="@+id/ibtn_switch_voice_disable"
                    android:background="@null"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_remote_camera_voice_disable"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_switch_camera"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lav_switch_camera"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="camera_switch.json"
                    app:lottie_imageAssetsFolder="camera_switch"
                    app:lottie_loop="false"/>
                <ImageButton
                    android:id="@+id/ibtn_switch_camera_disable"
                    android:background="@null"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/icon_remote_camera_switch_disable"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/ibtn_open_bluetooth"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/icon_remote_camera_bluetooth_voice"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/ibtn_screenshot"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/icon_remote_camera_screenshot"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_overhear"
        android:tag="@string/ContentBodyStyle"
        android:background="@color/color_bg_2"
        android:paddingLeft="@dimen/dp_4"
        android:paddingRight="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_36"
        android:visibility="gone"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="@dimen/dp_4"
        style="@style/ContentBodyStyle">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1"
            android:overScrollMode="never">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="@dimen/dp_40"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clyOverhearTip"
                    android:background="@drawable/corners_rectangle_7993ff_9e81ff_12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/imgOverHearTipClose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/btn_pop_close_dark_grey"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_text_secondary"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/OneWayAudio_Tips"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_tips_purple"
                        android:layout_marginStart="@dimen/dp_12"
                        android:layout_marginEnd="23dp"
                        android:breakStrategy="simple"
                        android:paddingVertical="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/imgOverHearTipClose"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/c_666b75"
                    android:id="@+id/tvOverhearState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Parent_Device_Listening_Subtitle"
                    app:layout_constraintBottom_toTopOf="@+id/lottieAnimationView"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.35"
                    style="@style/TextStyle"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/color_text_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tvOverhearDeviceModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxLines="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvOverhearState"
                    style="@style/TextStyle.Center"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieAnimationView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="overhear_record.json"
                    app:lottie_imageAssetsFolder="overhear_record"
                    app:lottie_loop="true"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center"
                    android:id="@+id/clCountDown"
                    android:background="@drawable/parent_webrtc_overhear_timecount_bg"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:paddingStart="29dp"
                    android:paddingEnd="29dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lottieAnimationView">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/color_text_white"
                        android:id="@+id/tvRecordTitle"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Device_Listening_Recording"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/color_text_white"
                        android:id="@+id/tvOverhearRecordTimeCount"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tvRecordTitle"
                        app:layout_constraintStart_toEndOf="@+id/tvRecordTitle"
                        app:layout_constraintTop_toTopOf="@+id/tvRecordTitle"
                        style="@style/TextStyle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:id="@+id/btn_enable_bluetooth"
                    android:background="@drawable/border_f4f2f8_radius_20"
                    android:paddingLeft="@dimen/dp_12"
                    android:paddingRight="@dimen/dp_12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:text="@string/Bluetooth_Nearby_Permission_Button"
                    android:drawablePadding="@dimen/dp_4"
                    android:drawableStart="@drawable/icon_audio_bluetooth_voice"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    android:paddingHorizontal="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <TextView
            android:id="@+id/btn_record"
            android:text="@string/Parent_Device_Listening_Record"
            style="@style/FailPageBtnStyle.Main"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cl_status"
        android:background="@color/color_bg_2"
        android:visibility="gone"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_centerHorizontal="true"
        style="@style/ContentBodyStyle">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_action"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/fl_image"
                    android:tag="binding_1"
                    android:layout_width="@dimen/failed_page_anim_width"
                    android:layout_height="@dimen/failed_page_anim_height"
                    android:layout_marginTop="@dimen/dp_48"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lv_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:lottie_autoPlay="true"
                        app:lottie_fileName="pic_link_device_loading.json"
                        app:lottie_loop="false"/>
                    <ImageView
                        android:id="@+id/iv_icon"
                        android:layout_width="@dimen/failed_page_icon_width"
                        android:layout_height="@dimen/failed_page_icon_height"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:id="@+id/tv_title"
                    android:layout_marginLeft="@dimen/failed_page_content_title_margin_horizontal"
                    android:layout_marginTop="@dimen/failed_page_content_icon_and_title_space"
                    android:layout_marginRight="@dimen/failed_page_content_title_margin_horizontal"
                    android:layout_marginHorizontal="@dimen/failed_page_content_title_margin_horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/fl_image"
                    style="@style/FailPageContentTitleStyle"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/tv_device_name"
                    android:tag="binding_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_4"
                    android:layout_marginRight="@dimen/dp_4"
                    android:layout_marginHorizontal="@dimen/dp_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title"
                    style="@style/TextStyle.Center"/>
                <TextView
                    android:id="@+id/tv_content"
                    android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
                    android:layout_marginTop="@dimen/failed_page_content_title_and_desc_space"
                    android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/tv_device_name"
                    app:layout_goneMarginTop="16dp"
                    style="@style/FailPageContentDescStyle"/>
                <TextView
                    android:id="@+id/connection_contact_us"
                    android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
                    android:text="@string/Webrtc_FailedPage_Des2"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content"
                    style="@style/FailPageContentDescStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_loading_log"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="40dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/red_FF6479"
                android:id="@+id/tv_loading_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.1"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
            android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
            android:layout_marginBottom="@dimen/failed_page_padding_bottom"
            android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nsv_status">
            <TextView
                android:id="@+id/btn_confirm"
                android:layout_marginTop="@dimen/failed_page_btn_sapce"
                style="@style/FailPageBtnStyle.Main"/>
            <TextView
                android:id="@+id/btn_tutorial"
                android:visibility="gone"
                android:layout_marginTop="@dimen/failed_page_btn_sapce"
                style="@style/FailPageBtnStyle.LightMain"/>
            <TextView
                android:id="@+id/btn_switch_route"
                android:visibility="gone"
                android:layout_marginTop="@dimen/failed_page_btn_sapce"
                android:text="@string/Webrtc_SwitchLine_Button"
                style="@style/FailPageBtnStyle.LightMain"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_primary"
                android:gravity="center_horizontal"
                android:id="@+id/tv_contact_us"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/Common_ContactUs"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_tips"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/CardBodyStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rl_player_statistics"
        android:background="#4d000000"
        android:padding="@dimen/dp_10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/c_13ef1c"
            android:id="@+id/tv_player_statistics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/c_13ef1c"
            android:id="@+id/tv_video_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sv_action_statistics"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/c_13ef1c"
                android:id="@+id/tv_action_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <com.flashget.parentalcontrol.widget.MyFloatingActionButton
        android:id="@+id/fab_player_log"
        android:background="#009688"
        android:padding="@dimen/dp_10"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textColor="@color/color_text_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="log"/>
    </com.flashget.parentalcontrol.widget.MyFloatingActionButton>
    <com.flashget.parentalcontrol.widget.MyFloatingActionButton
        android:id="@+id/fab_live_api_test"
        android:background="@color/mainColorPrimary"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_text_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="直播 API\10事件测试"/>
    </com.flashget.parentalcontrol.widget.MyFloatingActionButton>
</RelativeLayout>
