<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:tag="layout/activity_snapshot_notice_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/parent_album_selected_device"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Snapshot_And_Recording"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <ImageView
        android:id="@+id/img_red_dot"
        android:layout_width="@dimen/dp_7"
        android:layout_height="@dimen/dp_7"
        android:layout_marginTop="@dimen/dp_10"
        android:src="@drawable/red_dot"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="@+id/toolbar"/>
    <include
        android:id="@+id/cly_browser_free"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/notice_payment_layout"
        style="@style/ContentBodyStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="@string/ContentBodyStyle"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cly_browser_free"
        style="@style/ContentBodyStyle">
        <com.flashget.parentalcontrol.widget.NoScrollViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cly_header"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_header"
            android:background="@drawable/corners_rectangle_e8e6ec_20"
            android:padding="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:gravity="center"
                android:id="@+id/tv_camera"
                android:tag="binding_1"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingTop="@dimen/dp_3"
                android:paddingBottom="@dimen/dp_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_screen"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imgDotCamera"
                android:visibility="gone"
                android:layout_marginStart="@dimen/dp_22"
                app:layout_constraintEnd_toEndOf="@+id/tv_camera"
                app:layout_constraintStart_toStartOf="@+id/tv_camera"
                app:layout_constraintTop_toTopOf="@+id/tv_camera"
                style="@style/Dot_No_Border"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/tv_screen"
                android:tag="binding_2"
                android:paddingTop="@dimen/dp_3"
                android:paddingBottom="@dimen/dp_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:paddingVertical="@dimen/dp_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_audio"
                app:layout_constraintStart_toEndOf="@+id/tv_camera"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imgDotScreen"
                android:visibility="gone"
                android:layout_marginStart="@dimen/dp_22"
                app:layout_constraintEnd_toEndOf="@+id/tv_screen"
                app:layout_constraintStart_toStartOf="@+id/tv_screen"
                app:layout_constraintTop_toTopOf="@+id/tv_screen"
                style="@style/Dot_No_Border"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/tv_audio"
                android:tag="binding_3"
                android:paddingTop="@dimen/dp_3"
                android:paddingBottom="@dimen/dp_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:paddingVertical="@dimen/dp_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_screen"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imgDotAudio"
                android:visibility="gone"
                android:layout_marginStart="@dimen/dp_22"
                app:layout_constraintEnd_toEndOf="@+id/tv_audio"
                app:layout_constraintStart_toStartOf="@+id/tv_audio"
                app:layout_constraintTop_toTopOf="@+id/tv_audio"
                style="@style/Dot_No_Border"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guide_line"
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintGuide_percent="0.5"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blur_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/clBottom"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.flashget.kid.common.widget.WarnTipsView
                android:id="@+id/wtv_permissions"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_11"
                app:layout_constraintBottom_toTopOf="@+id/clyContent"
                app:warn_endIconMode="close"
                app:warn_itemBackground="@drawable/bg_warn"
                app:warn_itemCornerRadius="@dimen/dp_12"
                app:warn_showMessageArrowWhenClose="true"
                app:warn_textColor="@color/color_warn_text"
                app:warn_textSize="@dimen/sp_12"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_download"
                    android:tag="binding_4"
                    android:background="@drawable/corners_rectangle_white_12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_24"
                    android:elevation="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:id="@+id/img_download_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:src="@drawable/ic_tips_purple_bg"
                        android:layout_marginStart="@dimen/dp_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/img_download_close"
                        android:tag="binding_5"
                        android:paddingLeft="@dimen/dp_12"
                        android:paddingTop="@dimen/dp_14"
                        android:paddingRight="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_14"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:src="@drawable/btn_pop_close"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="@dimen/dp_14"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:tag="binding_6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_marginBottom="@dimen/dp_12"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_marginVertical="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/img_download_close"
                        app:layout_constraintStart_toEndOf="@+id/img_download_tips"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
