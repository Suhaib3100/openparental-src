<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_snapshot_notice_edit_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_select_all"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@drawable/parent_setting_audio_recording_multi_selector"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:layout_marginEnd="@dimen/dp_8"
        android:elevation="1dp"
        app:layout_constraintEnd_toStartOf="@+id/img_select_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/icon_close"
        app:title="已选择N项"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line"
        android:layout_width="@dimen/dp_1"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintGuide_percent="0.5"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:emptyTitle="@string/Common_No_Data"
        app:errorResId="@layout/activity_report_error"
        app:layout_constraintBottom_toTopOf="@+id/tv_download"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <com.jcodecraeer.xrecyclerview.XRecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/recycler_view"
            android:tag="@string/ContentBodyStyle"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"
            style="@style/ContentBodyStyle"/>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/album_operate_selector"
        android:id="@+id/tv_download"
        android:background="@color/color_bg_2"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/DownloadKids_Button_Download"
        android:drawableTop="@drawable/ic_photo_download_selector"
        android:drawablePadding="@dimen/dp_2"
        android:paddingVertical="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guide_line"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:id="@+id/tv_delete"
        android:background="@color/color_bg_2"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Parent_Setting_Records_Delete"
        android:drawableTop="@drawable/ic_photo_delete_selector"
        android:drawablePadding="@dimen/dp_2"
        android:paddingVertical="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guide_line"
        style="@style/TextStyle.Center"/>
</androidx.constraintlayout.widget.ConstraintLayout>
