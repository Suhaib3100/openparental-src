<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_primary"
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="开始添加队列，添加完成点击【开始运行】"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_test_ok"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="开始运行"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_test"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_screen_snapshot"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="1.屏幕快照"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_test_ok"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_snapshot_font"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="2,相机快照(前置)"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_screen_snapshot"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_snapshot_back"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3.相机快照（后置）"
        android:layout_marginStart="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintBottom_toBottomOf="@+id/tv_camera_snapshot_font"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_snapshot_font"
        app:layout_constraintTop_toTopOf="@+id/tv_camera_snapshot_font"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_record_5_font"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="4.相机录制_5秒"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_camera_snapshot_font"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_record_5_back"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5.相机录制_5秒(后置)"
        android:layout_marginStart="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintBottom_toBottomOf="@+id/tv_camera_record_5_font"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_record_5_font"
        app:layout_constraintTop_toTopOf="@+id/tv_camera_record_5_font"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_record_10_font"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="6.相机录制_10秒"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_camera_record_5_font"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_record_10_back"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7.相机录制_10秒(后置)"
        android:layout_marginStart="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintBottom_toBottomOf="@+id/tv_camera_record_10_font"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_record_10_font"
        app:layout_constraintTop_toTopOf="@+id/tv_camera_record_10_font"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_record_15_font"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="8.相机录制_15秒"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_camera_record_10_font"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_record_15_back"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9.相机录制_15秒(后置)"
        android:layout_marginStart="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintBottom_toBottomOf="@+id/tv_camera_record_15_font"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_record_15_font"
        app:layout_constraintTop_toTopOf="@+id/tv_camera_record_15_font"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_record_20_font"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="10.相机录制_20秒"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_camera_record_15_back"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_camera_record_20_back"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="@dimen/dp_20"
        android:paddingTop="@dimen/dp_11"
        android:paddingRight="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11.相机录制_20秒(后置)"
        android:layout_marginStart="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_20"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintBottom_toBottomOf="@+id/tv_camera_record_20_font"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_record_20_font"
        app:layout_constraintTop_toTopOf="@+id/tv_camera_record_20_font"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="发送立即任务"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@android:color/black"/>
</androidx.constraintlayout.widget.ConstraintLayout>
