<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_subscribe_photo_album_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_AlbumsSafety_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="@string/ContentBodyStyle"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/ContentBodyStyle">
        <ImageView
            android:id="@+id/img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_88"
            android:src="@drawable/pic_blankpage_albums_safety"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColorHint="@color/color_text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_4"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_4"
            android:text="@string/Parent_AlbumsSafety_Des"
            android:layout_marginHorizontal="@dimen/dp_4"
            app:layout_constraintTop_toBottomOf="@+id/img"
            style="@style/TextStyle.Start"/>
        <TextView
            android:id="@+id/tv_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_4"
            android:layout_marginRight="@dimen/dp_4"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_SubscribeFeature_Button"
            android:layout_marginHorizontal="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/ButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
