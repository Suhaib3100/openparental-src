<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:tag="@string/ContentBodyStyle"
    android:layout_height="match_parent"
    style="@style/ContentBodyStyle">
    <Button
        android:textSize="16sp"
        android:textColor="@color/color_text_white"
        android:layout_gravity="center"
        android:id="@+id/bt_upload_log"
        android:background="#42c662"
        android:layout_width="@dimen/rs_shared_code"
        android:layout_height="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="10dp"
        android:text="上传日志"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/borderlessButtonStyle"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/color_text_white"
        android:layout_gravity="center"
        android:id="@+id/btGetAllBucket"
        android:background="#42c662"
        android:layout_width="@dimen/rs_shared_code"
        android:layout_height="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="10dp"
        android:text="获取所有的桶"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_upload_log"
        style="?android:attr/borderlessButtonStyle"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/color_text_white"
        android:layout_gravity="center"
        android:id="@+id/btCreateBucket"
        android:background="#42c662"
        android:layout_width="@dimen/rs_shared_code"
        android:layout_height="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="10dp"
        android:text="新建桶"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btGetAllBucket"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
