<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_usage_record__0"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_UsageLogs_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:errorDrawableId="@drawable/pic_nonetwork"
        app:errorResId="@layout/activity_keyword_app_manager_error"
        app:errorTitle="@string/Common_PageLoadingFailed_Des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center_horizontal"
                android:tag="@string/ContentBodyStyle"
                android:paddingBottom="@dimen/dp_20"
                android:layout_height="match_parent"
                style="@style/ContentBodyStyle">
                <ImageView
                    android:id="@+id/img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_88"
                    android:src="@drawable/pic_usage_record"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_26"
                    android:text="@string/Parent_UsageLogs_Des"
                    app:layout_constraintTop_toBottomOf="@+id/img"
                    style="@style/TextStyle.Start"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_usage_record"
                    android:background="@drawable/corners_rectangle_stroke_e8e6ec_18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_marginBottom="@dimen/dp_12"
                        android:text="@string/Parent_UsageLogs_Title"
                        android:drawablePadding="@dimen/dp_10"
                        android:drawableStart="@drawable/icon_list_usage_record"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_marginVertical="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/img_safety"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:id="@+id/img_safety"
                        android:tag="binding_1"
                        android:layout_width="@dimen/dp_38"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/toggle_button"
                        android:layout_marginEnd="@dimen/dp_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_warn_text"
                    android:id="@+id/tv_upgrade"
                    android:tag="binding_2"
                    android:background="@drawable/corners_rectangle_ffefe4_ff9142_12"
                    android:paddingLeft="@dimen/dp_12"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_10"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/Common_KidsForChildOutdated_Des"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@drawable/ic_tips_abnormal"
                    android:drawableEnd="@drawable/icon_abnormal_more"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_10"
                    app:layout_constraintTop_toBottomOf="@+id/cly_usage_record"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_warn_text"
                    android:id="@+id/tv_accessibility_not_open"
                    android:tag="binding_3"
                    android:background="@drawable/corners_rectangle_ffefe4_ff9142_12"
                    android:paddingLeft="@dimen/dp_12"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_10"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/UsageLogs_NoAccessibility_Des"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@drawable/ic_tips_abnormal"
                    android:drawableEnd="@drawable/icon_abnormal_more"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_10"
                    app:layout_constraintTop_toBottomOf="@+id/tv_upgrade"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_warn_text"
                    android:id="@+id/tv_accessibility_not_work"
                    android:tag="binding_4"
                    android:background="@drawable/corners_rectangle_ffefe4_ff9142_12"
                    android:paddingLeft="@dimen/dp_12"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_10"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/UsageLogs_NoAccessibility_Des"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@drawable/ic_tips_abnormal"
                    android:drawableEnd="@drawable/icon_abnormal_more"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_10"
                    app:layout_constraintTop_toBottomOf="@+id/tv_accessibility_not_open"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
