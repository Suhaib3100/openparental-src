<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llContainer"
        android:background="@drawable/ad_base_list_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/rlContain"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:paddingStart="17dp"
            android:paddingEnd="10dp">
            <ImageView
                android:id="@+id/ivIcon"
                android:visibility="visible"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sms"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/c_de000000"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="title"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/ivIcon"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/ivHintIcon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_sms"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/tvTitle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llSubTitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/tvTitle"
                android:layout_alignBottom="@+id/tvTitle"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_toEndOf="@+id/tvTitle">
                <ImageView
                    android:id="@+id/ivSubIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_sms"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/c_f34b4b"
                    android:id="@+id/tvSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="subtitle"
                    style="@style/TextStyle.Start"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/c_8a000000"
                android:id="@+id/tvDescription"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="desc"
                android:minLines="2"
                android:layout_below="@+id/tvTitle"
                android:textDirection="locale"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/btSwitch"
                android:layout_alignStart="@+id/tvTitle"
                style="@style/TextStyle.Start"/>
            <ToggleButton
                android:id="@+id/btSwitch"
                android:background="@drawable/ic_sms"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="20dp"
                android:checked="false"
                android:textOn=""
                android:textOff=""
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/ivArrow"/>
            <ImageView
                android:id="@+id/ivWarning"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sms"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/ivArrow"/>
            <ImageView
                android:id="@+id/ivArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/btn_right"
                android:layout_centerVertical="true"
                android:layout_marginStart="11dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/ivDivider"
            android:background="#f5f5f5"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
</merge>
