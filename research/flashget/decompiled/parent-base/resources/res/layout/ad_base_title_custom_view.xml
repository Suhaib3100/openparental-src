<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/ad_actionbar_item_selector"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/llBack"
        android:background="@drawable/ad_actionbar_item_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp">
        <ImageView
            android:id="@+id/tvArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ad_actionbar_indicator"
            android:layout_marginEnd="36dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="normal"
            android:textColor="@color/color_text_white"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bind"
            android:singleLine="true"
            android:paddingEnd="5dp"
            style="@style/TextStyle"/>
        <TextView
            android:textColor="@color/ad_main_config_title"
            android:id="@+id/tvConfigTitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextStyle"/>
    </LinearLayout>
    <Spinner
        android:id="@+id/spNavigation"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="#e6e6e6"
        android:spinnerMode="dropdown"
        style="@style/ad_base_spinner"/>
</LinearLayout>
