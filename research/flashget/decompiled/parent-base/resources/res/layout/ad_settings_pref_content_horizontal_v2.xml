<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/cly_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="4dp">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/ivDot"
        android:visibility="gone"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/summary"
        app:layout_constraintEnd_toStartOf="@+id/summary"
        app:layout_constraintTop_toTopOf="@+id/summary"
        app:lottie_autoPlay="true"
        app:lottie_fileName="red_dots_flash.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Preference subTitle"
        android:layout_below="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_primary"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Preference Title"
        android:layout_marginEnd="@dimen/dp_4"
        android:layout_alignParentStart="true"
        app:layout_constraintEnd_toStartOf="@+id/ivDot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_text_primary"
        android:gravity="end"
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preference Summary"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/TextStyle.End"/>
</androidx.constraintlayout.widget.ConstraintLayout>
