<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingBottom="27dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/rl_dot"
                    android:layout_width="8dp"
                    android:layout_height="25dp"
                    android:layout_alignParentTop="true">
                    <ImageView
                        android:id="@+id/iv_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/blue_dot"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_toggle"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true">
                    <ToggleButton
                        android:id="@+id/toggle"
                        android:background="@drawable/kid_settings_toggle_button"
                        android:visibility="visible"
                        android:saveEnabled="false"
                        android:layout_width="34dp"
                        android:layout_height="18dp"
                        android:checked="false"
                        android:textOn=""
                        android:textOff=""
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="2dp"
                        android:layout_alignParentEnd="true"/>
                    <ImageView
                        android:id="@+id/iv_pass"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_successed"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="2dp"
                        android:layout_alignParentEnd="true"/>
                    <ImageView
                        android:id="@+id/iv_warning"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_abnormal"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="2dp"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_primary"
                        android:gravity="center"
                        android:id="@+id/iv_more"
                        android:background="@drawable/ad_radius_orange_10"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="2dp"
                        android:layout_alignParentEnd="true"
                        style="@style/TextStyle"/>
                    <ImageView
                        android:id="@+id/image_more"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_view"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="2dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preference"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:textDirection="locale"
                    android:layout_marginStart="6dp"
                    android:layout_toStartOf="@+id/rl_toggle"
                    android:layout_toEndOf="@+id/rl_dot"
                    style="@style/ad_settings_pref_title"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_title">
                <RelativeLayout
                    android:id="@+id/rl_dot1"
                    android:visibility="invisible"
                    android:layout_width="8dp"
                    android:layout_height="18dp"
                    android:layout_alignParentTop="true">
                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/blue_dot"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_toggle1"
                    android:visibility="invisible"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true">
                    <ToggleButton
                        android:background="@drawable/ad_settings_toggle_button"
                        android:saveEnabled="false"
                        android:layout_width="38dp"
                        android:layout_height="25dp"
                        android:checked="false"
                        android:textOn=""
                        android:textOff=""
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="2dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preference Summary"
                    android:textDirection="locale"
                    android:layout_marginStart="6dp"
                    android:layout_toStartOf="@+id/rl_toggle1"
                    android:layout_toEndOf="@+id/rl_dot1"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
