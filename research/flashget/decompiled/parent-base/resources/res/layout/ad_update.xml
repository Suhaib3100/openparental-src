<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/corners_rectangle_white"
        android:paddingTop="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_16"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24"
        style="@style/CenterDialogBodyStyle">
        <include
            android:id="@+id/layout_top_bar"
            layout="@layout/ad_dlg_top_title_bar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:scrollbarSize="3dp"
                android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/nestedScrollView"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:fillViewport="true"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.flashget.kid.common.base.SandWebView
                    android:orientation="horizontal"
                    android:id="@+id/webView"
                    android:focusable="true"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.core.widget.NestedScrollView>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pbProgress"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:max="100"
                android:progress="50"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/nestedScrollView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/nestedScrollView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:id="@+id/llBtnPane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvCancel"
                android:background="@drawable/ad_dlg_btn_color_bg"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:text="@string/Common_Cancel"
                android:textDirection="locale"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="8dp"
                style="@style/ad_dlg_base_btn"/>
            <TextView
                android:textColor="@color/color_primary"
                android:id="@+id/tvOK"
                android:background="@drawable/ad_dlg_btn_color_bg"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:text="@string/Common_Confirm"
                android:textDirection="locale"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@style/ad_dlg_base_btn"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
