<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRoot"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp_10"
    android:paddingVertical="@dimen/dp_12">
    <ImageView
        android:id="@+id/ivInto"
        android:background="@drawable/icon_list_more_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/tvDetail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvDetail"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tvDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_see_details"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/ivInto"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
</androidx.constraintlayout.widget.ConstraintLayout>
