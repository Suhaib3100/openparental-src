<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_secondary"
        android:gravity="center"
        android:id="@+id/tvReject"
        android:background="@drawable/alert_reject_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp_54"
        android:minHeight="@dimen/dp_28"
        android:text="@string/ad_transfer_friends_reject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_white"
        android:gravity="center"
        android:id="@+id/tvAllow"
        android:background="@drawable/alert_allow_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp_54"
        android:minHeight="@dimen/dp_28"
        android:text="@string/Parent_Device_Alert_Allow"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/tvReject"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Center"/>
</androidx.constraintlayout.widget.ConstraintLayout>
