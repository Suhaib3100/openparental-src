<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/location_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/optionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:notifyVisible="true"
        app:title="@string/Parent_Device_Alert_Allow_Time"
        app:titleColor="#404040"
        app:titleSize="16"/>
    <View
        android:id="@+id/divider1"
        android:background="#e4e4e4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/optionTitle"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/optionAlways"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider1"
        app:notifyVisible="true"
        app:title="@string/Parent_UsageLimit_AlwaysAllow_Title"
        app:titleColor="#464F60"
        app:titleSize="14"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/optionToday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/optionAlways"
        app:notifyVisible="true"
        app:title="@string/Parent_Device_Alert_Today_Available"
        app:titleColor="#464F60"
        app:titleSize="14"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/optionThreeHour"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/optionToday"
        app:notifyVisible="true"
        app:title="@string/allow_use_time_three_hour"
        app:titleColor="#464F60"
        app:titleSize="14"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/optionOneHour"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/optionThreeHour"
        app:notifyVisible="true"
        app:title="@string/allow_use_time_one_hour"
        app:titleColor="#464F60"
        app:titleSize="14"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/optionThirtyMin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/optionOneHour"
        app:notifyVisible="true"
        app:title="@string/allow_use_time_one_hour"
        app:titleColor="#464F60"
        app:titleSize="14"/>
    <View
        android:id="@+id/divider2"
        android:background="#efefef"
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/optionThirtyMin"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/optionCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        app:notifyVisible="true"
        app:title="@string/Common_Cancel"
        app:titleColor="#464F60"
        app:titleSize="14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
