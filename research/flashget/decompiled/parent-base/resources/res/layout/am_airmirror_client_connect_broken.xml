<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_connection_fail"
    android:tag="layout/am_airmirror_client_connect_broken_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ll_connection_fail_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ad_airmirror_device_not_ready"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/c_de000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/connection_fail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="39dp"
            android:text="@string/am_connection_fail_title"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/connection_fail_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="@string/am_connection_fail_title_tip1"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/connection_fail_tip1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/am_connection_fail_title_tip1"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/connection_fail_tip2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/am_connection_fail_tip2"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/connection_fail_tip3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/am_connection_fail_tip3"
            style="@style/TextStyle.Start"/>
        <Button
            android:textColor="@color/color_text_white"
            android:id="@+id/button_airmirror_connection_retry"
            android:background="@drawable/kid_blue_button_style"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="64dp"
            android:text="@string/Common_Retry_Title"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</ScrollView>
