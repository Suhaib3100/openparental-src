<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/ll_webrtc_connecting"
    android:tag="layout/am_webrtc_connecting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/webrtc_animation"
        android:tag="binding_1"
        android:layout_width="@dimen/failed_page_anim_width"
        android:layout_height="@dimen/failed_page_anim_height"
        android:layout_marginTop="@dimen/webrtc_connection_img_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="pic_link_device_loading.json"
        app:lottie_loop="true"/>
    <TextView
        android:theme="@style/webrtc_connecting_title"
        android:ellipsize="end"
        android:id="@+id/tvConnectTitle"
        android:layout_marginLeft="@dimen/failed_page_content_title_margin_horizontal"
        android:layout_marginTop="@dimen/failed_page_content_icon_and_title_space"
        android:layout_marginRight="@dimen/failed_page_content_title_margin_horizontal"
        android:text="@string/AirMirror_Connecting"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/failed_page_content_title_margin_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/webrtc_animation"
        style="@style/FailPageContentTitleStyle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvConnectContent"
        android:layout_marginTop="@dimen/failed_page_content_title_and_desc_space"
        android:text="@string/AirMirror_Connecting_Text"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvConnectTitle"
        style="@style/FailPageContentDescStyle"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/c_b3f90f0f"
        android:gravity="bottom"
        android:id="@+id/tvLogInfo"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxLines="1000"
        android:singleLine="false"
        android:textDirection="locale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvConnectContent"
        style="@style/TextStyle.Start"/>
</androidx.constraintlayout.widget.ConstraintLayout>
