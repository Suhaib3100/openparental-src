<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.views.MultiStateView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/multi_state_view"
    android:tag="layout/app_selector_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:emptyDrawableId="@drawable/pic_blankpage_app_info_failed"
    app:emptyResId="@layout/parent_data_empty"
    app:emptyTitle="@string/AppList_LoadingFailed_Title"
    app:networkErrorResId="@layout/default_network_error">
    <androidx.core.widget.NestedScrollView
        android:layout_gravity="center_horizontal"
        android:tag="@string/CardBodyStyle"
        android:scrollbars="none"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constrainedHeight="true"
        style="@style/CardBodyStyle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/vg_content_body"
            android:tag="binding_1"
            android:paddingBottom="@dimen/dp_40"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/search_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/parent_search_bar_layout"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/search_view">
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_app_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/AppTimeLimits_SelectAppsPage_Des"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_80"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tv_app_tips"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_select_app_search_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pic_blankpage_no_search_results"
                app:layout_constraintBottom_toTopOf="@+id/tv_select_app_search_empty"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/search_view"
                app:layout_constraintVertical_bias="0.45"
                app:layout_constraintVertical_chainStyle="packed"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tv_select_app_search_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Common_SearchEmpty_Description"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_select_app_search_empty"
                app:layout_constraintVertical_bias="0.45"
                app:layout_constraintVertical_chainStyle="packed"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_search_result_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="iv_select_app_search_empty,tv_select_app_search_empty"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</com.flashget.kid.common.ui.base.views.MultiStateView>
