<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/bizc_camera_connection_failed_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.parentalcontrol.widget.TopScrollView
        android:orientation="vertical"
        android:id="@+id/ll_camera_connection_fail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_20"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/button_camera_retry"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.flashget.parentalcontrol.widget.SingleCountLottieAnimationView
                android:id="@+id/ll_connection_fail_icon"
                android:tag="binding_1"
                android:layout_width="@dimen/failed_page_anim_width"
                android:layout_height="@dimen/failed_page_anim_height"
                android:layout_marginTop="@dimen/webrtc_connection_img_top"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_autoPlay="true"
                app:lottie_fileName="pic_link_device_fail.json"
                app:lottie_loop="false"/>
            <TextView
                android:theme="@style/webrtc_connecting_title"
                android:id="@+id/camera_connection_fail_title"
                android:tag="binding_2"
                android:layout_marginLeft="@dimen/failed_page_content_title_margin_horizontal"
                android:layout_marginTop="@dimen/failed_page_content_icon_and_title_space"
                android:layout_marginRight="@dimen/failed_page_content_title_margin_horizontal"
                android:layout_marginHorizontal="@dimen/failed_page_content_title_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_connection_fail_icon"
                style="@style/FailPageContentTitleStyle"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tv_device_name"
                android:tag="binding_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_20"
                android:layout_marginHorizontal="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/camera_connection_fail_title"
                style="@style/TextStyle.Center"/>
            <TextView
                android:id="@+id/camera_connection_fail_tip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
                android:layout_marginTop="@dimen/failed_page_content_title_and_desc_space"
                android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
                android:text="@string/AirMirror_Connect_Target_Server_Failed_Camera"
                android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tv_device_name"
                style="@style/FailPageContentTitleStyle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/camera_connection_fail_tip_step"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
                android:layout_marginTop="@dimen/failed_page_content_title_and_desc_space"
                android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
                android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/camera_connection_fail_tip"
                style="@style/FailPageContentDescStyle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/connection_contact_us"
                android:tag="binding_5"
                android:paddingBottom="@dimen/dp_10"
                android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
                android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/camera_connection_fail_tip_step"
                style="@style/FailPageContentDescStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.parentalcontrol.widget.TopScrollView>
    <TextView
        android:id="@+id/button_camera_retry"
        android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginBottom="@dimen/failed_page_btn_sapce"
        android:text="@string/Common_Retry_Title"
        android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/button_camera_switch_route"
        app:layout_goneMarginBottom="@dimen/dp_20"
        style="@style/FailPageBtnStyle.Main"/>
    <TextView
        android:id="@+id/button_camera_switch_route"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginBottom="@dimen/dp_20"
        android:text="@string/Webrtc_SwitchLine_Button"
        android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/tv_contact_us"
        style="@style/FailPageBtnStyle.LightMain"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_contact_us"
        android:tag="binding_6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_20"
        android:text="@string/Common_ContactUs"
        app:layout_constraintBottom_toTopOf="@+id/bottom"/>
    <View
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
