<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_connecting_wait"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="97dp"
            android:layout_marginStart="58dp"
            android:layout_marginEnd="58dp">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ad_airmirror_device_icon"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/animation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="airmirror_connecting.json"
                    app:lottie_loop="true"/>
            </LinearLayout>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ad_airmirror_device_icon"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/c_de000000"
            android:layout_gravity="center"
            android:id="@+id/tvConnectWaitingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="@string/am_connecting"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/c_b3000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvConnectingContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/rs_auth_tips"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
</ScrollView>
