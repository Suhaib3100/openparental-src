<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sv_in_use_fail"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="73dp"
            android:src="@drawable/ad_airmirror_device_not_ready"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/c_de000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/vds_connection_fail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="39dp"
            android:text="@string/rs_auth_denied_title"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/vds_connection_fail_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="@string/rs_auth_in_used_tips"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_text_white"
            android:id="@+id/bt_in_use_failed_ok"
            android:background="@drawable/kid_blue_button_style"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="62dp"
            android:text="@string/Common_Confirm"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</ScrollView>
