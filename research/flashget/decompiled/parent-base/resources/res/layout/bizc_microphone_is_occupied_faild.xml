<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:tag="layout/bizc_microphone_is_occupied_faild_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_microphone_is_occupied_icon"
        android:tag="binding_1"
        android:layout_width="160dp"
        android:layout_height="110dp"
        android:layout_marginTop="@dimen/webrtc_connection_img_top"
        android:src="@drawable/pic_blankpage_occupy_microphone"
        app:layout_constraintBottom_toTopOf="@+id/tv_microphone_is_occupied_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/tv_microphone_is_occupied_title"
        android:layout_marginLeft="@dimen/failed_page_content_title_margin_horizontal"
        android:layout_marginTop="@dimen/failed_page_content_icon_and_title_space"
        android:layout_marginRight="@dimen/failed_page_content_title_margin_horizontal"
        android:text="@string/OneWayAudio_MicOccupied_Title"
        android:layout_marginHorizontal="@dimen/failed_page_content_title_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/tv_microphone_is_occupied_content"
        app:layout_constraintTop_toBottomOf="@+id/iv_microphone_is_occupied_icon"
        style="@style/FailPageContentTitleStyle"/>
    <TextView
        android:id="@+id/tv_microphone_is_occupied_content"
        android:layout_width="wrap_content"
        android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
        android:layout_marginTop="@dimen/failed_page_content_title_and_desc_space"
        android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
        android:text="@string/OneWayAudio_MicOccupied_Des"
        android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_microphone_is_occupied_title"
        style="@style/FailPageContentDescStyle"/>
    <TextView
        android:id="@+id/btn_microphone_is_occupied_retry"
        android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginBottom="@dimen/failed_page_padding_bottom"
        android:text="@string/Common_Retry_Title"
        android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/FailPageBtnStyle.Main"/>
</androidx.constraintlayout.widget.ConstraintLayout>
