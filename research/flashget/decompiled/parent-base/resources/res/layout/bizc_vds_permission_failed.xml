<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="73dp"
            android:src="@drawable/ad_airmirror_device_not_ready"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/c_b3000000"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:text="@string/am_screen_permission_failed"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_text_white"
            android:id="@+id/button_vds_permission_retry"
            android:background="@drawable/kid_blue_button_style"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="64dp"
            android:text="@string/bizc_screen_permission_request_again"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</ScrollView>
