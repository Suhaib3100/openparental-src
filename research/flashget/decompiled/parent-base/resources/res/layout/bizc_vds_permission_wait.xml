<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_camera_connection_fail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ad_vds_permission_wait"
            android:layout_marginStart="15dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/c_b3000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/connection_fail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="@string/bizc_vds_permission_wait_title"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/c_b3000000"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/bizc_vds_permission_wait_tips1"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/c_b3000000"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/am_vds_permission_wait_tips2"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
</ScrollView>
