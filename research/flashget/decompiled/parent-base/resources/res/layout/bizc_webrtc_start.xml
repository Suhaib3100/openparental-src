<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/ll_main"
    android:background="#ff000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <ImageView
        android:id="@+id/iv_full_srceen"
        android:tag="down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ad_airmirror_full_screen_down"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/rl_full_srceen"
        android:tag="down"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/ll_surfaceview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/vfNavigation"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/surfaceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ViewFlipper
        android:id="@+id/vfNavigation"
        android:background="#ff000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true">
        <include layout="@layout/am_navigation_1"/>
        <include layout="@layout/am_navigation_2"/>
        <include layout="@layout/am_navigation_3"/>
        <include layout="@layout/am_navigation_4"/>
        <include layout="@layout/ca_navigation"/>
        <include layout="@layout/sc_navigation"/>
    </ViewFlipper>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/llVoice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1"
        android:animateLayoutChanges="true">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/float_record_hint_background"
            android:layout_width="wrap_content"
            android:layout_height="180dp"
            android:minWidth="180dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_text_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvVoiceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:maxWidth="250dp"
                android:text="@string/Parent_Device_Listening_Title"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                style="@style/TextStyle.Center"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivVoiceImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_text_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvVoiceContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:maxWidth="250dp"
                android:text="@string/rs_gesture_content_enable"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                style="@style/TextStyle.Center"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/vfNavigation"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_more"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="160dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_more_left"
                android:paddingBottom="32dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="10dp">
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_full"
                        android:tag="false"
                        android:background="@drawable/ad_airmirror_full_screen"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_notify"
                        android:background="@drawable/ad_airmirror_notice_bar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_power"
                        android:background="@drawable/ad_airmirror_power_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_sc"
                        android:background="@drawable/ad_airmirror_sc_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_voice_am"
                        android:background="@drawable/am_sound_close"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_more_right"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <LinearLayout
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_rotate"
                        android:background="@drawable/ad_airmirror_rotate"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_up"
                        android:background="@drawable/ad_airmirror_up"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_volume"
                        android:background="@drawable/ad_airmirror_volume_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_st"
                        android:background="@drawable/ad_airmirror_screenshot_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_hd"
                        android:tag="sd"
                        android:background="@drawable/ad_airmirror_sd_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_navigation_change"
                        android:tag="off"
                        android:background="@drawable/am_nav_customize"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/bt_keyboard"
                        android:tag="off"
                        android:background="@drawable/ad_airmirror_keyboard_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <EditText
        android:textColor="@color/black"
        android:id="@+id/et_ime"
        android:background="#616161"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:cursorVisible="false"
        android:singleLine="true"
        android:layout_below="@+id/ll_bottom"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/bizc_cursor_color"
        style="@style/TextStyle"/>
    <RelativeLayout
        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
