<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button"
    android:background="#ff000000"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:layout_alignParentStart="true">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/bt_exit_ca"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ad_airmirror_exit"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/bt_rotate_screen_ca"
                android:tag="false"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ad_airmirror_rotate"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/bt_voice_ca"
                android:tag="false"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/am_sound_close"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_bt_switch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/bt_switch"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ad_switch_icon"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_bt_flash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/bt_flash"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ad_flashlight_icon"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/bt_full_screen_ca"
                android:tag="false"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ad_airmirror_full_screen"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
