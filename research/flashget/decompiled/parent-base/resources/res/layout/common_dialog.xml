<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_radius"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvTitle"
        android:paddingTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Account_Verification_CompletedTitle"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tvContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textDirection="locale"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <View
        android:id="@+id/divider"
        android:layout_width="@dimen/dp_1"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/tvOK"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvOK"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_tertiary"
        android:gravity="center"
        android:id="@+id/tvCancel"
        android:background="@drawable/bg_button_border"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginBottom="24dp"
        android:text="@string/Common_ContactUs"
        android:singleLine="true"
        android:textDirection="locale"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/tvOK"
        app:layout_constraintStart_toStartOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/tvOK"
        app:layout_constraintWidth_min="110dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_white"
        android:gravity="center"
        android:id="@+id/tvOK"
        android:background="@drawable/corners_rectangle"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:text="@string/Common_signup"
        android:singleLine="true"
        android:textDirection="locale"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/tvCancel"
        app:layout_constraintTop_toBottomOf="@+id/tvContent"
        app:layout_constraintWidth_min="110dp"/>
    <ImageView
        android:id="@+id/ivClose"
        android:padding="5dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/btn_pop_close"
        android:layout_marginEnd="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
