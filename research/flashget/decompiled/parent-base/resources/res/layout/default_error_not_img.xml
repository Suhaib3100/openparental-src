<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tv_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/Common_LoadingFailed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_error_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_error_title"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_white"
        android:id="@+id/btn_retry"
        android:background="@drawable/kid_blue_button_style"
        android:paddingLeft="40dp"
        android:paddingTop="6dp"
        android:paddingRight="40dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/Common_Retry_Title"
        android:textAllCaps="false"
        android:textDirection="locale"
        android:textAlignment="center"
        android:paddingHorizontal="40dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_error_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
