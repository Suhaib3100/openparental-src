<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/clContainer"
        android:background="@drawable/feature_list_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.272"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.728"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glImageStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="16dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glImageEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="16dp"/>
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:src="@drawable/device_ic_alerts"
            app:layout_constraintBottom_toBottomOf="@+id/glBottom"
            app:layout_constraintStart_toStartOf="@+id/glImageStart"
            app:layout_constraintTop_toTopOf="@+id/glTop"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/feature_item_title_color"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Device_Alert_Title"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
            app:layout_constraintEnd_toStartOf="@+id/tvNotify"
            app:layout_constraintStart_toEndOf="@+id/ivIcon"
            app:layout_constraintTop_toTopOf="@+id/ivIcon"
            style="@style/TextStyle.Start"/>
        <ImageView
            android:id="@+id/ivEnter"
            android:background="@drawable/icon_list_more_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
            app:layout_constraintEnd_toEndOf="@+id/glImageEnd"
            app:layout_constraintTop_toTopOf="@+id/ivIcon"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_text_white"
            android:gravity="center"
            android:id="@+id/tvNotify"
            android:background="@drawable/permission_perference_warning_bg"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:minWidth="20dp"
            android:minHeight="17dp"
            android:text="1"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/ivEnter"
            app:layout_constraintTop_toTopOf="@+id/ivIcon"
            style="@style/TextStyle.Center"/>
        <ImageView
            android:id="@+id/ivDivider"
            android:background="@color/color_border_2"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/glImageEnd"
            app:layout_constraintStart_toStartOf="@+id/glImageStart"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
