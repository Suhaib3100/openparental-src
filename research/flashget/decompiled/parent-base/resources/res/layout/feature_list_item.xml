<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/device_fragment_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/fipAlerts"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/device_ic_alerts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:notifyVisible="false"
        app:title="@string/Parent_Device_Alert_Title"/>
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/fipNotify"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/device_ic_notification"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fipAlerts"
        app:notifyVisible="false"
        app:title="@string/Parent_TodayEvent_Notification_Title"/>
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/screenMirroring"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/icon_list_mirroring"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fipNotify"
        app:title="@string/Parent_Device_Screenshot_Title"/>
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/remoteCamera"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/icon_list_camera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/screenMirroring"
        app:title="@string/Parent_Device_Remote_Camera_Title"/>
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/onewayAudio"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/icon_list_listen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/remoteCamera"
        app:title="@string/Parent_Device_Listening_Title"/>
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/liveLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/icon_list_live_location"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/onewayAudio"
        app:title="@string/DeviceTab_Title_LiveLocation"/>
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/fipAppList"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/device_ic_appslist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/liveLocation"
        app:title="@string/Parent_Device_Application_List_Title"/>
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/fipUsageLimit"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerVisible="false"
        app:icon="@drawable/device_ic_usagelimit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fipAppList"
        app:title="@string/Parent_UsageLimit_Title"/>
    <com.flashget.parentalcontrol.ui.component.FeatureItemPreference
        android:id="@+id/fipOpenKidGuide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerVisible="false"
        app:icon="@drawable/device_ic_tips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fipUsageLimit"
        app:title="@string/Parent_Bind_Open_Kid_Text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
