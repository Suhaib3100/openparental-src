<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="@string/BottomSheetBodyStyle"
    android:background="@drawable/feedback_bug_item_bottomsheet_bg"
    style="@style/BottomSheetBodyStyle">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/c_404040"
        android:gravity="center"
        android:id="@+id/btDeviceItemTitle"
        android:background="@color/color_bg_2"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/Parent_Device_Select_Title"
        app:layout_constraintBottom_toTopOf="@+id/divider1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Center"/>
    <View
        android:id="@+id/divider1"
        android:background="@color/color_border_2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/rvDevices"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btDeviceItemTitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDevices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider1"/>
    <View
        android:id="@+id/divider2"
        android:background="@color/color_border_2"
        android:layout_width="0dp"
        android:layout_height="6dp"
        app:layout_constraintBottom_toTopOf="@+id/btFeedBackItemCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rvDevices"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/color_text_primary"
        android:id="@+id/btFeedBackItemCancel"
        android:background="@color/color_bg_2"
        android:layout_width="0dp"
        android:layout_height="57dp"
        android:text="@string/Common_Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        style="@style/kid_borderless_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
