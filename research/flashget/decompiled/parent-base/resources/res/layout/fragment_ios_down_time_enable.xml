<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_ios_down_time_enable_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:tag="@string/CardBodyStyle"
        android:background="@color/color_bg_1"
        android:layout_height="match_parent"
        style="@style/CardBodyStyle">
        <com.flashget.kid.common.widget.WarnTipsView
            android:id="@+id/wtv_exceptions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toTopOf="parent"
            app:warn_endIconMode="none"
            app:warn_iconCenterVertically="true"
            app:warn_leftIcon="@drawable/ic_tips_abnormal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_open_limit"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_below="@+id/wtv_exceptions">
            <TextView
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Downtime_FeatureSwitch_Title"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintEnd_toStartOf="@+id/img_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/img_switch"
                android:tag="binding_1"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/switch_on"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_switch"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tv_switch_des"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:text="@string/Downtime_iOS_FeatureDes1"
                app:layout_constraintTop_toBottomOf="@+id/tv_switch"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/cly_open_limit_mark"
            android:tag="binding_2"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/cly_open_limit"
            android:layout_alignBottom="@+id/cly_open_limit"
            android:alpha="0.6"
            android:layout_alignStart="@+id/cly_open_limit"
            android:layout_alignEnd="@+id/cly_open_limit"/>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/cly_limit"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_above="@+id/tv_add_limit"
            android:layout_below="@+id/cly_open_limit"
            app:layout_constraintBottom_toTopOf="@+id/tv_add_limit"
            app:layout_constraintTop_toBottomOf="@+id/cly_open_limit">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_content_title"
                android:background="@drawable/corners_rectangle_white_top_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Parent_UsageLimit_Added"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/customize_recycler_view"
                android:tag="binding_3"
                android:background="@drawable/corners_rectangle_white_bottom_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_content_title"
                android:paddingHorizontal="@dimen/dp_16"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/tv_content_title"/>
            <View
                android:id="@+id/cly_limit_mark"
                android:tag="binding_4"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/tv_content_title"
                android:layout_alignBottom="@+id/customize_recycler_view"
                android:alpha="0.6"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/tv_add_limit"
            android:tag="binding_5"
            android:background="@drawable/corners_rectangle"
            android:layout_marginLeft="@dimen/dp_4"
            android:layout_marginRight="@dimen/dp_4"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Parent_UsageLimit_Add"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ButtonStyle"/>
    </RelativeLayout>
</FrameLayout>
