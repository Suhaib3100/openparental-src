<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_ios_use_time_disable_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:tag="@string/ContentBodyStyle"
        android:layout_height="match_parent"
        style="@style/ContentBodyStyle">
        <com.flashget.kid.common.widget.WarnTipsView
            android:id="@+id/wtv_exceptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toTopOf="parent"
            app:warn_endIconMode="none"
            app:warn_iconCenterVertically="true"
            app:warn_leftIcon="@drawable/ic_tips_abnormal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_open_limit"
            android:tag="binding_1"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/wtv_exceptions">
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Parent_UsageLimit_Time_Title"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintEnd_toStartOf="@+id/img_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/img_switch"
                android:tag="binding_2"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/switch_off"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_switch"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_effects"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:paddingLeft="@dimen/dp_16"
            android:paddingTop="@dimen/dp_16"
            android:paddingRight="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_36"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/cly_open_limit">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_content_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/LimitFeature_Effects_Title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/img_content_first"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/dp_28"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginRight="@dimen/dp_28"
                android:src="@drawable/pic_pop_app_no_network"
                android:layout_marginHorizontal="@dimen/dp_28"
                app:layout_constraintDimensionRatio="H,1:0.47"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_content_title"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_content_title_second"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/AvailableTime_iOS_FeatureDes1_StandardMode"
                app:layout_constraintTop_toBottomOf="@+id/img_content_first"/>
            <ImageView
                android:id="@+id/img_content_second"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/dp_28"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginRight="@dimen/dp_28"
                android:src="@drawable/pic_countdown"
                android:layout_marginHorizontal="@dimen/dp_28"
                app:layout_constraintDimensionRatio="H,240:138"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_content_title_second"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_content_title_third"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/AvailableTime_iOS_FeatureDes2_StandardMode"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_content_second"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
