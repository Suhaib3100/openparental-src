<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_ios_use_time_enable_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:tag="@string/ContentBodyStyle"
        android:layout_height="match_parent"
        style="@style/ContentBodyStyle">
        <com.flashget.kid.common.widget.WarnTipsView
            android:id="@+id/wtv_exceptions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toTopOf="parent"
            app:warn_endIconMode="none"
            app:warn_iconCenterVertically="true"
            app:warn_leftIcon="@drawable/ic_tips_abnormal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_open_limit"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/wtv_exceptions">
            <TextView
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Parent_UsageLimit_Time_Title"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintEnd_toStartOf="@+id/img_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/img_switch"
                android:tag="binding_1"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/switch_on"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_switch"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tv_switch_des"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:text="@string/AvailableTime_iOS_FeatureDes1"
                app:layout_constraintTop_toBottomOf="@+id/tv_switch"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/cly_open_limit_mark"
            android:tag="binding_2"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.6"
            app:layout_constraintBottom_toBottomOf="@+id/cly_open_limit"
            app:layout_constraintEnd_toEndOf="@+id/cly_open_limit"
            app:layout_constraintStart_toStartOf="@+id/cly_open_limit"
            app:layout_constraintTop_toTopOf="@+id/cly_open_limit"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_limit"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:paddingLeft="@dimen/dp_16"
            android:paddingTop="@dimen/dp_16"
            android:paddingRight="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/cly_open_limit">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_content_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/LimitFeature_LimitRules_Title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/img_every_day"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/btn_list_select_pre"
                app:layout_constraintBottom_toBottomOf="@+id/tv_everyday"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_everyday"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="@color/color_text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_everyday"
                android:tag="binding_4"
                android:paddingTop="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/common_everyday"
                android:singleLine="true"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_12"
                app:layout_constraintEnd_toStartOf="@+id/tv_every_day_time"
                app:layout_constraintStart_toEndOf="@+id/img_every_day"
                app:layout_constraintTop_toBottomOf="@+id/tv_content_title"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_primary"
                android:id="@+id/tv_every_day_time"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h 15m"
                app:layout_constraintBottom_toBottomOf="@+id/tv_everyday"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_everyday"/>
            <View
                android:id="@+id/divider"
                android:background="@color/color_border_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                app:layout_constraintTop_toBottomOf="@+id/tv_everyday"/>
            <ImageView
                android:id="@+id/img_customize"
                android:tag="binding_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/btn_list_select_nor"
                app:layout_constraintBottom_toBottomOf="@+id/tv_customize"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_customize"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="@color/color_text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_customize"
                android:tag="binding_7"
                android:paddingTop="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/UsageLimit_EveryDay_Custom_Period"
                android:singleLine="true"
                android:layout_marginStart="@dimen/dp_8"
                android:paddingVertical="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/img_customize"
                app:layout_constraintTop_toBottomOf="@+id/divider"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/customize_recycler_view"
                android:tag="binding_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_customize"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/cly_limit_mark"
            android:tag="binding_9"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.6"
            app:layout_constraintBottom_toBottomOf="@+id/cly_limit"
            app:layout_constraintEnd_toEndOf="@+id/cly_limit"
            app:layout_constraintStart_toStartOf="@+id/cly_limit"
            app:layout_constraintTop_toTopOf="@+id/cly_limit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
