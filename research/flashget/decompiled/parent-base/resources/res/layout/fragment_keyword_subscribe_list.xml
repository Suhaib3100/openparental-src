<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_keyword_subscribe_list_0"
    android:background="@color/c_f4f2f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:emptyResId="@layout/activity_keyword_category_list_empty"
        app:errorDrawableId="@drawable/pic_nonetwork"
        app:errorResId="@layout/activity_keyword_app_manager_error"
        app:errorTitle="@string/Common_PageLoadingFailed_Des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_subscribe_keyword"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/KeywordManagementPage_SubscribeSwitch"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/img_keyword_safety"
                        android:layout_width="@dimen/dp_38"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/toggle_button"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="@string/KeywordManagementPage_SubscribeSwitch_Des"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/cl_tab"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_subscribe_keyword">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/linear"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:paddingStart="@dimen/dp_3"
                    app:layout_constraintTop_toTopOf="parent">
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <com.google.android.material.tabs.TabLayout
                            android:textSize="@dimen/sp_14"
                            android:id="@+id/tl_tab"
                            android:background="@color/ad_transparent"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:layout_constraintEnd_toStartOf="@+id/iv_setting"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tabIndicator="@drawable/tab_indicator_fixed_width"
                            app:tabIndicatorFullWidth="false"
                            app:tabIndicatorGravity="bottom"
                            app:tabMode="scrollable"
                            app:tabSelectedTextColor="@color/color_primary"
                            app:tabTextColor="@color/color_text_primary"/>
                    </FrameLayout>
                    <ImageView
                        android:id="@+id/iv_setting"
                        android:padding="@dimen/dp_12"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/icon_nav_set"
                        app:layout_constraintBottom_toBottomOf="@+id/tl_tab"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tl_tab"/>
                </LinearLayout>
                <View
                    android:id="@+id/view"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    app:layout_constraintTop_toBottomOf="@+id/linear"/>
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewpage"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHeight_min="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/view"
                    app:layout_constraintVertical_bias="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
