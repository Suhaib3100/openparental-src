<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:tag="layout/fragment_parent_notification_0"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/cly_notification_free"
        layout="@layout/notice_payment_layout"/>
    <include
        android:id="@+id/parentSearchView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cly_notification_free"
        layout="@layout/parent_search_bar_layout"/>
    <com.jcodecraeer.xrecyclerview.XRecyclerView
        android:id="@+id/xrvList"
        android:background="@android:color/transparent"
        android:paddingBottom="25dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/parentSearchView"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/parentSearchView">
        <ImageView
            android:id="@+id/img_error"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:src="@drawable/pic_nonews"
            app:layout_constraintBottom_toTopOf="@+id/tvEmptyTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/Common_No_Data"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Center"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/layoutSearchNoResult"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/parentSearchView"
        app:layout_constraintVertical_bias="0.41"
        layout="@layout/search_no_result"/>
    <include
        android:id="@+id/layoutDataNotSync"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/activity_parent_report_keyword_empty"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rlLoadingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>
    </RelativeLayout>
    <com.flashget.kid.common.widget.WarnTipsView
        android:id="@+id/wtv_permissions"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:warn_endIconMode="close"
        app:warn_itemBackgroundColor="@color/color_warn_bg"
        app:warn_itemCornerRadius="@dimen/dp_12"
        app:warn_showMessageArrowWhenClose="true"
        app:warn_textColor="@color/color_warn_text"
        app:warn_textSize="@dimen/sp_12"/>
</androidx.constraintlayout.widget.ConstraintLayout>
