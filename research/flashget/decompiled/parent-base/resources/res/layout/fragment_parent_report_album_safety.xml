<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_album_safety_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_notification_content"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_new_install_report_title"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/Parent_AlbumsSafety_Title"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/icon_report_album_safe"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/msv_album_report_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorResId="@layout/fragment_parent_report_album_safety_not_free"
            app:layout_constraintTop_toBottomOf="@+id/tv_new_install_report_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColorHint="@color/color_text_secondary"
                    android:id="@+id/tv_screen_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/InappropriateImages_Title"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_22"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_album_photo_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    app:layout_constraintStart_toStartOf="@+id/tv_screen_date"
                    app:layout_constraintTop_toBottomOf="@+id/tv_screen_date"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColorHint="@color/color_text_secondary"
                    android:id="@+id/tv_album_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    app:layout_constraintStart_toStartOf="@+id/tv_screen_date"
                    app:layout_constraintTop_toBottomOf="@+id/tv_album_photo_num"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/cly_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_album_tips">
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@+id/guide_line1"
                        android:layout_width="@dimen/dp_1"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintGuide_percent="0.33"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@+id/guide_line2"
                        android:layout_width="@dimen/dp_1"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintGuide_percent="0.67"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_high"
                        android:background="@drawable/corners_recetangle_30f55e61_10"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_6"
                        app:layout_constraintEnd_toStartOf="@+id/guide_line1"
                        app:layout_constraintStart_toStartOf="parent">
                        <ImageView
                            android:id="@+id/img_high"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_24"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_24"
                            android:src="@drawable/pic_report_album_high"
                            android:layout_marginHorizontal="@dimen/dp_24"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_high_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="0"
                            app:layout_constraintEnd_toEndOf="@+id/img_high"
                            app:layout_constraintStart_toStartOf="@+id/img_high"
                            app:layout_constraintTop_toBottomOf="@+id/img_high"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_secondary"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_8"
                            android:text="@string/Common_High"
                            android:maxLines="2"
                            android:layout_marginHorizontal="@dimen/dp_8"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_high_count"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_middle"
                        android:background="@drawable/corners_recetangle_30fd7303_10"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/dp_6"
                        android:layout_marginRight="@dimen/dp_6"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/dp_6"
                        app:layout_constraintEnd_toEndOf="@+id/guide_line2"
                        app:layout_constraintStart_toStartOf="@+id/guide_line1">
                        <ImageView
                            android:id="@+id/img_middle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_24"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_24"
                            android:src="@drawable/pic_report_album_medium"
                            android:layout_marginHorizontal="@dimen/dp_24"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_middle_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="0"
                            app:layout_constraintEnd_toEndOf="@+id/img_middle"
                            app:layout_constraintStart_toStartOf="@+id/img_middle"
                            app:layout_constraintTop_toBottomOf="@+id/img_middle"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_secondary"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_8"
                            android:text="@string/Common_Medium"
                            android:maxLines="2"
                            android:layout_marginHorizontal="@dimen/dp_8"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_middle_count"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_low"
                        android:background="@drawable/corners_recetangle_30ffca2a_10"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/guide_line2"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/img_low"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_24"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_24"
                            android:src="@drawable/pic_report_album_low"
                            android:layout_marginHorizontal="@dimen/dp_24"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_low_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="0"
                            app:layout_constraintEnd_toEndOf="@+id/img_low"
                            app:layout_constraintStart_toStartOf="@+id/img_low"
                            app:layout_constraintTop_toBottomOf="@+id/img_low"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_secondary"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_8"
                            android:text="@string/Common_Low"
                            android:maxLines="2"
                            android:layout_marginHorizontal="@dimen/dp_8"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_low_count"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <com.flashget.kid.common.ui.base.views.MultiStateView
                    android:id="@+id/msv_album_safety_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:errorResId="@layout/fragment_parent_report_album_safety_empty"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cly_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_album_see_detail"
                            android:tag="binding_1"
                            android:paddingTop="@dimen/dp_16"
                            android:paddingBottom="@dimen/dp_16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/common_see_details"
                            android:drawableEnd="@drawable/icon_list_more_arrow"
                            android:paddingEnd="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
                        <View
                            android:id="@+id/view_line"
                            android:background="@color/color_border_2"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_1"
                            android:layout_marginTop="@dimen/dp_25"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.flashget.kid.common.ui.base.views.MultiStateView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
