<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_calllog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_calllog_content"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_calllog_report_title"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/Feature_Title_CallAnalysis"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/icon_report_call_analysis"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/msv_calllog_report_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorResId="@layout/fragment_parent_report_calllog_not_free"
            app:layout_constraintTop_toBottomOf="@+id/tv_calllog_report_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guide_line"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_percent="0.5"
                    app:layout_constraintStart_toStartOf="parent"/>
                <LinearLayout
                    android:id="@+id/cly_calllog_anizy_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_call"
                        android:tag="binding_1"
                        android:background="@drawable/corner_rectangle_147e5ded_8_7e5ded"
                        android:paddingLeft="@dimen/dp_10"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingRight="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_marginEnd="@dimen/dp_6"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_8"
                        app:layout_constraintEnd_toStartOf="@+id/guide_line"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_primary"
                            android:ellipsize="end"
                            android:id="@+id/tv_call_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/Calls_Title"
                            android:singleLine="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_call_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="483"
                            app:layout_constraintStart_toStartOf="@+id/tv_call_title"
                            app:layout_constraintTop_toBottomOf="@+id/tv_call_title"/>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="@color/color_text_secondary"
                            android:gravity="start"
                            android:id="@+id/tv_call_compare"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="比昨天"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tv_call_title"
                            app:layout_constraintTop_toBottomOf="@+id/tv_call_num"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_call_duration"
                        android:tag="binding_2"
                        android:background="@drawable/corners_rectangle_e9e8ec_8_w1"
                        android:paddingLeft="@dimen/dp_10"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingRight="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_marginEnd="@dimen/dp_16"
                        android:paddingHorizontal="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/guide_line"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_primary"
                            android:ellipsize="end"
                            android:id="@+id/tv_call_duration_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/CallLogs_Duration"
                            android:singleLine="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_call_duration_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="483"
                            app:layout_constraintStart_toStartOf="@+id/tv_call_duration_title"
                            app:layout_constraintTop_toBottomOf="@+id/tv_call_duration_title"/>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="@color/color_text_secondary"
                            android:gravity="start"
                            android:id="@+id/tv_call_duration_compare"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="比昨天"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tv_call_duration_title"
                            app:layout_constraintTop_toBottomOf="@+id/tv_call_duration_num"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pie_chart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_144"
                    android:layout_marginTop="@dimen/dp_27"
                    android:layout_marginEnd="@dimen/dp_6"
                    app:layout_constraintEnd_toEndOf="@+id/guide_line"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cly_calllog_anizy_content"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_call_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toBottomOf="@+id/pie_chart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guide_line"
                    app:layout_constraintTop_toTopOf="@+id/pie_chart"/>
                <View
                    android:id="@+id/view_line"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_25"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/pie_chart"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_block_calls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/view_line">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_screen_report_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20"
                        android:text="@string/Calls_BlockedCalls_Title"
                        android:drawablePadding="@dimen/dp_8"
                        android:drawableStart="@drawable/icon_report_call_intercept"
                        android:layout_marginStart="@dimen/dp_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="vertical"
                        android:id="@+id/guide_line2"
                        android:layout_width="@dimen/dp_1"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintGuide_percent="0.5"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:ellipsize="end"
                        android:id="@+id/tv_visit_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20"
                        android:text="@string/Calls_BlockedCount_Title"
                        android:singleLine="true"
                        android:drawablePadding="@dimen/dp_4"
                        android:drawableStart="@drawable/icon_report_call_intercept_count"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_marginEnd="@dimen/dp_6"
                        app:layout_constraintEnd_toStartOf="@+id/guide_line2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_screen_report_title"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_visit_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="483"
                        app:layout_constraintStart_toStartOf="@+id/tv_visit_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_visit_title"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:gravity="start"
                        android:id="@+id/tv_visit_compare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="比昨天"
                        app:layout_constraintEnd_toStartOf="@+id/guide_line2"
                        app:layout_constraintStart_toStartOf="@+id/tv_visit_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_visit_num"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:ellipsize="end"
                        android:id="@+id/tv_intercept_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Calls_BlockedNumbers_Title"
                        android:singleLine="true"
                        android:drawablePadding="@dimen/dp_4"
                        android:drawableStart="@drawable/icon_report_call_intercept_number"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_marginEnd="@dimen/dp_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/guide_line2"
                        app:layout_constraintTop_toTopOf="@+id/tv_visit_title"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_intercept_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="483"
                        app:layout_constraintStart_toStartOf="@+id/tv_intercept_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_intercept_title"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:gravity="start"
                        android:id="@+id/tv_intercept_compare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="比昨天"
                        app:layout_constraintEnd_toEndOf="@+id/tv_intercept_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_intercept_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_intercept_num"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.flashget.kid.common.ui.base.views.MultiStateView
                    android:id="@+id/multi_block_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorResId="@layout/fragment_parent_report_calllog_empty"
                    app:layout_constraintTop_toBottomOf="@+id/cly_block_calls">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_block_calls"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_16"
                            android:layout_marginTop="@dimen/dp_21"
                            android:layout_marginRight="@dimen/dp_16"
                            android:layout_marginHorizontal="@dimen/dp_16"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_call_report_all"
                            android:tag="binding_3"
                            android:paddingTop="@dimen/dp_16"
                            android:paddingBottom="@dimen/dp_16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/common_see_details"
                            android:drawableEnd="@drawable/icon_list_more_arrow"
                            android:paddingEnd="@dimen/dp_16"
                            android:layout_marginStart="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/view_line2"/>
                        <View
                            android:id="@+id/view_line2"
                            android:background="@color/color_border_2"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_1"
                            android:layout_marginLeft="@dimen/dp_16"
                            android:layout_marginTop="@dimen/dp_24"
                            android:layout_marginRight="@dimen/dp_16"
                            android:layout_marginHorizontal="@dimen/dp_16"
                            app:layout_constraintTop_toBottomOf="@+id/rv_block_calls"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.flashget.kid.common.ui.base.views.MultiStateView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
