<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.views.MultiStateView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/multi_state_view"
    android:tag="layout/fragment_parent_report_day_and_week_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:emptyTitle="@string/Common_No_Data"
    app:errorResId="@layout/activity_report_error">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/parent_report_day_and_week"
            android:tag="binding_1"
            android:background="@color/color_bg_1"
            android:layout_height="match_parent"
            style="@style/ContentBodyStyle">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_tertiary"
                android:gravity="center_horizontal"
                android:id="@+id/tv_current_refresh_time"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/snapshot_switch_day"/>
            <include
                android:id="@+id/snapshot_switch_day"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_36"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/fragment_parent_report_switch_time"/>
            <include
                android:id="@+id/include_lower_version"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tv_current_refresh_time"
                layout="@layout/fragment_parent_report_lower_version"/>
            <include
                android:id="@+id/include_permission_exception"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_lower_version"
                layout="@layout/fragment_parent_report_permission_exception"/>
            <include
                android:id="@+id/include_time_exception"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_permission_exception"
                layout="@layout/fragment_parent_report_time_exception"/>
            <include
                android:id="@+id/include_rate_level"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_time_exception"
                layout="@layout/fragment_parent_report_rate_level"/>
            <include
                android:id="@+id/include_app_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_screen_time"
                layout="@layout/fragment_parent_report_app"/>
            <include
                android:id="@+id/include_social_detect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_app_time"
                layout="@layout/fragment_parent_report_social_detect"/>
            <include
                android:id="@+id/include_browser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_social_detect"
                layout="@layout/fragment_parent_report_browser"/>
            <include
                android:id="@+id/include_screen_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_rate_level"
                layout="@layout/fragment_parent_report_screen"/>
            <include
                android:id="@+id/include_keyword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_browser"
                layout="@layout/fragment_parent_report_keyword"/>
            <include
                android:id="@+id/include_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_keyword"
                layout="@layout/fragment_parent_report_location"/>
            <include
                android:id="@+id/include_calllog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_location"
                layout="@layout/fragment_parent_report_calllog"/>
            <include
                android:id="@+id/include_smslog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_calllog"
                layout="@layout/fragment_parent_report_smslog"/>
            <include
                android:id="@+id/include_album_safety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_smslog"
                layout="@layout/fragment_parent_report_album_safety"/>
            <include
                android:id="@+id/include_new_install_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/include_album_safety"
                layout="@layout/fragment_parent_report_new_install"/>
            <include
                android:id="@+id/include_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/include_new_install_app"
                layout="@layout/fragment_parent_report_notification"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</com.flashget.kid.common.ui.base.views.MultiStateView>
