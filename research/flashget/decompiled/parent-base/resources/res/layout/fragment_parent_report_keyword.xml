<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_keyword_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_keyword_content"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_keyword_report_title"
            android:tag="binding_1"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/NoticePage_SocialAppKeywordDetection"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/icon_report_keyword_detection"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/msv_keyword_report_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:emptyResId="@layout/fragment_parent_report_keyword_low_version"
            app:errorResId="@layout/fragment_parent_report_keyword_not_free"
            app:layout_constraintTop_toBottomOf="@+id/tv_keyword_report_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_keyword_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/UsageReport_KeywordDetection_CountTitle"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_keyword_title1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/UsageReport_KeywordDetection_CountTitle"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_keyword_title"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_keyword_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="比昨天少用了"
                    app:layout_constraintStart_toStartOf="@+id/tv_keyword_title1"
                    app:layout_constraintTop_toBottomOf="@+id/tv_keyword_title1"/>
                <com.flashget.kid.common.ui.base.views.MultiStateView
                    android:id="@+id/msv_keyword_report_adapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:emptyResId="@layout/fragment_parent_report_keyword_adapter_empty"
                    app:errorResId="@layout/fragment_parent_report_keyword_adapter_error"
                    app:layout_constraintTop_toBottomOf="@+id/tv_keyword_tips">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_keyword_report_detail"
                            android:tag="binding_2"
                            android:paddingTop="@dimen/dp_16"
                            android:paddingBottom="@dimen/dp_16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/common_see_details"
                            android:drawableEnd="@drawable/icon_list_more_arrow"
                            android:paddingEnd="@dimen/dp_16"
                            android:layout_marginStart="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/rv_keyword_report_detail"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cly_header"
                            android:background="@drawable/corners_rectangle_f4f3f7_20"
                            android:padding="@dimen/dp_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_16"
                            android:layout_marginTop="@dimen/dp_16"
                            android:layout_marginRight="@dimen/dp_16"
                            android:layout_marginHorizontal="@dimen/dp_16"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/sp_14"
                                android:textStyle="bold"
                                android:textColor="@color/tab_selected_text_color"
                                android:gravity="center"
                                android:id="@+id/tv_keyword"
                                android:tag="binding_3"
                                android:background="@drawable/tab_selected_bg"
                                android:paddingTop="@dimen/dp_6"
                                android:paddingBottom="@dimen/dp_6"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/Common_Keywords"
                                android:paddingVertical="@dimen/dp_6"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/guide_line"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="@dimen/sp_14"
                                android:textStyle="bold"
                                android:textColor="@color/tab_unselected_text_color"
                                android:gravity="center"
                                android:id="@+id/tv_keyword_app"
                                android:tag="binding_4"
                                android:paddingTop="@dimen/dp_6"
                                android:paddingBottom="@dimen/dp_6"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/Common_iOSMDM_Apps"
                                android:paddingVertical="@dimen/dp_6"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/guide_line"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.constraintlayout.widget.Guideline
                                android:orientation="vertical"
                                android:id="@+id/guide_line"
                                android:layout_width="@dimen/dp_1"
                                android:layout_height="match_parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintGuide_percent="0.5"
                                app:layout_constraintStart_toStartOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_keyword_report_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintTop_toBottomOf="@+id/cly_header"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.flashget.kid.common.ui.base.views.MultiStateView>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_keyword_tips"
                    android:background="@drawable/corners_rectangle_7993ff_9e81ff_12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/msv_keyword_report_adapter">
                    <ImageView
                        android:id="@+id/img_keyword_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:src="@drawable/ic_tips_purple"
                        android:layout_marginStart="@dimen/dp_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_keyword_total_tips"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_keyword_total_tips"
                        android:tag="binding_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:layout_marginBottom="@dimen/dp_10"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:layout_marginVertical="@dimen/dp_10"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/img_keyword_tips"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
