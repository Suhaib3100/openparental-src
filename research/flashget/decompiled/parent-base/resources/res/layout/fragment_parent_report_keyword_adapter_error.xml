<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_keyword_adapter_error_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColorHint="@color/color_text_secondary"
        android:gravity="center"
        android:id="@+id/tv_empty_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_33"
        android:layout_marginRight="@dimen/dp_40"
        android:text="@string/UsageReport_KeywordDetection_EmptyData_Des"
        android:drawableTop="@drawable/pic_blankpage_keyword_management"
        android:drawablePadding="@dimen/dp_16"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/dp_40"/>
    <TextView
        android:id="@+id/btn_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_56"
        android:text="@string/SetNow_Button"
        android:layout_below="@+id/tv_empty_title"
        android:layout_centerHorizontal="true"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        style="@style/ButtonStyle"/>
</RelativeLayout>
