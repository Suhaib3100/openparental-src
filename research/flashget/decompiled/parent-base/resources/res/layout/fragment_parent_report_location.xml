<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/fragment_parent_report_location_0"
    android:background="@drawable/corners_rectangle_white_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_location_report_title"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/UsageReport_LocationData_Title"
        android:drawablePadding="@dimen/dp_8"
        android:drawableStart="@drawable/icon_report_location"
        android:layout_marginStart="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:errorResId="@layout/fragment_parent_report_location_not_free"
        app:layout_constraintTop_toBottomOf="@+id/tv_location_report_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_location_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_leave_address"
                android:paddingTop="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/UsageReport_LocationData_StayPoint"
                android:drawablePadding="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_16"
                app:drawableStartCompat="@drawable/icon_report_position"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/line"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_address_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5次"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_leave_address"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_leave_address"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_primary"
                android:gravity="center"
                android:id="@+id/tv_location_more"
                android:tag="binding_1"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Common_SeeMore"
                app:layout_constraintTop_toBottomOf="@+id/recycler_view"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_keyword_tips"
                android:background="@drawable/corners_rectangle_7993ff_9e81ff_12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_location_more">
                <ImageView
                    android:id="@+id/img_location_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:src="@drawable/ic_tips_purple"
                    android:layout_marginStart="@dimen/dp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_location_tips"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_location_tips"
                    android:tag="binding_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:layout_marginVertical="@dimen/dp_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/img_location_tips"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/line"
                android:background="@color/color_border_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/multi_state_view"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/tv_leave_address"/>
            <com.flashget.kid.common.ui.base.views.MultiStateView
                android:id="@+id/multi_state_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:emptyResId="@layout/fragment_parent_report_location_empty"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_geofence"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_16">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_set_geofence_title"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="@string/Parent_Geofence_title"
                        android:drawablePadding="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_16"
                        app:drawableStartCompat="@drawable/icon_report_fence"
                        app:layout_constraintEnd_toStartOf="@+id/tv_set_geofence"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_primary"
                        android:id="@+id/tv_set_geofence"
                        android:tag="binding_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_Add"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_set_geofence_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_set_geofence_title"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_leave_times_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="@string/UsageReport_LocationData_GeofenceCountTitle"
                        android:drawablePadding="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_16"
                        app:drawableStartCompat="@drawable/icon_report_leave_fence"
                        app:layout_constraintEnd_toStartOf="@+id/tv_leave_times"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_set_geofence_title"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_leave_times"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5次"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_leave_times_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_leave_times_title"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_leave_time_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="@string/UsageReport_LocationData_GeofenceTimeTitle"
                        android:drawablePadding="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_16"
                        app:drawableStartCompat="@drawable/icon_report_fence_time"
                        app:layout_constraintEnd_toStartOf="@+id/tv_leave_time"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_leave_times_title"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_leave_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5分钟"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_leave_time_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_leave_time_title"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/group_has_geofence"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:constraint_referenced_ids="tv_leave_time_title,tv_leave_time"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/group_geofence_times"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:constraint_referenced_ids="tv_leave_times_title,tv_leave_times"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/group_set_geofence"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:constraint_referenced_ids="tv_set_geofence_title,tv_set_geofence"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.flashget.kid.common.ui.base.views.MultiStateView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
