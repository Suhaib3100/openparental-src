<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_new_install_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_notification_content"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_new_install_report_title"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/NewlyInstalledApps_Title"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/icon_report_install_app"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/msv_new_install_report_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:emptyResId="@layout/fragment_parent_report_new_install_empty"
            app:layout_constraintTop_toBottomOf="@+id/tv_new_install_report_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_primary"
                    android:gravity="center"
                    android:id="@+id/tv_new_install_report_all"
                    android:tag="binding_1"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_SeeMore"
                    android:paddingVertical="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rv_new_install_report_detail"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_new_install_report_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
