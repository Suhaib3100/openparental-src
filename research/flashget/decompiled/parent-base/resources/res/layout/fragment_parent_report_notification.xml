<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_notification_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_notification_content"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_notification_report_title"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/PricingPage_Kids_Feature5"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/icon_report_notice"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/msv_notification_report_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:emptyResId="@layout/fragment_parent_report_notification_empty"
            app:errorResId="@layout/fragment_parent_report_app_adapter_empty"
            app:layout_constraintTop_toBottomOf="@+id/tv_notification_report_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_primary"
                    android:gravity="center"
                    android:id="@+id/tv_notification_report_all"
                    android:tag="binding_1"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_SeeMore"
                    android:paddingVertical="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rv_notification_report_detail"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_notification_tips"
                    android:background="@drawable/corners_rectangle_7993ff_9e81ff_12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_notification_report_see_detail">
                    <ImageView
                        android:id="@+id/img_notification_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:src="@drawable/ic_tips_purple"
                        android:layout_marginStart="@dimen/dp_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_notification_tips"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_notification_tips"
                        android:tag="binding_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:layout_marginBottom="@dimen/dp_10"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:layout_marginVertical="@dimen/dp_10"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/img_notification_tips"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_notification_report_see_detail"
                    android:tag="binding_3"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/common_see_details"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    android:paddingEnd="@dimen/dp_16"
                    android:layout_marginStart="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_line"/>
                <View
                    android:id="@+id/view_line"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_notification_report_all"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_notification_report_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
