<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_screen_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_screen_content"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_screen_report_title"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/Parent_TodayEvent_Usage_Time_Title"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/icon_report_screen_time"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_screen_report_title_limit"
            android:tag="binding_1"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Parent_UsageLimit_ScreenTime_Title"
            android:drawableEnd="@drawable/icon_list_more_arrow"
            android:paddingEnd="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_screen_use_tips"
            android:background="@drawable/corners_rectangle_7993ff_9e81ff_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_screen_report_title_limit">
            <ImageView
                android:id="@+id/img_screen_use_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_3"
                android:src="@drawable/ic_tips_purple"
                android:layout_marginStart="@dimen/dp_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_screen_use_tips"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_screen_use_tips"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginBottom="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_12"
                android:layout_marginVertical="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/img_screen_use_tips"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/view_line"
            android:background="@color/color_border_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/multi_state_view"/>
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/multi_state_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorResId="@layout/fragment_parent_report_screen_low_version"
            app:layout_constraintTop_toBottomOf="@+id/tv_screen_report_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColorHint="@color/color_text_secondary"
                    android:id="@+id/tv_screen_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="4月17日 今天"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_22"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_screen_used_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="5小时30分钟"
                    app:layout_constraintStart_toStartOf="@+id/tv_screen_date"
                    app:layout_constraintTop_toBottomOf="@+id/tv_screen_date"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColorHint="@color/color_text_secondary"
                    android:id="@+id/tv_screen_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="比昨天少用了"
                    app:layout_constraintStart_toStartOf="@+id/tv_screen_date"
                    app:layout_constraintTop_toBottomOf="@+id/tv_screen_used_time"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_primary"
                    android:gravity="center"
                    android:id="@+id/tv_screen_report_all"
                    android:tag="binding_3"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_SeeMore"
                    android:paddingVertical="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rv_screen_report_detail"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_screen_report_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bar_chart"
                    app:layout_goneMarginTop="@dimen/dp_12"/>
                <com.flashget.parentalcontrol.widget.chart.BarChart2
                    android:id="@+id/bar_chart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_145"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_screen_tips"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
