<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_smslog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_calllog_content"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_smslog_report_title"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/UsageReport_SMSAnalysis_Title"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@drawable/icon_report_msg_analysis"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/msv_smslog_report_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorResId="@layout/fragment_parent_report_smslog_not_free"
            app:layout_constraintTop_toBottomOf="@+id/tv_smslog_report_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <HorizontalScrollView
                    android:id="@+id/scrollView"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cly_sms_send"
                            android:tag="binding_1"
                            android:background="@drawable/corner_rectangle_147e5ded_8_7e5ded"
                            android:paddingLeft="@dimen/dp_10"
                            android:paddingTop="@dimen/dp_8"
                            android:paddingRight="@dimen/dp_10"
                            android:paddingBottom="@dimen/dp_8"
                            android:layout_width="@dimen/dp_132"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginStart="@dimen/dp_16"
                            android:layout_marginEnd="@dimen/dp_6"
                            android:paddingHorizontal="@dimen/dp_10"
                            android:paddingVertical="@dimen/dp_8"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/color_text_primary"
                                android:ellipsize="end"
                                android:id="@+id/tv_send_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/Common_Send"
                                android:singleLine="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="@dimen/sp_20"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_primary"
                                android:id="@+id/tv_send_num"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4"
                                android:text="483"
                                app:layout_constraintStart_toStartOf="@+id/tv_send_title"
                                app:layout_constraintTop_toBottomOf="@+id/tv_send_title"/>
                            <TextView
                                android:textSize="@dimen/sp_13"
                                android:textColor="@color/color_text_secondary"
                                android:gravity="start"
                                android:id="@+id/tv_send_compare"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:text="比昨天"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@+id/tv_send_title"
                                app:layout_constraintTop_toBottomOf="@+id/tv_send_num"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cly_sms_receive"
                            android:tag="binding_2"
                            android:background="@drawable/corners_rectangle_e9e8ec_8_w1"
                            android:paddingLeft="@dimen/dp_10"
                            android:paddingTop="@dimen/dp_8"
                            android:paddingRight="@dimen/dp_10"
                            android:paddingBottom="@dimen/dp_8"
                            android:layout_width="@dimen/dp_132"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginStart="@dimen/dp_12"
                            android:paddingHorizontal="@dimen/dp_10"
                            android:paddingVertical="@dimen/dp_8"
                            app:layout_constraintStart_toEndOf="@+id/cly_sms_send"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/color_text_primary"
                                android:ellipsize="end"
                                android:id="@+id/tv_receive_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/Common_Receive"
                                android:singleLine="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="@dimen/sp_20"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_primary"
                                android:id="@+id/tv_receive_num"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4"
                                android:text="483"
                                app:layout_constraintStart_toStartOf="@+id/tv_receive_title"
                                app:layout_constraintTop_toBottomOf="@+id/tv_receive_title"/>
                            <TextView
                                android:textSize="@dimen/sp_13"
                                android:textColor="@color/color_text_secondary"
                                android:gravity="start"
                                android:id="@+id/tv_receive_compare"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:text="比昨天"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@+id/tv_receive_title"
                                app:layout_constraintTop_toBottomOf="@+id/tv_receive_num"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cly_sms_keyword"
                            android:tag="binding_3"
                            android:background="@drawable/corners_rectangle_e9e8ec_8_w1"
                            android:paddingLeft="@dimen/dp_10"
                            android:paddingTop="@dimen/dp_8"
                            android:paddingRight="@dimen/dp_10"
                            android:paddingBottom="@dimen/dp_8"
                            android:layout_width="@dimen/dp_132"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginStart="@dimen/dp_12"
                            android:layout_marginEnd="@dimen/dp_16"
                            android:paddingHorizontal="@dimen/dp_10"
                            android:paddingVertical="@dimen/dp_8"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/cly_sms_receive"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/color_text_primary"
                                android:ellipsize="end"
                                android:id="@+id/tv_keyword_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/Parent_KeywordDetection_Title"
                                android:singleLine="true"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="@dimen/sp_20"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_primary"
                                android:id="@+id/tv_keyword_num"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4"
                                android:text="483"
                                app:layout_constraintStart_toStartOf="@+id/tv_keyword_title"
                                app:layout_constraintTop_toBottomOf="@+id/tv_keyword_title"/>
                            <TextView
                                android:textSize="@dimen/sp_13"
                                android:textColor="@color/color_text_secondary"
                                android:gravity="start"
                                android:id="@+id/tv_keyword_compare"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:text="比昨天"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@+id/tv_keyword_title"
                                app:layout_constraintTop_toBottomOf="@+id/tv_keyword_num"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </HorizontalScrollView>
                <com.flashget.kid.common.ui.base.views.MultiStateView
                    android:id="@+id/msv_sms_content_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorResId="@layout/fragment_parent_report_smslog_empty"
                    app:layout_constraintTop_toBottomOf="@+id/scrollView">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_sms_report_all"
                            android:tag="binding_4"
                            android:paddingTop="@dimen/dp_16"
                            android:paddingBottom="@dimen/dp_16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/common_see_details"
                            android:drawableEnd="@drawable/icon_list_more_arrow"
                            android:paddingEnd="@dimen/dp_16"
                            android:layout_marginStart="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
                        <View
                            android:id="@+id/view_line"
                            android:background="@color/color_border_2"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_1"
                            android:layout_marginLeft="@dimen/dp_16"
                            android:layout_marginTop="@dimen/dp_24"
                            android:layout_marginRight="@dimen/dp_16"
                            android:layout_marginHorizontal="@dimen/dp_16"
                            app:layout_constraintTop_toBottomOf="@+id/cly_sms_content_detail"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cly_sms_content_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent">
                            <androidx.constraintlayout.widget.Guideline
                                android:orientation="vertical"
                                android:id="@+id/guide_line"
                                android:layout_width="@dimen/dp_1"
                                android:layout_height="match_parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintGuide_percent="0.5"
                                app:layout_constraintStart_toStartOf="parent"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_sms_count"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_12"
                                android:layout_marginEnd="@dimen/dp_16"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                app:layout_constraintBottom_toBottomOf="@+id/pie_chart"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/pie_chart"
                                app:layout_constraintTop_toTopOf="@+id/pie_chart"/>
                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pie_chart"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp_144"
                                android:layout_marginTop="@dimen/dp_27"
                                android:layout_marginEnd="@dimen/dp_6"
                                app:layout_constraintEnd_toEndOf="@+id/guide_line"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_sms_keyword"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dp_16"
                                android:layout_marginTop="@dimen/dp_20"
                                android:layout_marginRight="@dimen/dp_16"
                                android:layout_marginHorizontal="@dimen/dp_16"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.flashget.kid.common.ui.base.views.MultiStateView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
