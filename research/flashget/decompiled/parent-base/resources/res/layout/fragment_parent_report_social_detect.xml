<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_report_social_detect_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_app_content"
        android:background="@drawable/corners_rectangle_white_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_app_report_title"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/SocialAppDetection_YouTubeAndTitTokHistory"
            android:drawablePadding="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:drawableStartCompat="@drawable/icon_report_play_record"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/msv_social_detect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:emptyResId="@layout/fragment_parent_report_social_detect_low_version"
            app:errorResId="@layout/fragment_parent_report_keyword_not_free"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_report_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/viewTiktok"
                    android:tag="binding_1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_tiktok_count"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_tiktok"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_tiktok"
                    android:paddingTop="@dimen/dp_2"
                    android:paddingBottom="@dimen/dp_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:text="TikTok"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@drawable/app_logo_tiktok"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guide_line"
                    android:layout_width="@dimen/dp_12"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_percent="0.5"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="start"
                    android:id="@+id/tv_tiktok_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/Feature_Title_Videos"
                    app:layout_constraintEnd_toStartOf="@+id/guide_line"
                    app:layout_constraintStart_toStartOf="@+id/tv_tiktok"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tiktok"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:gravity="start"
                    android:id="@+id/tv_tiktok_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    app:layout_constraintEnd_toEndOf="@+id/tv_tiktok_title"
                    app:layout_constraintStart_toStartOf="@+id/tv_tiktok_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tiktok_title"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="start"
                    android:id="@+id/tv_tiktok_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_UsageTime"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guide_line"
                    app:layout_constraintTop_toTopOf="@+id/tv_tiktok_title"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:gravity="start"
                    android:id="@+id/tv_tiktok_used_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    app:layout_constraintEnd_toEndOf="@+id/tv_tiktok_time"
                    app:layout_constraintStart_toStartOf="@+id/tv_tiktok_time"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tiktok_time"/>
                <View
                    android:id="@+id/divider"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tiktok_used_time"/>
                <View
                    android:id="@+id/viewYoutube"
                    android:tag="binding_2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_youtube_count"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_youtube"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_youtube"
                    android:paddingTop="@dimen/dp_2"
                    android:paddingBottom="@dimen/dp_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:text="YouTube"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@drawable/app_logo_youtube"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="start"
                    android:id="@+id/tv_youtube_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:text="@string/Feature_Title_Videos"
                    app:layout_constraintEnd_toStartOf="@+id/guide_line"
                    app:layout_constraintStart_toStartOf="@+id/tv_youtube"
                    app:layout_constraintTop_toBottomOf="@+id/tv_youtube"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/color_text_primary"
                    android:gravity="start"
                    android:id="@+id/tv_youtube_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    app:layout_constraintEnd_toEndOf="@+id/tv_youtube_title"
                    app:layout_constraintStart_toStartOf="@+id/tv_youtube_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_youtube_title"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="start"
                    android:id="@+id/tv_youtube_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_UsageTime"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guide_line"
                    app:layout_constraintTop_toTopOf="@+id/tv_youtube_title"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:gravity="start"
                    android:id="@+id/tv_youtube_used_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    app:layout_constraintEnd_toEndOf="@+id/tv_youtube_time"
                    app:layout_constraintStart_toStartOf="@+id/tv_youtube_time"
                    app:layout_constraintTop_toBottomOf="@+id/tv_youtube_time"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
