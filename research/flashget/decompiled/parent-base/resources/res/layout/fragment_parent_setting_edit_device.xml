<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_parent_setting_edit_device_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_nick_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Bind_Step3_TipText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_age_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_28"
            android:text="@string/Parent_Bind_Step3_Age"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ed_nick"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:gravity="center_vertical"
            android:id="@+id/tv_age"
            android:tag="binding_1"
            android:background="@drawable/corners_rectangle_e9e8ec_12_w1"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dp_12"
            android:text="6"
            android:drawableEnd="@drawable/icon_list_arrow_down"
            android:paddingStart="12dp"
            android:paddingEnd="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/tv_age_title"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_male_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_28"
            android:text="@string/Parent_Bind_Step3_Gender"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_age"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_male"
            android:tag="binding_2"
            android:background="@drawable/sex_selector"
            android:paddingLeft="@dimen/dp_16"
            android:paddingTop="@dimen/dp_8"
            android:paddingRight="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/Common_Boy"
            android:drawablePadding="@dimen/dp_6"
            android:drawableStart="@drawable/icon_sex_male"
            android:layout_marginEnd="@dimen/dp_20"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/tv_female"
            app:layout_constraintStart_toStartOf="@+id/tv_male_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_male_title"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_female"
            android:tag="binding_3"
            android:background="@drawable/sex_selector"
            android:paddingLeft="@dimen/dp_16"
            android:paddingTop="@dimen/dp_8"
            android:paddingRight="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Common_Girl"
            android:drawablePadding="@dimen/dp_6"
            android:drawableStart="@drawable/icon_sex_female"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/tv_male"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_male"
            app:layout_constraintTop_toTopOf="@+id/tv_male"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_ivatar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_28"
            android:text="@string/Common_Avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_male"
            style="@style/TextStyle.Start"/>
        <View
            android:id="@+id/divider_age"
            android:background="@color/c_e8e6ec"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            app:layout_constraintTop_toBottomOf="@+id/tv_age"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_20"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_ivatar_title"
            app:spanCount="4"/>
        <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_tertiary"
            android:id="@+id/ed_nick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text=""
            android:hint="@string/Common_EditNickname_InputPrompt"
            android:singleLine="true"
            app:layout_constraintTop_toBottomOf="@+id/tv_nick_title"
            app:maxChars="30"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
