<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_snapshot_notice_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.parentalcontrol.ui.component.SwitchDayPreference
        android:id="@+id/snapshot_switch_day"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:tag="binding_1"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:emptyResId="@layout/common_notification_empty"
        app:errorResId="@layout/common_notification_error">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.jcodecraeer.xrecyclerview.XRecyclerViewMulItem
                android:id="@+id/xrvList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/view"
                android:layout_width="0dp"
                android:layout_height="0.1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top"/>
            <include
                android:id="@+id/top"
                android:background="@color/color_bg_1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/dp_0"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/item_trial_snapshot_header"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</LinearLayout>
