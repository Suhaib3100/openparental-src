<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/free_image_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:src="@drawable/icon_list_camera_snapshot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_free_text"
        android:paddingLeft="@dimen/dp_3"
        android:paddingRight="@dimen/dp_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/ScreenSnapshot_Page_Title"
        android:textDirection="locale"
        android:paddingHorizontal="@dimen/dp_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="@dimen/sp_9"
        android:textColor="@color/color_primary"
        android:id="@+id/tv_free"
        android:background="@drawable/corners_rectangle_ffe491_ffca2a_8"
        android:paddingLeft="@dimen/dp_4"
        android:paddingTop="@dimen/dp_1"
        android:paddingRight="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="PRO"
        android:layout_marginStart="@dimen/dp_20"
        android:paddingHorizontal="@dimen/dp_4"
        android:paddingVertical="@dimen/dp_1"
        app:layout_constraintStart_toStartOf="@+id/img"
        app:layout_constraintTop_toTopOf="@+id/img"/>
    <TextView
        android:textSize="@dimen/sp_9"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_trial"
        android:background="@drawable/corners_rectangle_54c2ff_f4d83ff_8"
        android:paddingLeft="@dimen/dp_4"
        android:paddingTop="@dimen/dp_1"
        android:paddingRight="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="Trial"
        android:layout_marginStart="@dimen/dp_20"
        android:paddingHorizontal="@dimen/dp_4"
        android:paddingVertical="@dimen/dp_1"
        app:layout_constraintStart_toStartOf="@+id/img"
        app:layout_constraintTop_toTopOf="@+id/img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
