<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/geofenceTrackBottomSheet"
        android:background="@drawable/geofence_track_bottom_sheet_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_draggable="true"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/geofence_detail_sheet_peek_height"
        app:behavior_skipCollapsed="false"
        app:layout_behavior="@string/bottom_sheet_behavior"
        app:paddingBottomSystemWindowInsets="false">
        <ImageView
            android:id="@+id/ivPullUp"
            android:visibility="visible"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/map_pista_ic_desplegar"
            android:scaleType="center"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvGeofenceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivPullUp"
            style="@style/TextStyle.Center"/>
        <View
            android:id="@+id/divider3"
            android:background="@color/color_border_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@+id/tvGeofenceName"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clGeofenceEmpty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider3">
            <ImageView
                android:id="@+id/ivGeofenceEmpty"
                android:layout_width="140dp"
                android:layout_height="80dp"
                android:layout_marginTop="54dp"
                android:src="@drawable/pic_blankpage_map_nodata"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:gravity="center"
                android:id="@+id/tvErrorMsg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/Parent_Position_No_Track_Record"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivGeofenceEmpty"
                style="@style/TextStyle.Center"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTrackGeofence"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_20"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
