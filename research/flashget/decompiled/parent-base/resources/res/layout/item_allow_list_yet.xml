<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cly_item_content"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_55">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAllowListItem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:textSize="12sp"
            android:layout_gravity="center"
            android:id="@+id/ivMinus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_minus"
            android:text="@string/Parent_Setting_Records_Delete"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/defaultColor"
            android:id="@+id/tvAllowApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivAllowAppIcon"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivAllowAppIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/parent_ic_launcher"
            android:layout_marginStart="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivMinus"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@color/ad_base_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/ivMinus"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_text_white"
        android:gravity="center"
        android:id="@+id/tvDelete"
        android:background="@color/kid_guide_err_txt"
        android:layout_width="@dimen/dp_82"
        android:layout_height="match_parent"
        android:text="@string/Parent_Setting_Records_Delete"
        android:textDirection="locale"
        app:layout_constraintStart_toEndOf="@+id/clAllowListItem"
        style="@style/TextStyle.Center"/>
</androidx.constraintlayout.widget.ConstraintLayout>
