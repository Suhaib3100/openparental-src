<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_rectangle_white_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/dp_16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/dp_16"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/Parent_TodayEvent_Introduction"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/item_app_detail_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glContentStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="20dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glContentEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="20dp"/>
        <com.flashget.parentalcontrol.ui.component.AppItemPreference
            android:id="@+id/aipApp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/tv_delete"
            app:layout_constraintStart_toStartOf="@+id/glContentStart"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_text_white"
            android:id="@+id/tv_delete"
            android:background="@drawable/corners_recetangle_ff6497_12"
            android:paddingLeft="@dimen/dp_10"
            android:paddingTop="@dimen/dp_3"
            android:paddingRight="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Common_Uninstalled"
            android:paddingHorizontal="@dimen/dp_10"
            android:paddingVertical="@dimen/dp_3"
            app:layout_constraintBottom_toBottomOf="@+id/aipApp"
            app:layout_constraintEnd_toEndOf="@+id/glContentEnd"
            app:layout_constraintTop_toTopOf="@+id/aipApp"/>
        <com.flashget.parentalcontrol.ui.component.ParentAppDetailTextPreference
            android:id="@+id/appType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="@+id/glContentEnd"
            app:layout_constraintStart_toStartOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/aipApp"
            app:title="@string/Parent_TodayEvent_Category"/>
        <com.flashget.parentalcontrol.ui.component.ParentAppDetailTextPreference
            android:id="@+id/ageType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="@+id/glContentEnd"
            app:layout_constraintStart_toStartOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/appType"
            app:title="@string/Parent_TodayEvent_Age_grading"/>
        <com.flashget.parentalcontrol.ui.component.ParentAppDetailTextPreference
            android:id="@+id/developer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="@+id/glContentEnd"
            app:layout_constraintStart_toStartOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/ageType"
            app:title="@string/Parent_TodayEvent_Developer"/>
        <com.flashget.parentalcontrol.ui.component.ParentAppDetailTextPreference
            android:id="@+id/installTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="@+id/glContentEnd"
            app:layout_constraintStart_toStartOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/developer"
            app:title="@string/Parent_TodayEvent_Install_Time"/>
        <View
            android:id="@+id/vDivider"
            android:background="@color/color_border_2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="@+id/glContentEnd"
            app:layout_constraintStart_toStartOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/installTime"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/blue_ff446efc"
            android:id="@+id/tvSeeAppDetail"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/common_see_details"
            app:layout_constraintEnd_toEndOf="@+id/glContentEnd"
            app:layout_constraintStart_toStartOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/vDivider"
            style="@style/TextStyle.Center"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
