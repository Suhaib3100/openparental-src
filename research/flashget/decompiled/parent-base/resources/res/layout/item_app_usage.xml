<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_rectangle_white_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/UsageReport_AppUsageTime_Title"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/sp_22"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_used_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintStart_toStartOf="@+id/tv_date"
        app:layout_constraintTop_toBottomOf="@+id/tv_date"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintStart_toStartOf="@+id/tv_date"
        app:layout_constraintTop_toBottomOf="@+id/tv_used_time"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_usage_time_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/UsageReport_AppUsageTime_Title"
        app:layout_constraintStart_toStartOf="@+id/tv_date"
        app:layout_constraintTop_toBottomOf="@+id/bar_chart"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tv_usage_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/bar_chart"
        app:layout_constraintTop_toTopOf="@+id/tv_usage_time_title"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_notification_title"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_14"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/PricingPage_Kids_Feature5"
        app:layout_constraintEnd_toStartOf="@+id/tv_notification_count"
        app:layout_constraintStart_toStartOf="@+id/tv_date"
        app:layout_constraintTop_toBottomOf="@+id/view_line"
        app:layout_goneMarginTop="14dp"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_secondary"
        android:gravity="center"
        android:id="@+id/tv_notification_count"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:drawablePadding="@dimen/dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_notification_title"
        app:layout_constraintEnd_toEndOf="@+id/bar_chart"
        app:layout_constraintTop_toTopOf="@+id/tv_notification_title"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_usage_record_title"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_21"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Common_AppUsageLogs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_usage_record_count"
        app:layout_constraintStart_toStartOf="@+id/tv_date"
        app:layout_constraintTop_toBottomOf="@+id/notification_view_line"
        app:layout_goneMarginTop="14dp"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/tv_usage_record_count"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:drawablePadding="@dimen/dp_3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_usage_record_title"
        app:layout_constraintEnd_toEndOf="@+id/bar_chart"
        app:layout_constraintTop_toTopOf="@+id/tv_usage_record_title"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/color_border_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_usage_time_title"/>
    <View
        android:id="@+id/notification_view_line"
        android:background="@color/color_border_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_notification_title"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gp_usage_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_usage_time_title,tv_usage_time,view_line"/>
    <com.flashget.parentalcontrol.widget.chart.BarChart2
        android:id="@+id/bar_chart"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_145"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
