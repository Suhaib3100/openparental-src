<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_tab_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_tab_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:lottie_autoPlay="true"
        app:lottie_imageAssetsFolder="permission_checking"
        app:lottie_loop="false"/>
    <View
        android:id="@+id/v_tab_badge"
        android:background="@drawable/oval_badge"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="-2dp"
        android:layout_marginEnd="-2dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_tab_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_tab_icon"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tv_tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/Parent_Tabbar_Device_Notice"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_tab_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_tab_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_tab_icon"
        style="@style/TextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
