<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl"
    android:tag="layout/item_browser_notice_history_0"
    android:background="@drawable/corners_rectangle_white_12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/img_icon"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/icon_list_sms_safety"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/read_dot"
        app:layout_constraintEnd_toEndOf="@+id/img_icon"
        app:layout_constraintTop_toTopOf="@+id/img_icon"
        style="@style/Dot_White_Border"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="08:02"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="Chrome"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toStartOf="@+id/tv_time"
        app:layout_constraintStart_toEndOf="@+id/img_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tv_device"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Samsung SM-G9300"
        app:layout_constraintEnd_toEndOf="@+id/tv_name"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tv_url_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_12"
        android:text="URL的Title…URL的Title…URL的Title…URL的Ti…"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/tv_device"
        app:layout_goneMarginTop="@dimen/dp_4"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="具体的"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="@+id/tv_url_title"
        app:layout_constraintStart_toStartOf="@+id/tv_url_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_url_title"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_type"
        android:background="@drawable/corners_rectagle_ff6479_11dp"
        android:paddingLeft="@dimen/dp_8"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="白名单"
        android:paddingHorizontal="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="@+id/tv_url"
        app:layout_constraintTop_toBottomOf="@+id/tv_url"
        style="@style/TextStyle.Start"/>
    <View
        android:id="@+id/divider"
        android:background="@color/color_border_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/tv_type"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_operate"
        android:paddingLeft="@dimen/dp_12"
        android:paddingTop="@dimen/dp_10"
        android:paddingRight="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <ImageView
            android:id="@+id/iv_operate"
            android:background="@drawable/icon_list_more_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/tv_operate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_operate"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tv_operate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/KeyMapping_Column_Operate"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_operate"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
