<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/parent_device_top_feature_bg"
    android:layout_width="match_parent"
    android:layout_height="134dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="12dp"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/parent_customize_time_day_monday"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toTopOf="@+id/glTop"
        style="@style/TextStyle.Start"/>
    <ToggleButton
        android:id="@+id/tgEnableLimit"
        android:background="@drawable/toggle_button"
        android:saveEnabled="false"
        android:layout_width="38dp"
        android:layout_height="24dp"
        android:checked="false"
        android:textOn=""
        android:textOff=""
        app:layout_constraintBottom_toTopOf="@+id/vDivider"
        app:layout_constraintEnd_toStartOf="@+id/glEnd"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vDivider"
        android:background="@color/color_border_2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toStartOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/tvDayName"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clStartTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintHeight_min="44dp"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/vDivider">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tvStartTimeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Parent_UsageLimit_Start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/kid_gray_tip"
            android:id="@+id/tvLimitStartHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivLimitStartArrow"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.End"/>
        <ImageView
            android:id="@+id/ivLimitStartArrow"
            android:background="@drawable/icon_list_more_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/vDivider2"
        android:background="@color/color_border_2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toStartOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/clStartTime"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clEndTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vDivider2">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tvEndTimeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Parent_UsageLimit_End"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/kid_gray_tip"
            android:id="@+id/tvLimitEndHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivLimitEndArrow"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.End"/>
        <ImageView
            android:id="@+id/ivLimitEndArrow"
            android:background="@drawable/icon_list_more_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
