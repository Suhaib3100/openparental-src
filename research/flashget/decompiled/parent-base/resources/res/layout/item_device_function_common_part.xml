<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cly_parent_common"
    android:tag="layout/item_device_function_common_part_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.flashget.parentalcontrol.widget.FreeImageViewV2
        android:id="@+id/tv_parent_title"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_weight="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_tv_parent_right_icon"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_parent_title"
        app:layout_constraintStart_toStartOf="@+id/tv_parent_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_camera_tip"
        android:tag="binding_3"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_8"
        android:src="@drawable/dot_shape_unread_red"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_parent_title"
        app:layout_constraintStart_toStartOf="@+id/tv_parent_title"
        app:layout_constraintTop_toTopOf="@+id/tv_parent_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
