<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_device_function_location_0"
    android:background="@drawable/device_fragment_item_bg"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_to_map"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_list_more_arrow"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_location_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_location_title"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_location_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/DeviceTab_Title_LiveLocation"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle"/>
    <TextView
        android:textColor="@color/color_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/tv_geofence_info_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/Parent_Geofence_title"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/icon_index_geofence"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivMapGrid"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/device_fragment_device_text_drak"
        android:gravity="center_vertical"
        android:id="@+id/tv_geofence_info_status"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        android:layout_marginStart="8dp"
        app:drawableStartCompat="@drawable/light_status_online"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_geofence_info_title"
        app:layout_constraintStart_toEndOf="@+id/tv_geofence_info_title"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_9"
        android:textColor="@color/color_primary"
        android:id="@+id/tv_geofence_free"
        android:tag="binding_2"
        android:background="@drawable/corners_rectangle_ffe491_ffca2a_8"
        android:paddingLeft="@dimen/dp_4"
        android:paddingTop="@dimen/dp_1"
        android:paddingRight="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRO"
        android:layout_marginStart="@dimen/dp_4"
        android:paddingHorizontal="@dimen/dp_4"
        android:paddingVertical="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="@+id/tv_geofence_info_title"
        app:layout_constraintStart_toEndOf="@+id/tv_geofence_info_status"
        app:layout_constraintTop_toTopOf="@+id/tv_geofence_info_title"/>
    <TextView
        android:textColor="@color/color_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/tv_update_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/update_updatetitle"
        android:drawablePadding="4dp"
        app:drawableStartCompat="@drawable/icon_index_update"
        app:layout_constraintStart_toStartOf="@+id/tv_geofence_info_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_geofence_info_title"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/device_fragment_device_text_drak"
        android:id="@+id/tv_update_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_update_title"
        app:layout_constraintStart_toEndOf="@+id/tv_update_title"
        style="@style/TextStyle.Start"/>
    <ImageView
        android:id="@+id/ivMapGrid"
        android:background="@drawable/bg_map_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_map_corner"
        app:layout_constraintEnd_toEndOf="@+id/v_map_corner"
        app:layout_constraintStart_toStartOf="@+id/v_map_corner"
        app:layout_constraintTop_toTopOf="@+id/v_map_corner"/>
    <com.github.pengrad.mapscaleview.MapScaleView
        android:layout_gravity="end|bottom"
        android:id="@+id/map_scale_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_location_name"
        app:layout_constraintEnd_toEndOf="@+id/ivMapGrid"
        app:scale_expandRtl="true"
        app:scale_maxWidth="30dp"
        app:scale_miles="false"
        app:scale_outline="true"
        app:scale_textSize="8sp"/>
    <com.google.android.gms.maps.MapView
        android:name="com.google.android.gms.maps.MapFragment"
        android:id="@+id/map_live_location"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_map_corner"
        app:layout_constraintEnd_toEndOf="@+id/v_map_corner"
        app:layout_constraintStart_toStartOf="@+id/v_map_corner"
        app:layout_constraintTop_toTopOf="@+id/v_map_corner"
        app:layout_radius="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_text_white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_location_name"
        android:background="@color/black_80000000"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:text="@string/Common_Unknow"
        android:singleLine="true"
        android:paddingHorizontal="10dp"
        app:layout_bottomLeftRadius="8dp"
        app:layout_bottomRightRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivMapGrid"
        app:layout_constraintEnd_toEndOf="@+id/ivMapGrid"
        app:layout_constraintStart_toStartOf="@+id/ivMapGrid"
        style="@style/TextStyle.Start"/>
    <View
        android:id="@+id/v_map_corner"
        android:background="@drawable/home_map_view_corner"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:layoutDirection="locale"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_location_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
