<?xml version="1.0" encoding="utf-8"?>
<com.flashget.parentalcontrol.widget.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_device_function_report_0"
    android:background="@drawable/pic_report_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp_16"
    app:layout_constraintTop_toTopOf="parent"
    app:rcClipBackground="true"
    app:rcRadius="@dimen/dp_16">
    <ImageView
        android:id="@+id/img_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginBottom="@dimen/dp_6"
        android:src="@drawable/pic_report_bar_chart"
        android:layout_marginVertical="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toStartOf="@+id/img_use"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_use_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/Parent_UsageReport_Title"
            android:singleLine="true"
            android:drawablePadding="@dimen/dp_2"
            android:drawableEnd="@drawable/icon_list_more_arrow"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/cly_right"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ViewFlipper
            android:id="@+id/view_flipper"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_45"
            android:layout_marginTop="@dimen/dp_8"
            android:flipInterval="5000"
            android:autoStart="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_use_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_screen_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:id="@+id/pb_screen_time"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_8"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/report_hor_progress_drawable_two"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_screen_time"
                    android:tag="binding_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:singleLine="true"
                    app:layout_constraintTop_toBottomOf="@+id/pb_screen_time"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_app_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img_app"
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_app_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/img_app"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/tv_app_use_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    app:layout_constraintEnd_toEndOf="@+id/tv_app_name"
                    app:layout_constraintStart_toStartOf="@+id/tv_app_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_app_name"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ViewFlipper>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_right"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_use_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_use_title"
            app:layout_constraintTop_toTopOf="@+id/tv_use_title">
            <ImageView
                android:id="@+id/img_report_dot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Dot_No_Border"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_primary"
        android:gravity="center"
        android:id="@+id/tv_pro"
        android:tag="binding_2"
        android:background="@drawable/user_report_pro"
        android:paddingLeft="@dimen/dp_10"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRO"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
</com.flashget.parentalcontrol.widget.RoundConstraintLayout>
