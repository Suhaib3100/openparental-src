<?xml version="1.0" encoding="utf-8"?>
<com.flashget.parentalcontrol.ui.component.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="end"
        android:id="@+id/lly_delete"
        android:background="@color/color_bg_2"
        android:layout_width="@dimen/dp_72"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_text_white"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:background="@color/pic_ff6479"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/Parent_Setting_Records_Delete"
            android:layout_weight="1"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cclayout"
        android:background="@color/color_bg_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_android_k"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:ellipsize="end"
                android:id="@+id/tvLimitName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/parent_enable_limit_already_add_item_title"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toStartOf="@+id/toggle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_text_tertiary"
                android:ellipsize="end"
                android:id="@+id/tvLimitTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/dp_12"
                android:text="@string/parent_enable_limit_already_add_item_hint"
                android:maxLines="1"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/toggle"
                app:layout_constraintStart_toStartOf="@+id/tvLimitName"
                app:layout_constraintTop_toBottomOf="@+id/tvLimitName"
                style="@style/TextStyle.Start"/>
            <ToggleButton
                android:id="@+id/toggle"
                android:background="@drawable/toggle_button"
                android:saveEnabled="false"
                android:layout_width="38dp"
                android:layout_height="24dp"
                android:checked="false"
                android:textOn=""
                android:textOff=""
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/layout_ios_k"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            layout="@layout/item_ios_time_limit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.parentalcontrol.ui.component.SwipeLayout>
