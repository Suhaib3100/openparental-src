<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingTop="@dimen/dp_9"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">
    <ImageView
        android:id="@+id/ivGeofenceItemIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_list_add_geofence"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tvGeofenceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toTopOf="@+id/tvGeofenceAddress"
        app:layout_constraintEnd_toStartOf="@+id/ivGeofenceListItemArrow"
        app:layout_constraintStart_toEndOf="@+id/ivGeofenceItemIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/tvGeofenceAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginBottom="@dimen/dp_9"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/vGeofenceDivider"
        app:layout_constraintEnd_toEndOf="@+id/tvGeofenceName"
        app:layout_constraintStart_toStartOf="@+id/tvGeofenceName"
        app:layout_constraintTop_toBottomOf="@+id/tvGeofenceName"
        style="@style/TextStyle.Start"/>
    <ImageView
        android:id="@+id/ivGeofenceListItemArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_list_more_arrow"/>
    <View
        android:id="@+id/vGeofenceDivider"
        android:background="@color/color_border_2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
