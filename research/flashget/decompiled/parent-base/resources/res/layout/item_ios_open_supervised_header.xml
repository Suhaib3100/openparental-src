<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_ios_open_supervised_header_0"
    android:background="@drawable/bg_ios_open_supervised_feature_header"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_44"
    android:paddingVertical="@dimen/dp_12">
    <TextView
        android:textSize="@dimen/sp_13"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Common_Features"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guide_common"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_common"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_common_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Common_StandardMode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guide_full"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/guide_common"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_full"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        app:layout_constraintGuide_percent="0.75"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_full_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Common_FullMode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guide_full"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
