<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    app:cardBackgroundColor="@color/color_white"
    app:cardCornerRadius="@dimen/dp_20"
    app:cardElevation="0dp">
    <com.flashget.parentalcontrol.ui.component.SwipeLayout
        android:id="@+id/swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_text_white"
                android:gravity="center"
                android:id="@+id/tv_delete"
                android:background="@drawable/corners_rectangle_red"
                android:paddingLeft="@dimen/dp_12"
                android:paddingRight="@dimen/dp_12"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minWidth="@dimen/dp_72"
                android:text="@string/Parent_Setting_Records_Delete"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/dp_12"
                style="@style/TextStyle.Center"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_content"
            android:background="@drawable/usage_limit_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_category_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/parent_enable_limit_already_add_item_title"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintEnd_toStartOf="@+id/toggle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_text_tertiary"
                android:ellipsize="end"
                android:id="@+id/tv_category_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginBottom="@dimen/dp_14"
                android:text="@string/parent_enable_limit_already_add_item_hint"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tv_category_name"
                app:layout_constraintStart_toStartOf="@+id/tv_category_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_category_name"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/toggle"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/toggle_button"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/view_divider"
                android:background="@color/color_border_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.parentalcontrol.ui.component.SwipeLayout>
</androidx.cardview.widget.CardView>
