<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_parent_setting_add_avatar_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_head"
        android:background="@drawable/dot_33b596f7"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_56"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_4"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_take_photo"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:src="@drawable/icon_take_photo"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/img_head"
        app:layout_constraintEnd_toEndOf="@+id/img_head"
        app:layout_constraintStart_toStartOf="@+id/img_head"
        app:layout_constraintTop_toTopOf="@+id/img_head"/>
    <ImageView
        android:id="@+id/img_photo_tips_bg"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:scaleType="matrix"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="@+id/img_head"
        app:layout_constraintEnd_toEndOf="@+id/img_head"
        app:layout_constraintStart_toStartOf="@+id/img_head"
        app:srcCompat="@drawable/camera_setting_56_bg"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/img_photo_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_head"
        app:layout_constraintEnd_toEndOf="@+id/img_head"
        app:layout_constraintStart_toStartOf="@+id/img_head"
        app:srcCompat="@drawable/setting_ic_setavatar"/>
    <View
        android:id="@+id/img_selected"
        android:background="@drawable/dot_transtant_7e5ded_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_head"
        app:layout_constraintEnd_toEndOf="@+id/img_head"
        app:layout_constraintStart_toStartOf="@+id/img_head"
        app:layout_constraintTop_toTopOf="@+id/img_head"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_take_photo"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="img_photo_tips_bg,img_photo_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
