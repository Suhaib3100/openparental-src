<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_rectangle_white_16dp"
    android:paddingLeft="@dimen/dp_12"
    android:paddingTop="@dimen/dp_16"
    android:paddingRight="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    android:layout_alignParentTop="@dimen/dp_16"
    android:paddingHorizontal="@dimen/dp_12">
    <ImageView
        android:id="@+id/ivImg"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintBottom_toTopOf="@+id/tvDeviceName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivImg"
        app:layout_constraintTop_toTopOf="@+id/ivImg"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tvDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/ivImg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivImg"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/TextStyle.Start"/>
    <View
        android:id="@+id/viewLine"
        android:background="@color/color_border_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/ivImg"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/viewLine">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tvStatusLeft"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_10"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tvStatusRight"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tvDetail"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ScreenShot_Button_View"
            android:includeFontPadding="false"
            android:drawablePadding="@dimen/dp_2"
            android:drawableEnd="@drawable/icon_list_more_arrow"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_text_white"
            android:id="@+id/tvAnalysis"
            android:background="@drawable/corners_rectangle_7e5ded_16"
            android:paddingLeft="@dimen/dp_15"
            android:paddingTop="@dimen/dp_6"
            android:paddingRight="@dimen/dp_15"
            android:paddingBottom="@dimen/dp_6"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Analyze_Button"
            android:paddingHorizontal="@dimen/dp_15"
            android:paddingVertical="@dimen/dp_6"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
