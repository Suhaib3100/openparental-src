<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.flashget.parentalcontrol.widget.CircleImageView
        android:id="@+id/img_dot"
        android:layout_width="@dimen/dp_6"
        android:layout_height="@dimen/dp_6"
        android:layout_marginStart="@dimen/dp_16"
        app:civ_circle_background_color="@color/color_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/pb_screen_time"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_4"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/report_hor_progress_drawable_three"
        android:rotation="180"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_screen_time"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColorHint="@color/color_text_secondary"
        android:id="@+id/tv_screen_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="1小时3分钟"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tv_screen_app"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="社交"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_10"
        android:layout_marginVertical="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pb_screen_time"
        app:layout_constraintStart_toEndOf="@+id/img_dot"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
</androidx.constraintlayout.widget.ConstraintLayout>
