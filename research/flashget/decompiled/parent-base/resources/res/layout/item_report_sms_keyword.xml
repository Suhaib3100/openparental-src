<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp_3"
    android:paddingBottom="@dimen/dp_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp_3">
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColorHint="@color/color_text_secondary"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/tv_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_contact"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_contact"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tv_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="131315313"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintStart_toEndOf="@+id/img_avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_4"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/report_hor_progress_drawable_three"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_contact"
        app:layout_constraintTop_toBottomOf="@+id/tv_contact"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.flashget.parentalcontrol.widget.CircleImageView
        android:id="@+id/img_avatar"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginBottom="@dimen/dp_2"
        android:layout_marginVertical="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
