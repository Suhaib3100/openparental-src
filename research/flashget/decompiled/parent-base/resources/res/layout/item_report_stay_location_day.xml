<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_rectangle_white_16dp"
    android:paddingLeft="@dimen/dp_16"
    android:paddingTop="@dimen/dp_14"
    android:paddingRight="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_6"
    android:layout_marginRight="@dimen/dp_16"
    android:layout_marginBottom="@dimen/dp_7"
    android:layout_marginHorizontal="@dimen/dp_16"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_14">
    <ImageView
        android:id="@+id/img_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:src="@drawable/icon_report_position"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="社交日均：2小时23"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_dot"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColorHint="@color/color_text_secondary"
        android:id="@+id/tv_stay_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="日均：2小时23分钟"
        app:layout_constraintStart_toStartOf="@+id/tv_address"
        app:layout_constraintTop_toBottomOf="@+id/tv_address"/>
</androidx.constraintlayout.widget.ConstraintLayout>
