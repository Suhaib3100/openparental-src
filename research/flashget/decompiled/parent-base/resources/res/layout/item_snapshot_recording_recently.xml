<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl"
    android:tag="layout/item_snapshot_recording_recently_0"
    android:background="@drawable/corners_rectangle_e9e8ec_fff_16_w1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12">
    <ImageView
        android:id="@+id/ivSelect"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/check_box_selector"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/ivStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivStatus"/>
    <ImageView
        android:id="@+id/ivStatus"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_16"
        android:src="@drawable/icon_recording_file"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintStart_toEndOf="@+id/ivSelect"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imgDot"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/ivStatus"
        app:layout_constraintTop_toTopOf="@+id/ivStatus"
        style="@style/Dot_White_Border"/>
    <ProgressBar
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateDrawable="@drawable/ad_pb_loading_drawable"
        app:layout_constraintBottom_toBottomOf="@+id/ivStatus"
        app:layout_constraintEnd_toEndOf="@+id/ivStatus"
        app:layout_constraintStart_toStartOf="@+id/ivStatus"
        app:layout_constraintTop_toTopOf="@+id/ivStatus"/>
    <ImageView
        android:id="@+id/ivDelete"
        android:visibility="gone"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_18"
        android:layout_marginBottom="-2dp"
        android:src="@drawable/icon_marker_time_delete"
        android:layout_marginEnd="-2dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivStatus"
        app:layout_constraintEnd_toEndOf="@+id/ivStatus"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toStartOf="@+id/tvTime"
        app:layout_constraintStart_toEndOf="@+id/ivStatus"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tvTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tvDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toStartOf="@+id/tvTime"
        app:layout_constraintStart_toEndOf="@+id/ivStatus"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tvContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ivStatus"
        app:layout_constraintTop_toBottomOf="@+id/tvDeviceName"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_danger"
        android:id="@+id/tvDeleteTips"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="#####这个文件将在2025/09/05 12:00被删除"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ivStatus"
        app:layout_constraintTop_toBottomOf="@+id/tvContent"
        style="@style/TextStyle.Start"/>
    <View
        android:id="@+id/bottomView"
        android:background="@color/color_border_2"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ivStatus"
        app:layout_constraintTop_toBottomOf="@+id/tvDeleteTips"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/text_enable_selector"
        android:id="@+id/btnPlay"
        android:background="@drawable/corners_rectangle_bdbac6_16_w1"
        android:paddingLeft="@dimen/dp_15"
        android:paddingTop="@dimen/dp_6"
        android:paddingRight="@dimen/dp_15"
        android:paddingBottom="@dimen/dp_6"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:minWidth="@dimen/dp_54"
        android:text="@string/Common_Play"
        android:layout_marginEnd="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_15"
        android:paddingVertical="@dimen/dp_6"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomView"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/text_enable_selector"
        android:id="@+id/btnAgainDown"
        android:background="@drawable/corners_rectangle_bdbac6_16_w1"
        android:paddingLeft="@dimen/dp_15"
        android:paddingTop="@dimen/dp_6"
        android:paddingRight="@dimen/dp_15"
        android:paddingBottom="@dimen/dp_6"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:minWidth="@dimen/dp_54"
        android:text="@string/Common_Redownload"
        android:layout_marginEnd="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_15"
        android:paddingVertical="@dimen/dp_6"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomView"
        style="@style/TextStyle.Center"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btnAgainDown,btnPlay"/>
    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier"/>
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
