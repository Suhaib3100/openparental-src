<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl"
    android:background="@drawable/parent_data_app_notification_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/img_social_detect_icon"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_noapp"
        android:scaleType="centerInside"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/social_detect_dot"
        app:layout_constraintEnd_toEndOf="@+id/img_social_detect_icon"
        app:layout_constraintTop_toTopOf="@+id/img_social_detect_icon"
        style="@style/Dot_White_Border"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_text_secondary"
        android:ellipsize="end"
        android:id="@+id/tv_social_detect_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_social_detect_time"
        app:layout_constraintStart_toEndOf="@+id/img_social_detect_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_social_detect_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="false"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_social_detect_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_social_detect_name"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tv_social_detect_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_social_detect_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.End"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_social_detect_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/img_social_detect_icon"
        android:textIsSelectable="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_social_detect_device_name"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_social_detect_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="5dp"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_below="@+id/tv_social_detect_title"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_social_detect_title"
        style="@style/TextStyle.Start"/>
    <View
        android:id="@+id/divider"
        android:background="@color/color_border_2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_social_detect_content"/>
    <ImageView
        android:id="@+id/img_next"
        android:background="@drawable/icon_list_more_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/tv_detail"
        app:layout_constraintEnd_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/tv_detail"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tv_detail"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_see_details"
        android:layout_marginEnd="2dp"
        android:paddingVertical="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img_next"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/TextStyle.Start"/>
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
