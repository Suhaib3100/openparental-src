<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_unbind_record_interval_0"
    android:background="@drawable/corners_rectangle_white_16dp"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tv_device_name"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tv_tips"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/CameraRecording_ChangeSettings_Des"
        app:layout_constraintEnd_toEndOf="@+id/tv_device_name"
        app:layout_constraintStart_toStartOf="@+id/tv_device_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_name"
        style="@style/TextStyle.Start"/>
    <View
        android:id="@+id/divider"
        android:background="@color/color_border_2"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_device_name"
        app:layout_constraintStart_toStartOf="@+id/tv_device_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_interval_setting"
        android:paddingTop="@dimen/dp_17"
        android:paddingBottom="@dimen/dp_17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_17"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_secondary"
            android:gravity="center_vertical"
            android:id="@+id/tv_start_time"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:drawablePadding="@dimen/dp_4"
            android:drawableEnd="@drawable/icon_list_more_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Common_TimeRange"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_start_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_secondary"
        android:background="@drawable/common_tips_bg"
        android:padding="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="@string/CameraRecording_ChangeSettings_Tips"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/cly_interval_setting"/>
</androidx.constraintlayout.widget.ConstraintLayout>
