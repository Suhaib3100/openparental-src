<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:background="@drawable/parent_data_app_notification_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/img_usage_record_icon"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_18"
        android:src="@drawable/ic_noapp"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_app_type"
        android:background="@drawable/icon_app_unload_subscript"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:layout_marginBottom="-3dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="-3dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_usage_record_icon"
        app:layout_constraintEnd_toEndOf="@+id/img_usage_record_icon"/>
    <ImageView
        android:id="@+id/img_next"
        android:background="@drawable/icon_list_more_arrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/tv_detail"
        app:layout_constraintEnd_toEndOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/tv_detail"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_text_secondary"
        android:ellipsize="end"
        android:id="@+id/tv_usage_record_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:maxLines="1"
        android:singleLine="false"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_usage_record_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_usage_record_name"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tv_usage_record_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_usage_record_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.End"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tv_usage_record_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintEnd_toStartOf="@+id/tv_usage_record_time"
        app:layout_constraintStart_toEndOf="@+id/img_usage_record_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tv_detail"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_see_details"
        android:layout_marginEnd="2dp"
        android:paddingVertical="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img_next"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/TextStyle.Start"/>
    <View
        android:id="@+id/usage_record_dot"
        app:layout_constraintEnd_toEndOf="@+id/img_usage_record_icon"
        app:layout_constraintTop_toTopOf="@+id/img_usage_record_icon"
        style="@style/Dot_White_Border"/>
    <View
        android:id="@+id/divider"
        android:background="@color/color_border_2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/tv_detail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_usage_record_device_name"
        app:layout_goneMarginBottom="@dimen/dp_2"/>
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
