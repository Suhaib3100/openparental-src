<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_45">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/container"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_45">
        <ImageView
            android:id="@+id/icon"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:scaleType="center"
            android:layout_marginEnd="8dp"/>
        <AutoCompleteTextView
            android:textSize="15sp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/content"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="35dp"
            android:hint=""
            android:lines="1"
            android:selectAllOnFocus="true"
            android:includeFontPadding="false"
            android:completionThreshold="1"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            style="@style/TextStyle.Start"/>
        <CheckBox
            android:id="@+id/ivShowPassword"
            android:background="@drawable/parent_password_edittext_selector_background"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:button="@null"
            android:scaleType="fitXY"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/clear"
            android:padding="@dimen/dp_7"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"
            android:src="@drawable/ic_search_del"
            android:scaleType="fitXY"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"/>
        <View
            android:id="@+id/viewCountdown"
            android:background="@color/color_border_1"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginBottom="@dimen/dp_14"
            android:layout_marginStart="12dp"
            android:layout_marginVertical="@dimen/dp_14"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_primary"
            android:id="@+id/tvCountdown"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transfer_chatitem_resend_action"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_alignStart="@+id/clear"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/ad_edittext_red"
        android:id="@+id/description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ad_password_strong_error"
        android:layout_below="@+id/container"
        android:layout_marginStart="22dp"
        android:layout_alignStart="@+id/content"
        style="@style/TextStyle.Start"/>
</merge>
