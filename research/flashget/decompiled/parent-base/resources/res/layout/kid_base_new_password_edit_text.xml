<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llContain"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lg_item_height">
        <ImageView
            android:id="@+id/icon"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:scaleType="center"
            android:layout_marginEnd="8dp"/>
        <EditText
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:id="@+id/edit_content"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="35dp"
            android:text=""
            android:lines="1"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            style="@style/TextStyle.Start"/>
        <ImageView
            android:id="@+id/clear"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/contact_edit_del"
            android:scaleType="fitXY"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/ad_edittext_red"
        android:id="@+id/description"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ad_password_strong_error"
        android:layout_below="@+id/llContain"
        android:layout_marginStart="22dp"
        android:layout_alignStart="@+id/content"
        style="@style/TextStyle.Start"/>
</merge>
