<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/ll_main"
    android:tag="layout/kid_camera_webrtc_start_0"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <RelativeLayout
        android:id="@+id/rl_full_srceen"
        android:tag="down"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/ll_surfaceview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/vfNavigation"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/surfaceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_camera_occupied_paused"
            android:background="#bf000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_camera_occupied_paused_content"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ContentBodyStyle">
                <ImageView
                    android:id="@+id/iv_camera_occupied_paused"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/pic_remote_camera_pause"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_white"
                    android:id="@+id/tv_camera_occupied_paused_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/Camera_Video_Paused"
                    style="@style/TextStyle.Center"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_white"
                    android:id="@+id/tv_camera_occupied_paused_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/Camera_Service_Reconnecting"
                    style="@style/TextStyle.Center"/>
                <ProgressBar
                    android:id="@+id/pb_camera_occupied_paused_retry"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="28dp"
                    android:indeterminate="true"/>
                <TextView
                    android:id="@+id/tv_camera_occupied_paused_retry"
                    android:layout_marginTop="40dp"
                    android:text="@string/Common_Retry_Title"
                    style="@style/ButtonStyle"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_camera_occupied_paused_tip"
                    android:background="@drawable/bg_camera_occupied_paused_tip"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:id="@+id/iv_camera_occupied_paused_tip"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_tips_white"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#cfcfd1"
                        android:ellipsize="end"
                        android:id="@+id/tv_camera_occupied_paused_tip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Camera_Manual_Retry_Tip"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/tipsRecycler"
        android:tag="@string/CardBodyStyle"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_alignBottom="@+id/ll_surfaceview"
        android:layout_centerHorizontal="true"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        style="@style/CardBodyStyle"/>
    <ViewFlipper
        android:id="@+id/vfNavigation"
        android:tag="binding_1"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_alignParentStart="true">
        <include layout="@layout/kid_webrtc_camera_navigation"/>
        <include layout="@layout/kid_webrtc_vds_navigation"/>
    </ViewFlipper>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/llVoice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1"
        android:animateLayoutChanges="true">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/float_record_hint_background"
            android:layout_width="wrap_content"
            android:layout_height="180dp"
            android:minWidth="180dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvVoiceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:maxWidth="250dp"
                android:text="@string/Parent_Device_Listening_Title"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                style="@style/TextStyle.Center"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivVoiceImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvVoiceContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:maxWidth="250dp"
                android:text="@string/rs_gesture_content_enable"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                style="@style/TextStyle.Center"/>
        </LinearLayout>
    </LinearLayout>
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/webrtc_start_bar_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_back"
        android:background="@drawable/bg_webrtc_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/webrtc_start_bar_view"
        android:layout_marginStart="16dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nav_ic_back_white"/>
    </LinearLayout>
</RelativeLayout>
