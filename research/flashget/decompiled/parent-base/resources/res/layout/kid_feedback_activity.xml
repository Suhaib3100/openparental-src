<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/color_bg_2"
        android:paddingBottom="11dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/appBar"
            layout="@layout/app_bar_no_title"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="@string/ContentBodyStyle"
            android:layout_height="match_parent"
            style="@style/ContentBodyStyle">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginVertical="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/c_de000000"
                    android:id="@+id/tvMail"
                    android:padding="16dp"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="fb_email"
                    android:layout_alignParentStart="true"
                    style="@style/TextStyle"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/color_text_tertiary"
                    android:id="@+id/etMail"
                    android:background="@null"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="fb_please_input_email"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:layout_centerVertical="true"
                    android:imeOptions="actionNext"
                    android:textCursorDrawable="@drawable/cursor_color"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@+id/tvMail"
                    style="@style/TextStyle.Start"/>
            </RelativeLayout>
            <View
                android:background="@color/ad_base_divider3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <RelativeLayout
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginVertical="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/c_de000000"
                    android:id="@+id/tvFeedbackTitle"
                    android:padding="16dp"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ad_setting_about_feedback_type"
                    android:layout_alignParentStart="true"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/tvFeedbackOption"
                    android:background="@drawable/ad_actionbar_item_selector"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/ad_setting_about_feedback_type_bug"
                    android:layout_weight="1"
                    android:layout_centerVertical="true"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="4dp"
                    android:layout_toEndOf="@+id/tvFeedbackTitle"
                    style="@style/TextStyle"/>
            </RelativeLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_horizontal"
                android:id="@+id/deviceSelector"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <View
                    android:id="@+id/deviceDivider"
                    android:background="@color/ad_base_divider3"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/tvDeviceTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/c_de000000"
                    android:id="@+id/tvDeviceTitle"
                    android:padding="16dp"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/Parent_Device_Select_Title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/deviceDivider"
                    style="@style/TextStyle"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_tertiary"
                    android:ellipsize="end"
                    android:id="@+id/tvDeviceOption"
                    android:background="@drawable/ad_actionbar_item_selector"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/Common_none"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="16dp"
                    app:drawableEndCompat="@drawable/icon_list_more_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/tvDeviceTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvDeviceTitle"
                    app:layout_constraintTop_toTopOf="@+id/tvDeviceTitle"
                    style="@style/TextStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@color/ad_base_divider3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/ad_base_list_item_bg"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">
                <EditText
                    android:scrollbarStyle="insideInset"
                    android:textSize="13sp"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/c_879d9a"
                    android:gravity="start"
                    android:id="@+id/etFeedbackContent"
                    android:background="#f2f4f9"
                    android:paddingTop="12dp"
                    android:focusable="true"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="@string/Profile_Feedback_TextViewHoder"
                    android:layout_alignParentTop="true"
                    android:inputType="textMultiLine"
                    android:overScrollMode="always"
                    android:textCursorDrawable="@drawable/cursor_color"
                    android:paddingStart="16dp"
                    android:layout_marginStart="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etFeedbackContent">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAddPic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/c_666b75"
                        android:id="@+id/tvAddPicTip"
                        android:focusable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/biz_setting_about_feedback_img_tip"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/rvAddPic"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@color/ad_base_divider3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <com.flashget.kid.common.ui.settings.views.TogglePreferenceV2
                android:id="@+id/tpPushService"
                android:background="@color/color_bg_2"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:title="@string/ad_setting_about_feedback_log"
                android:layout_marginVertical="8dp"
                app:showDivider="false"
                app:showSummary="false"
                app:toogleBackground="@drawable/kid_settings_feedback_toggle_button"/>
            <Button
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="@color/color_text_white"
                android:gravity="center"
                android:id="@+id/btSubmit"
                android:background="@drawable/kid_feedback_button_style"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="40dp"
                android:text="@string/fb_btn_commit"
                android:textAllCaps="false"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
