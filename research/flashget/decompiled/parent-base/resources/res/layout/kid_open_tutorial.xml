<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/kid_open_guide_content_bg"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glContentTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="28dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glContentStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.056"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glContentEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.944"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/color_main_text"
            android:id="@+id/tvContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
            app:layout_constraintStart_toEndOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorPrimary"
            android:gravity="start|center_vertical"
            android:id="@+id/tvOpenUrl"
            android:background="@drawable/kid_phone_open_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="30dp"
            android:breakStrategy="simple"
            app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
            app:layout_constraintStart_toEndOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
            style="@style/TextStyle.Start"/>
        <ImageView
            android:id="@+id/ivQRCode"
            android:background="@drawable/ad_qrcode_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
            app:layout_constraintStart_toEndOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"/>
        <ImageView
            android:id="@+id/ivOpenUrlShare"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvOpenUrl"
            app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
            app:layout_constraintTop_toTopOf="@+id/tvOpenUrl"
            app:srcCompat="@drawable/icon_share"/>
        <ImageView
            android:id="@+id/ivRefreshDownloadUrl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvOpenUrl"
            app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
            app:layout_constraintTop_toTopOf="@+id/tvOpenUrl"
            app:srcCompat="@drawable/positioning_btn_refresh"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:id="@+id/tvOpenCode"
            android:background="@drawable/kid_phone_open_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:textDirection="ltr"
            app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
            app:layout_constraintStart_toEndOf="@+id/glContentStart"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_text_white"
            android:id="@+id/tvTitle"
            android:background="@drawable/pic_method"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            android:paddingStart="10dp"
            android:paddingEnd="34dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
