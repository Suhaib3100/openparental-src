<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_34">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_34"
        android:layoutDirection="ltr">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_native_countdown_cell"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_34">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#e25800"
                android:layout_gravity="center"
                android:id="@+id/tvTimeDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_3"
                android:text="0"
                android:includeFontPadding="false"
                android:maxLength="2"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:background="@drawable/corners_rectangle_00fff_100fff_00fff_0"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginLeft="@dimen/dp_2"
                android:layout_marginRight="@dimen/dp_2"
                android:layout_marginHorizontal="@dimen/dp_2"/>
