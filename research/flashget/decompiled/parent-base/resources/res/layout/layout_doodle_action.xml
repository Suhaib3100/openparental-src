<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp_16"
    android:paddingRight="@dimen/dp_16"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:divider="@color/color_border_2"
    android:showDividers="middle"
    android:paddingHorizontal="@dimen/dp_16">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="6"/>
    <RelativeLayout
        android:paddingTop="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_11"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_narrow"
                android:layout_width="@dimen/dp_26"
                android:layout_height="@dimen/dp_26"
                android:src="@drawable/icon_painting_brush_narrow"/>
            <com.flashget.parentalcontrol.widget.CusSeekBar
                android:id="@+id/sb_size"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_8"
                android:layout_marginRight="@dimen/dp_8"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/dp_8"
                android:paddingVertical="@dimen/dp_4"
                app:sb_isSupportRTL="true"
                app:sb_max="100"
                app:sb_min="1"
                app:sb_onlyThumbDraggable="false"
                app:sb_progressBgColor="#f4f2f8"
                app:sb_progressColor="@android:color/transparent"
                app:sb_progressHeight="@dimen/dp_16"
                app:sb_progressRadius="@dimen/dp_10"
                app:sb_scaleColor="#d8d6dc"
                app:sb_scaleCount="10"
                app:sb_scaleShow="true"
                app:sb_scaleSize="@dimen/dp_4"
                app:sb_thumbColor="@color/color_white"
                app:sb_thumbProgressShow="true"
                app:sb_thumbShadowColor="#14000000"
                app:sb_thumbShadowOffsetX="@dimen/dp_0"
                app:sb_thumbShadowOffsetY="@dimen/dp_2"
                app:sb_thumbShadowShow="true"
                app:sb_thumbShadowSize="@dimen/dp_0_5"
                app:sb_thumbSize="@dimen/dp_36"
                app:sb_thumbTextBold="true"
                app:sb_thumbTextColor="#222027"
                app:sb_thumbTextFloat="false"
                app:sb_thumbTextSize="@dimen/sp_14"/>
            <ImageView
                android:id="@+id/iv_enlarge"
                android:layout_width="@dimen/dp_26"
                android:layout_height="@dimen/dp_26"
                android:src="@drawable/icon_painting_brush_enlarge"/>
        </LinearLayout>
        <com.flashget.parentalcontrol.widget.ColorPickerView
            android:id="@+id/cpv_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_4"
            android:layout_below="@+id/ll_size"/>
    </RelativeLayout>
</LinearLayout>
