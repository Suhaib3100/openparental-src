<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/vg_content_body"
            android:tag="@string/ContentBodyStyle"
            android:layout_height="match_parent"
            style="@style/ContentBodyStyle">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/ll_paint_explain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lav_painting"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="328:148"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="painting_demonstration.json"
                    app:lottie_loop="true"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColorHint="@color/color_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_25"
                    android:text="@string/LivePainting_Page_Des"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lav_painting"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/ll_how_to_set_widgets"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_35">
                <RelativeLayout
                    android:id="@+id/rl_how_to_set_widgets_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <View
                        android:background="@color/color_primary"
                        android:layout_width="@dimen/dp_80"
                        android:layout_height="@dimen/dp_10"
                        android:layout_marginTop="@dimen/dp_15"
                        android:alpha="0.5"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/LivePainting_AddWidget_Title"
                        style="@style/TextStyle.Start"/>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:id="@+id/tv_how_to_set_widgets_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/LivePainting_AddWidget_Des1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rl_how_to_set_widgets_title"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColorHint="@color/color_text_secondary"
                    android:id="@+id/tv_how_to_set_widgets_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/LivePainting_AddWidget_Des2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_how_to_set_widgets_1"
                    style="@style/TextStyle.Start"/>
                <ImageView
                    android:id="@+id/iv_add_widgets"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/dp_8"
                    android:src="@drawable/pic_add_widget"
                    app:layout_constraintDimensionRatio="328:96"
                    app:layout_constraintTop_toBottomOf="@+id/tv_how_to_set_widgets_2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:tag="@string/CardBodyStyle"
        style="@style/CardBodyStyle">
        <TextView
            android:id="@+id/btn_i_know"
            android:layout_marginLeft="@dimen/dp_4"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_4"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_Settings"
            android:layout_marginHorizontal="@dimen/dp_4"
            style="@style/FailPageBtnStyle.Main"/>
    </FrameLayout>
</LinearLayout>
