<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/kid_gray_tip"
        android:id="@+id/tvLocationLimitHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/parent_location_limit_hint"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@color/color_bg_2"
        android:layout_width="match_parent"
        android:layout_height="134dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLocationLimitHint">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="16dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="16dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="12dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tvUsageLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parent_location_limit_scope"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toTopOf="@+id/glTop"
            style="@style/TextStyle.Start"/>
        <ToggleButton
            android:id="@+id/tgLocationValid"
            android:background="@drawable/toggle_button"
            android:saveEnabled="false"
            android:layout_width="38dp"
            android:layout_height="24dp"
            android:checked="false"
            android:textOn=""
            android:textOff=""
            app:layout_constraintBottom_toTopOf="@+id/vDivider"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/vDivider"
            android:background="@color/color_border_2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvUsageLimit"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tvOpenUsageLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/parent_location_limit_start"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/vDivider"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/kid_gray_tip"
            android:id="@+id/tvLimitStartHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parent_location_limit_current_position"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/vDivider2"
            app:layout_constraintEnd_toStartOf="@+id/ivLimitStartArrow"
            app:layout_constraintTop_toTopOf="@+id/vDivider"
            style="@style/TextStyle.End"/>
        <ImageView
            android:id="@+id/ivLimitStartArrow"
            android:background="@drawable/icon_list_more_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/vDivider2"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintTop_toTopOf="@+id/vDivider"/>
        <View
            android:id="@+id/vDivider2"
            android:background="@color/color_border_2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvOpenUsageLimit"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tvLocationEndTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/parent_location_limit_end"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/vDivider2"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/kid_gray_tip"
            android:id="@+id/tvLimitEndHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parent_location_customer_all_days"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivLimitEndArrow"
            app:layout_constraintTop_toTopOf="@+id/vDivider2"
            style="@style/TextStyle.End"/>
        <ImageView
            android:id="@+id/ivLimitEndArrow"
            android:background="@drawable/icon_list_more_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintTop_toTopOf="@+id/vDivider2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
