<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivAddGeofenceMapGrid"
        android:background="@drawable/bg_map_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapViewAddGeofence"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/barView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAddGeofenceBack"
        android:background="@drawable/back_bg_round"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barView">
        <ImageView
            android:id="@+id/ivAddGeofenceBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/nav_ic_back_black"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.github.pengrad.mapscaleview.MapScaleView
        android:id="@+id/scaleViewAddGeofence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barView"
        app:scale_expandRtl="true"
        app:scale_maxWidth="50dp"
        app:scale_miles="false"
        app:scale_outline="true"
        app:scale_textSize="10sp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomSheetAddGeofenceView"
        android:tag="@string/BottomSheetBodyStyle"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BottomSheetBodyStyle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bs_frame"
            android:background="@drawable/corners_rectangle_white_top24dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tvAddGeofenceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Parent_Geofence_Add"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Center"/>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/svAddGeofenceForm"
                android:clipToPadding="true"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:fillViewport="true"
                android:overScrollMode="never"
                app:layout_constraintBottom_toTopOf="@+id/clSaveGeofenceArea"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAddGeofenceTitle">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingBottom="@dimen/dp_36"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/tvGeofenceNameTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Geofence_Name"
                        android:layout_marginStart="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:textColorHint="@color/color_text_tertiary"
                        android:id="@+id/etEnterGeofenceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_20"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginRight="@dimen/dp_20"
                        android:hint="@string/Parent_Geofence_Name_Empty_Tip"
                        android:maxLength="200"
                        android:inputType="text"
                        android:layout_marginHorizontal="@dimen/dp_20"
                        app:layout_constraintTop_toBottomOf="@+id/tvGeofenceNameTitle"
                        app:textPassword="false"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/tvLocationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/Parent_Geofence_Location_Title"
                        android:layout_marginStart="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/etEnterGeofenceName"
                        app:layout_goneMarginTop="11dp"
                        style="@style/TextStyle.Start"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clGeofenceLocation"
                        android:background="@drawable/border_e8e6ec_radius_12"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="@dimen/dp_74"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvLocationTitle">
                        <ImageView
                            android:id="@+id/ivGeofenceLocation"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_address"
                            android:contentDescription="@null"
                            android:layout_marginStart="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.5"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/tvGeofenceLocationName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="1"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintBottom_toTopOf="@+id/tvGeofenceLocation"
                            app:layout_constraintEnd_toStartOf="@+id/tvChangeGeofenceLocation"
                            app:layout_constraintStart_toEndOf="@+id/ivGeofenceLocation"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"
                            style="@style/TextStyle.Start"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/color_text_tertiary"
                            android:ellipsize="end"
                            android:gravity="top"
                            android:id="@+id/tvGeofenceLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:layout_marginBottom="@dimen/dp_10"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/tvGeofenceLocationName"
                            app:layout_constraintStart_toStartOf="@+id/tvGeofenceLocationName"
                            app:layout_constraintTop_toBottomOf="@+id/tvGeofenceLocationName"
                            style="@style/TextStyle.Start"/>
                        <ImageView
                            android:id="@+id/tvChangeGeofenceLocation"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/icon_list_more_arrow"
                            android:contentDescription="@null"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:gravity="center_vertical"
                        android:id="@+id/tvGeofenceRadiusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/Parent_Geofence_Radius"
                        app:layout_constraintStart_toStartOf="@+id/clGeofenceLocation"
                        app:layout_constraintTop_toBottomOf="@+id/clGeofenceLocation"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_primary"
                        android:gravity="center"
                        android:id="@+id/tvSeekBarValue"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginBottom="1dp"
                        android:text="@string/Parent_Geofence_Radius_Unit"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toTopOf="@+id/seekBarGeofenceRadius"
                        app:layout_constraintStart_toStartOf="parent"
                        style="@style/TextStyle.Center"/>
                    <SeekBar
                        android:id="@+id/seekBarGeofenceRadius"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="31dp"
                        android:max="900"
                        android:progress="0"
                        android:progressDrawable="@drawable/geofence_seekbar_progress"
                        android:thumb="@drawable/geofence_seekbar_thumb"
                        android:thumbOffset="9dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:layout_marginStart="62dp"
                        android:layout_marginEnd="70dp"
                        android:splitTrack="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvGeofenceRadiusTitle"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary"
                        android:gravity="center_vertical"
                        android:id="@+id/tvMinRadius"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Geofence_Radius_Unit"
                        android:layout_marginStart="20dp"
                        app:layout_constraintBottom_toBottomOf="@+id/seekBarGeofenceRadius"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/seekBarGeofenceRadius"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary"
                        android:gravity="center_vertical"
                        android:id="@+id/tvMaxRadius"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Geofence_Radius_Unit"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintBottom_toBottomOf="@+id/seekBarGeofenceRadius"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/seekBarGeofenceRadius"
                        style="@style/TextStyle.End"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clSaveGeofenceArea"
                android:background="@color/color_bg_2"
                android:focusable="false"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="96dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:id="@+id/tvSaveGeofence"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginBottom="36dp"
                    android:text="@string/common_save_btn"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/ButtonStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
