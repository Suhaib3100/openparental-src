<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintDimensionRatio="w,1:1">
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:background="@drawable/corners_rectangle_white_8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:emptyResId="@layout/default_img_error_small1"
        app:errorResId="@layout/default_img_error_small"
        app:loadingResId="@layout/default_img_loading_small"
        app:timeoutResId="@layout/default_img_timeout_small"
        app:waitLoadingResId="@layout/default_img_waiting_small">
        <ImageView
            android:id="@+id/img_snapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/common_90333137_bottom8"
        android:paddingLeft="@dimen/dp_6"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_6"
        android:paddingVertical="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_text_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_nick_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="现在"
            android:singleLine="true"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_text_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="现在"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_nick_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/img_bg"
        android:background="@drawable/corners_rectangle_66000000_8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/img_dot"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="@+id/multi_state_view"
        app:layout_constraintTop_toTopOf="@+id/multi_state_view"
        style="@style/Dot_No_Border"/>
    <ImageView
        android:id="@+id/img_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:src="@drawable/parent_setting_audio_recording_multi_selector"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="@+id/multi_state_view"
        app:layout_constraintTop_toTopOf="@+id/multi_state_view"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_text_white"
        android:id="@+id/tv_violation"
        android:background="@drawable/corners_recetangle_ffa707_10"
        android:paddingLeft="@dimen/dp_8"
        android:paddingRight="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_4"
        android:paddingHorizontal="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="@+id/multi_state_view"
        app:layout_constraintTop_toTopOf="@+id/multi_state_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
