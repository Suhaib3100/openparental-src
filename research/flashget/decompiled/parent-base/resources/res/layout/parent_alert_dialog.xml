<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/device_fragment_item_bg"
        android:paddingLeft="19dp"
        android:paddingTop="24dp"
        android:paddingRight="19dp"
        android:paddingBottom="15dp"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:paddingHorizontal="19dp">
        <ImageView
            android:id="@+id/ivClose"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black_404040"
            android:gravity="center_horizontal"
            android:id="@+id/tvTitle"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/Parent_Device_Add_Unable_Title"
            android:paddingHorizontal="5dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tvContent"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/Parent_Device_Add_Unable_Upgrade"
            android:paddingHorizontal="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textColor="@color/color_primary"
            android:id="@+id/tvOk"
            android:background="@drawable/ad_dlg_btn_color_bg"
            android:layout_marginTop="20dp"
            android:text="@string/Common_Confirm"
            android:textDirection="locale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
            style="@style/parent_dlg_base_btn_padding"/>
        <TextView
            android:textColor="@color/gray_a4a8b3"
            android:id="@+id/tvCancel"
            android:background="@drawable/ad_dlg_btn_color_bg"
            android:layout_marginTop="20dp"
            android:text="@string/Common_Cancel"
            android:textDirection="locale"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toStartOf="@+id/tvOk"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
            style="@style/parent_dlg_base_btn_padding"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
