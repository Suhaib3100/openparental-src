<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/parent_app_rule_activity_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/parent_list_menu"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Common_AppRules"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:emptyDrawableId="@drawable/pic_blankpage_app_info_failed"
        app:emptyResId="@layout/parent_data_empty"
        app:emptyTitle="@string/Parent_UsageLimit_Select_None"
        app:errorDesc="@string/iOSK_NotEnabledFullMode_Des"
        app:errorDrawableId="@drawable/pic_blankpage_not_full_mode"
        app:errorResId="@layout/parent_data_ios_supervised"
        app:layout_constraintBottom_toTopOf="@+id/ll_operation_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:networkErrorResId="@layout/default_network_error">
        <androidx.core.widget.NestedScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constrainedHeight="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/vg_content_body"
                android:tag="binding_2"
                android:paddingBottom="@dimen/dp_40"
                android:layout_height="match_parent"
                style="@style/ContentBodyStyle">
                <include
                    android:id="@+id/parentSearchView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/parent_search_bar_layout"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:id="@+id/cl_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/parentSearchView">
                    <View
                        android:id="@+id/view_setting"
                        android:background="@drawable/corners_rectangle_7e5ded_18"
                        android:layout_width="@dimen/dp_3"
                        android:layout_height="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_setting_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_setting_title"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_setting_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_QuickSettings"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/dp_6"
                        app:layout_constraintStart_toEndOf="@+id/view_setting"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:background="@drawable/corners_rectangle_white_16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        app:layout_constraintTop_toBottomOf="@+id/tv_setting_title">
                        <com.flashget.parentalcontrol.ui.component.ToggleItemPreference
                            android:id="@+id/tiDisableAll"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_16"
                            app:content="@string/AppRules_QuickSettings_BlockAllAppsDes"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:title="@string/AppRules_QuickSettings_BlockAllApps"/>
                        <com.flashget.parentalcontrol.ui.component.ToggleItemPreference
                            android:id="@+id/tiNewApp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_16"
                            android:layout_marginBottom="16dp"
                            app:content="@string/AppRules_QuickSettings_BlockNewAppsDes"
                            app:isShowDivider="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tiDisableAll"
                            app:title="@string/AppRules_QuickSettings_BlockNewApps"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/cl_setting">
                    <View
                        android:id="@+id/view_app"
                        android:background="@drawable/corners_rectangle_7e5ded_18"
                        android:layout_width="@dimen/dp_3"
                        android:layout_height="@dimen/dp_12"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_app_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_app_title"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="@string/Common_AllApps"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/dp_6"
                        app:layout_constraintStart_toEndOf="@+id/view_app"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_tertiary"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_recently_installed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/dp_24"
                        android:text="@string/RecentlyInstalled_Title"
                        android:drawablePadding="@dimen/dp_2"
                        android:drawableEnd="@drawable/icon_list_arrow_right"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_app_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_app_title"
                        style="@style/TextStyle.Start"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_80"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/tv_app_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSelectAppSearchEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pic_blankpage_no_search_results"
                    app:layout_constraintBottom_toTopOf="@+id/tvSelectAppSearchEmpty"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/parentSearchView"
                    app:layout_constraintVertical_bias="0.45"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/tvSelectAppSearchEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/Common_SearchEmpty_Description"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivSelectAppSearchEmpty"
                    app:layout_constraintVertical_bias="0.45"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/groupSearchResultEmpty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="ivSelectAppSearchEmpty,tvSelectAppSearchEmpty"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
    <View
        android:background="@drawable/shadow_105352"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:translationY="2dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_operation_bottom"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_operation_bottom"
        android:background="@color/color_bg_2"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_rule_allow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Device_Alert_Allow"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/icon_apprule_allow"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_rule_blocked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Common_Block"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/icon_apprule_disable"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_rule_default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Setting_RadioButton_Default"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/icon_apprule_default"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
