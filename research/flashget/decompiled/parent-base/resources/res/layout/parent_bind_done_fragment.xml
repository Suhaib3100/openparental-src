<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/color_bg_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="25dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="25dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="80dp"/>
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/ToolBarStyle"
            android:id="@+id/toolbar_back"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:minHeight="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/nav_ic_back_black"
            app:title="@string/Add_Device"
            app:titleTextAppearance="@style/toolbar_style_bold"
            app:titleTextColor="@color/color_text_primary"/>
        <View
            android:background="@color/gray_ececee"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar_back"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toTopOf="@+id/glTop">
            <View
                android:background="@drawable/corners_rectangle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"/>
            <View
                android:background="@drawable/corners_rectangle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"/>
            <View
                android:background="@drawable/corners_rectangle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivStep"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/Parent_Bind_Step1_Title"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toTopOf="@+id/glTop"
            app:srcCompat="@drawable/ic_step3"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_secondary"
            android:gravity="start"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/Bind_Step3_Title"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/ivStep"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="14sp"
            android:gravity="start"
            android:id="@+id/tvContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/Parent_Bind_Step3_Subtitle"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:gravity="start"
            android:id="@+id/tvTitleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/Parent_Bind_Step3_TipText"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
            style="@style/TextStyle.Start"/>
        <EditText
            android:textSize="15sp"
            android:id="@+id/edit_name"
            android:background="@drawable/corners_rectangle_r20_a08"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:maxLength="30"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:paddingStart="20dp"
            android:paddingEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleName"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/kid_guide_err_txt"
            android:gravity="start"
            android:id="@+id/tvTimeOut"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Request timeout, please try again."
            android:textDirection="locale"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/edit_name"
            style="@style/TextStyle.Start"/>
        <ImageView
            android:id="@+id/ivLogo"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:contentDescription="@string/Parent_Bind_Step1_Subtitle"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:srcCompat="@drawable/step_pic_3"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_text_white"
            android:gravity="center"
            android:id="@+id/tvNext"
            android:background="@drawable/corners_rectangle"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="@string/Common_Complete"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:paddingVertical="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivLogo"
            app:layout_constraintVertical_bias="1"
            style="@style/TextStyle.Center"/>
        <TextView
            android:id="@+id/tvSkip"
            android:visibility="gone"
            android:text="@string/Parent_Bind_Success_Bind_Next"
            android:textDirection="locale"
            android:layout_marginStart="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvNext"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvNext"
            style="@style/parent_blue_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
