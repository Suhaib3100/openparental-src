<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="80dp"/>
    <ImageView
        android:id="@+id/ivMenu"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_more"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Add_Device"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <View
        android:background="@color/gray_ececee"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/ivNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/glTop">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/color_bg_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="27dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="27dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:background="@drawable/corners_rectangle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>
                <View
                    android:background="@drawable/corners_rectangle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>
                <View
                    android:background="@drawable/corners_rectangle_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/ivStep"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_step2"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_secondary"
                android:gravity="start"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/Parent_Bind_Step2_Title"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/ivStep"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/ivStep1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:srcCompat="@drawable/pic_bind_device_step_one"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tvStep1_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Parent_Bind_Step2_Subtitle1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toEndOf="@+id/ivStep1"
                app:layout_constraintTop_toTopOf="@+id/ivStep1"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/light_status_offline"
                android:id="@+id/tvStep1_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/Parent_Bind_Step2_Subtitle1_1"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/tvStep1_1"
                app:layout_constraintTop_toBottomOf="@+id/tvStep1_1"
                style="@style/TextStyle.Start"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@+id/tvStep1_1"
                app:layout_constraintStart_toStartOf="@+id/tvStep1_1"
                app:layout_constraintTop_toBottomOf="@+id/tvStep1_2">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="center"
                    android:background="@drawable/parent_download_url_bg"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="20dp"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_text_tertiary"
                        android:id="@+id/tvDownloadUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Position_Retry"
                        android:layout_weight="1"
                        android:textDirection="locale"
                        app:layout_constraintEnd_toStartOf="@+id/ivDownloadUrlRefresh"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:id="@+id/ivDownloadUrlRefresh"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/positioning_btn_refresh"/>
                    <ImageView
                        android:id="@+id/ivDownloadUrlShare"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/icon_share"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:id="@+id/llShowQr"
                    android:background="@drawable/parent_download_url_bg"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivshowqr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/pic_qr_code"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tvStep2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/Parent_Bind_Step2_Subtitle2"
                app:layout_constraintEnd_toEndOf="@+id/tvStep1_1"
                app:layout_constraintStart_toStartOf="@+id/tvStep1_1"
                app:layout_constraintTop_toBottomOf="@+id/llDownload"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textColor="@color/colorPrimary"
                android:id="@+id/tvOpenGuide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/Parent_Bind_Open_Kid_Text"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/tvStep2"
                app:layout_constraintTop_toBottomOf="@+id/tvStep2"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textColor="@color/colorPrimary"
                android:id="@+id/tvBindStatusCheck"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/Parent_Bind_Step_Has_Device"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/llBindCode"
                app:layout_constraintTop_toBottomOf="@+id/llBindCode"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/ivDivider1"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toTopOf="@+id/ivStep2"
                app:layout_constraintEnd_toEndOf="@+id/ivStep1"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/ivStep1"
                app:srcCompat="@drawable/device_track_drivider"/>
            <ImageView
                android:id="@+id/ivStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/ivStep1"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="@+id/tvStep2"
                app:srcCompat="@drawable/pic_bind_device_step_two"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llBindCode"
                android:background="@drawable/parent_download_url_bg"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintEnd_toEndOf="@+id/tvStep1_1"
                app:layout_constraintStart_toStartOf="@+id/tvStep1_1"
                app:layout_constraintTop_toBottomOf="@+id/tvStep3">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/color_text_tertiary"
                    android:gravity="center"
                    android:id="@+id/tvBindCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Parent_Bind_Step2_Requesting_Code"
                    android:layout_weight="1"
                    android:textDirection="ltr"
                    android:layout_marginEnd="8dp"/>
                <ImageView
                    android:id="@+id/ivRefreshBindCode"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/positioning_btn_refresh"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tvStep3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/Parent_Bind_Step2_Subtitle3"
                app:layout_constraintEnd_toEndOf="@+id/tvStep1_1"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/tvStep1_1"
                app:layout_constraintTop_toBottomOf="@+id/tvOpenGuide"/>
            <ImageView
                android:id="@+id/ivStep3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/ivStep1"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="@+id/tvStep3"
                app:srcCompat="@drawable/pic_bind_device_step_three"/>
            <ImageView
                android:id="@+id/ivDivider2"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toTopOf="@+id/ivStep3"
                app:layout_constraintEnd_toEndOf="@+id/ivStep1"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/ivStep2"
                app:srcCompat="@drawable/device_track_drivider"/>
            <TextView
                android:textSize="13sp"
                android:id="@+id/tvSkip"
                android:visibility="gone"
                android:layout_marginTop="49dp"
                android:layout_marginBottom="49dp"
                android:text="@string/Common_NotNow"
                android:textDirection="locale"
                android:textAlignment="viewStart"
                android:layout_marginStart="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llBindCode"
                app:layout_constraintVertical_bias="1"
                style="@style/parent_blue_btn"/>
            <TextView
                android:textSize="13sp"
                android:id="@+id/tvDone"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="49dp"
                android:layout_marginBottom="49dp"
                android:text="@string/parent_bind_dlg_done"
                android:textDirection="locale"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintTop_toBottomOf="@+id/tvStep3"
                app:layout_constraintVertical_bias="1"
                style="@style/parent_blue_btn"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llMoreHelp"
                android:background="@drawable/border_f4f2f8_radius_20"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintEnd_toEndOf="@+id/tvStep1_1"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/llBindCode">
                <ImageView
                    android:id="@+id/ivHelpIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/icon_add_device_help"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tvHelp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_NeedMoreHelp_Button"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    style="@style/TextStyle.Start"/>
                <ImageView
                    android:id="@+id/ivArrowIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_list_more_arrow"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_white"
        android:gravity="center"
        android:id="@+id/ivNext"
        android:background="@drawable/corners_rectangle"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:text="@string/Parent_Bind_Step_Has_Device"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
