<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/parent_bind_second_step_fragment_0"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="10dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/fl_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/vg_content_body"
            android:tag="@string/ContentBodyStyle"
            style="@style/ContentBodyStyle">
            <ImageView
                android:id="@+id/ivStep"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_step2"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_4"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:background="@drawable/corners_rectangle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp_4"
                    android:layout_marginRight="@dimen/dp_4"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/dp_4"/>
                <View
                    android:background="@drawable/corners_rectangle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp_4"
                    android:layout_marginRight="@dimen/dp_4"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/dp_4"/>
                <View
                    android:background="@drawable/corners_rectangle_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp_4"
                    android:layout_marginRight="@dimen/dp_4"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/dp_4"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lly_tips"
                android:background="@drawable/parent_download_url_bg"
                android:paddingLeft="@dimen/dp_12"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_12"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:paddingHorizontal="@dimen/dp_12"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tv_open_kid">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:src="@drawable/icon_tips"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_open_failed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Parent_Bind_Step2_Tips"
                    android:layout_marginStart="@dimen/dp_8"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_permission_exception"
                android:background="@drawable/corners_recetangle_ffffff_e8e6ec_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_40"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/lly_tips">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_permission_exception"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/sp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:text="@string/Parent_TutorialsForGranting_Title"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:id="@+id/lly_accessibility_permission"
                    android:tag="binding_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_permission_exception">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_device_info_permissions"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/Parent_TutorialsForAccessibility_Title"
                        android:drawablePadding="@dimen/dp_6"
                        android:drawableEnd="@drawable/icon_list_more_arrow"
                        android:layout_marginStart="@dimen/dp_8"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
                <View
                    android:id="@+id/divider1"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginStart="@dimen/dp_42"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/lly_accessibility_permission"/>
                <LinearLayout
                    android:id="@+id/lly_run_background_permission"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/divider1">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_authority_background_run"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/Parent_TutorialsForRunningStably_Title"
                        android:drawablePadding="@dimen/dp_6"
                        android:drawableEnd="@drawable/icon_list_more_arrow"
                        android:layout_marginStart="@dimen/dp_8"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
                <View
                    android:id="@+id/divider2"
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginStart="@dimen/dp_42"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/lly_run_background_permission"/>
                <LinearLayout
                    android:id="@+id/lly_others_permission"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_24"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider2">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_authority_other"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/Parent_TutorialsForOtherPermissions_Title"
                        android:drawablePadding="@dimen/dp_6"
                        android:drawableEnd="@drawable/icon_list_more_arrow"
                        android:layout_marginStart="@dimen/dp_8"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_open_hid_tips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/Parent_Bind_Step2_Des"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_open_kid"
                android:tag="binding_4"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/Download_Page_Button4"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tv_open_hid_tips"
                style="@style/ButtonStyle"/>
            <View
                android:background="@color/color_yellow"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_19"
                app:layout_constraintStart_toStartOf="@+id/tvTitle"
                app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:gravity="start"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/Parent_Bind_Step2_Title1"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/ivStep"
                style="@style/TextStyle.Start"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="0dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="0dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/fl_next"
        android:tag="@string/ContentBodyStyle"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="@dimen/dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"
        style="@style/ContentBodyStyle">
        <TextView
            android:gravity="center"
            android:id="@+id/ivNext"
            android:tag="binding_5"
            android:layout_marginLeft="@dimen/dp_4"
            android:layout_marginRight="@dimen/dp_4"
            android:text="@string/Common_Complete"
            android:layout_marginHorizontal="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="1"
            style="@style/ButtonStyle"/>
    </FrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Add_Device"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <ImageView
        android:id="@+id/ivMenu"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:srcCompat="@drawable/ic_more"/>
</androidx.constraintlayout.widget.ConstraintLayout>
