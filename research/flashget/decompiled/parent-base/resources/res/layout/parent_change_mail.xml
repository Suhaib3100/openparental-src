<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:tag="@string/ContentBodyStyle"
    android:background="@color/color_bg_2"
    android:paddingTop="@dimen/dp_20"
    android:paddingBottom="35dp"
    android:layout_height="match_parent"
    style="@style/ContentBodyStyle">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ChangeAccountEmail_Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvNewMail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/Parent_Email_Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescription"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/ChangeAccountEmail_Des"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/TextStyle.Start"/>
    <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
        android:id="@+id/etEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:hint="@string/Profile_Feedback_EnterEmail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNewMail"
        app:regexRule="@string/email_input_regex_rule"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvPassword"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:text="@string/Common_Acount_Verification_Password_Confirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etEmail"
        style="@style/TextStyle.Start"/>
    <com.flashget.parentalcontrol.ui.base.NewPasswordEditText
        android:id="@+id/etPassword"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:hint="@string/parent_login_password_hint"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPassword"
        app:maxChars="48"
        app:textPassword="true"/>
    <TextView
        android:id="@+id/btNext"
        android:layout_marginTop="30dp"
        android:text="@string/Common_Next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPassword"
        app:layout_constraintVertical_bias="1"
        style="@style/ButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
