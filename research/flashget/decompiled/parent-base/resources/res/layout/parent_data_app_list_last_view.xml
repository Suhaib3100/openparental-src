<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContent"
        android:background="@drawable/corners_rectangle_white_bottom_16dp"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivAppListIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_21"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvAppListName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/ivAppListIcon"
            app:layout_constraintEnd_toStartOf="@+id/tvAppInstallTime"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/ivAppListIcon"
            app:layout_constraintTop_toTopOf="@+id/ivAppListIcon"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_text_tertiary"
            android:id="@+id/tvAppInstallTime"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivAppListIcon"
            app:layout_constraintEnd_toStartOf="@+id/ivAppListRight"
            app:layout_constraintTop_toTopOf="@+id/ivAppListIcon"
            style="@style/TextStyle.End"/>
        <ImageView
            android:id="@+id/ivAppListRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_1"
            android:src="@drawable/icon_list_more_arrow"
            android:height="14dp"
            android:width="14dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="@+id/ivAppListIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivAppListIcon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
