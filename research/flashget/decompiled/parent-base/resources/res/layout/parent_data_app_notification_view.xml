<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/parent_data_app_notification_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <ImageView
        android:id="@+id/ivAppNotificationIcon"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_noapp"
        android:scaleType="centerInside"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vNotReadDot"
        app:layout_constraintEnd_toEndOf="@+id/ivAppNotificationIcon"
        app:layout_constraintTop_toTopOf="@+id/ivAppNotificationIcon"
        style="@style/Dot_White_Border"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_text_secondary"
        android:ellipsize="end"
        android:id="@+id/tvAppNotificationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/tvAppNotificationTime"
        app:layout_constraintStart_toEndOf="@+id/ivAppNotificationIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/color_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/tvAppNotificationDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="false"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvAppNotificationName"
        app:layout_constraintTop_toBottomOf="@+id/tvAppNotificationName"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tvAppNotificationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvAppNotificationName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.End"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvAppNotificationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/ivAppNotificationIcon"
        android:textIsSelectable="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppNotificationDeviceName"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvAppNotificationContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="14dp"
        android:maxEms="24"
        android:layout_below="@+id/tvAppNotificationTitle"
        android:lineSpacingMultiplier="1.2"
        android:textIsSelectable="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppNotificationTitle"
        style="@style/TextStyle.Start"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/blurCard"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/ad_transparent"
        app:cardCornerRadius="@dimen/dp_16"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blur_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
