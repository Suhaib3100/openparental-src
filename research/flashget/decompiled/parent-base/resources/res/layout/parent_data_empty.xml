<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/llEmpty"
        android:tag="@string/ContentBodyStyle"
        android:layout_height="match_parent"
        style="@style/ContentBodyStyle">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/img_error"
            android:layout_width="160dp"
            android:layout_height="110dp"
            android:layout_marginTop="80dp"
            android:src="@drawable/pic_blankpage_app_info_failed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_error_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="20dp"
            android:layout_marginRight="@dimen/dp_24"
            android:text="@string/AppList_LoadingFailed_Title"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/img_error"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tv_error_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/AppList_LoadingFailed_Des"
            app:layout_constraintTop_toBottomOf="@+id/tv_error_title"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_text_white"
            android:gravity="center"
            android:id="@+id/btn_retry"
            android:background="@drawable/corners_rectangle_7e5ded_22"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/Common_Retry_Title"
            android:paddingVertical="11dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_to_see"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_primary"
            android:gravity="center"
            android:id="@+id/tv_to_see"
            android:background="@drawable/corners_rectangle_7e5ded_22_w1"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:text="@string/Common_GetHelp"
            android:paddingVertical="11dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
