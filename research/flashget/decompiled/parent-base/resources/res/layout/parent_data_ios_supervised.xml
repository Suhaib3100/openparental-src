<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/parent_data_ios_supervised_0"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llEmpty"
        android:tag="@string/ContentBodyStyle"
        android:layout_height="match_parent"
        style="@style/ContentBodyStyle">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/img_error"
            android:layout_width="160dp"
            android:layout_height="110dp"
            android:layout_marginTop="80dp"
            android:src="@drawable/pic_blankpage_not_full_mode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_error_title"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="20dp"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/img_error"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tv_error_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/iOSK_NotEnabledFullMode_Des"
            app:layout_constraintTop_toBottomOf="@+id/tv_error_title"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_white"
            android:gravity="center"
            android:id="@+id/btn_retry"
            android:background="@drawable/corners_rectangle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:text="@string/Common_EnableNow"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/ButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
