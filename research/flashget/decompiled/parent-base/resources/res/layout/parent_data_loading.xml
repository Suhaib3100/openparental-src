<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/img_tip"
        android:layout_width="160dp"
        android:layout_height="110dp"
        android:layout_marginTop="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="app_info_loading.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_text_secondary"
        android:gravity="center"
        android:tag="@string/ContentBodyStyle"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/AppList_Loading_Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_tip"
        style="@style/ContentBodyStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
