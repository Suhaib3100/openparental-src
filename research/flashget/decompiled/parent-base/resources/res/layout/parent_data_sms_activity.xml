<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/parent_data_sms_activity_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_Device_Application_List_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <include
        android:id="@+id/rlLoadingPanel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/parent_data_loading"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/fl_search"
        android:tag="binding_1"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/ContentBodyStyle">
        <include
            android:id="@+id/parentSearchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/parent_search_bar_layout"/>
    </FrameLayout>
    <com.jcodecraeer.xrecyclerview.XRecyclerView
        android:id="@+id/xrvList"
        android:tag="@string/ContentBodyStyle"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_search"
        style="@style/ContentBodyStyle"/>
    <include
        android:id="@+id/llIosSupervised"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/parent_data_ios_supervised"/>
    <include
        android:id="@+id/llEmpty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/parent_data_empty"/>
    <include
        android:id="@+id/llError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        layout="@layout/activity_time_limit_error"/>
    <include
        android:id="@+id/layoutSearchNoResult"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_search"
        app:layout_constraintVertical_bias="0.41"
        layout="@layout/search_no_result"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/banner_control_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
