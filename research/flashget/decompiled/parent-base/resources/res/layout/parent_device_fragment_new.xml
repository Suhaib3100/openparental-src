<?xml version="1.0" encoding="utf-8"?>
<com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh_layout"
    android:tag="layout/parent_device_fragment_new_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDeviceSpinner"
            android:background="@color/parent_device_bg"
            android:paddingTop="22dp"
            android:paddingBottom="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="22dp">
            <com.flashget.kid.common.ui.base.views.BarView
                android:id="@+id/barView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_device_info"
                android:tag="@string/CardBodyStyle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barView"
                style="@style/CardBodyStyle">
                <ImageView
                    android:id="@+id/iv_device_image"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/pic_home_avatar_default_signed"/>
                <ImageView
                    android:id="@+id/iv_dropdown_icon"
                    android:tag="binding_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_add_device"
                    app:layout_constraintEnd_toStartOf="@+id/iv_add_device"
                    app:layout_constraintTop_toTopOf="@+id/iv_add_device"
                    app:srcCompat="@drawable/icon_nav_expand_white"/>
                <ImageView
                    android:id="@+id/iv_add_device"
                    android:tag="binding_2"
                    android:background="@drawable/icon_nav_add_white"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_device_image"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_device_image"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_device_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:minHeight="20dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_device_image"
                    app:layout_constraintEnd_toEndOf="@+id/tv_device_name"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/tv_device_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_device_name">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_text_white"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_device_live_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_Unknow"
                        android:singleLine="true"
                        android:drawablePadding="4dp"
                        app:drawableStartCompat="@drawable/light_status_unknown"
                        style="@style/TextStyle.Center"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_text_white"
                        android:ellipsize="middle"
                        android:gravity="center"
                        android:id="@+id/tv_device_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_Unknow"
                        android:singleLine="true"
                        android:drawablePadding="4dp"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        app:drawableStartCompat="@drawable/ic_battery_orange"
                        style="@style/TextStyle.Center"/>
                </LinearLayout>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/color_text_white"
                    android:ellipsize="end"
                    android:id="@+id/tv_device_name"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_Loading"
                    android:maxLines="1"
                    android:textDirection="locale"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toTopOf="@+id/ll_device_info"
                    app:layout_constraintEnd_toStartOf="@+id/iv_dropdown_icon"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/iv_device_image"
                    app:layout_constraintTop_toTopOf="@+id/iv_device_image"
                    style="@style/TextStyle.Start"/>
                <View
                    android:background="@color/color_bg_2"
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:alpha="0.2"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_add_device"
                    app:layout_constraintEnd_toStartOf="@+id/iv_add_device"
                    app:layout_constraintStart_toEndOf="@+id/iv_dropdown_icon"
                    app:layout_constraintTop_toTopOf="@+id/iv_add_device"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_content"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:layout_weight="1"
            android:layout_below="@+id/clDeviceSpinner">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:background="@drawable/primary_gradient_up2down"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/rlFeatureList"
                    android:tag="binding_4"
                    android:paddingBottom="@dimen/dp_42"
                    android:clickable="false"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/CardBodyStyle">
                    <include
                        android:id="@+id/layout_use_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_centerHorizontal="true"
                        app:layout_constraintTop_toBottomOf="@+id/layout_payment_event"
                        layout="@layout/use_report"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ll_live_monitoring"
                        android:tag="binding_5"
                        android:background="@drawable/device_fragment_item_bg"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingVertical="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_use_report">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_live_monitoring"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Home_Live_Monitoring"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextStyle"/>
                        <androidx.constraintlayout.utils.widget.ImageFilterView
                            android:id="@+id/iv_web_rtc_settings"
                            android:tag="binding_6"
                            android:padding="@dimen/dp_16"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/icon_setting"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_live_monitoring"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tv_live_monitoring"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:layout_constraintTop_toBottomOf="@+id/tv_live_monitoring">
                            <com.flashget.parentalcontrol.widget.FreeImageViewV2
                                android:id="@+id/tv_remote_camera"
                                android:tag="binding_7"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:free_icon="@drawable/icon_list_live_camera"
                                app:free_text="@string/Parent_Device_Remote_Camera_Title"
                                app:user_auto_handle_click="true"/>
                            <com.flashget.parentalcontrol.widget.FreeImageViewV2
                                android:id="@+id/tv_screen_mirroring"
                                android:tag="binding_8"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:free_icon="@drawable/icon_list_live_mirroring"
                                app:free_text="@string/Parent_Device_Screenshot_Title"
                                app:user_auto_handle_click="true"/>
                            <com.flashget.parentalcontrol.widget.FreeImageViewV2
                                android:id="@+id/tv_one_way_audio"
                                android:tag="binding_9"
                                android:visibility="visible"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:free_icon="@drawable/icon_list_live_audio"
                                app:free_text="@string/Parent_Device_Listening_Title"
                                app:user_auto_handle_click="true"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_block_all_apps"
                        android:background="@drawable/device_fragment_item_bg"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingStart="@dimen/dp_12"
                        android:paddingEnd="@dimen/dp_6"
                        android:paddingVertical="@dimen/dp_12"
                        app:layout_constraintTop_toBottomOf="@+id/ll_live_monitoring">
                        <ImageView
                            android:id="@+id/iv_lock_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/pic_lock_device"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_15"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary"
                            android:ellipsize="end"
                            android:id="@+id/tv_block_all_apps_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/AppRules_QuickSettings_BlockAllApps"
                            android:singleLine="true"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintBottom_toTopOf="@+id/tv_block_all_apps_desc"
                            app:layout_constraintEnd_toStartOf="@+id/iv_block_all_apps_badge"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="@+id/tv_block_all_apps_desc"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TextStyle"/>
                        <ImageView
                            android:id="@+id/iv_block_all_apps_badge"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/icon_upperright_upgrade"
                            android:contentDescription="@null"
                            android:layout_marginStart="@dimen/dp_3"
                            android:layout_marginEnd="@dimen/dp_20"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_block_all_apps_title"
                            app:layout_constraintEnd_toStartOf="@+id/barrier_block_all_apps_end_icon"
                            app:layout_constraintStart_toEndOf="@+id/tv_block_all_apps_title"
                            app:layout_constraintTop_toTopOf="@+id/tv_block_all_apps_title"/>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="@color/color_text_secondary"
                            android:id="@+id/tv_block_all_apps_desc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="@string/AppRules_QuickSettings_BlockAllAppsDes"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="@dimen/dp_20"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/barrier_block_all_apps_end_icon"
                            app:layout_constraintStart_toEndOf="@+id/iv_lock_icon"
                            app:layout_constraintTop_toBottomOf="@+id/tv_block_all_apps_title"
                            style="@style/TextStyle"/>
                        <com.flashget.parentalcontrol.widget.RequestToggleButton
                            android:id="@+id/tb_block_all_apps"
                            android:background="@drawable/toggle_button"
                            android:saveEnabled="false"
                            android:layout_width="38dp"
                            android:layout_height="24dp"
                            android:checked="false"
                            android:textOn=""
                            android:textOff=""
                            android:layout_marginEnd="@dimen/dp_10"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <View
                            android:id="@+id/tb_block_all_apps_click"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tb_block_all_apps"
                            app:layout_constraintEnd_toEndOf="@+id/tb_block_all_apps"
                            app:layout_constraintStart_toStartOf="@+id/tb_block_all_apps"
                            app:layout_constraintTop_toTopOf="@+id/tb_block_all_apps"/>
                        <ImageView
                            android:id="@+id/iv_loading_state"
                            android:padding="@dimen/dp_10"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp_44"
                            android:layout_height="@dimen/dp_44"
                            android:src="@drawable/icon_loading"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.constraintlayout.widget.Barrier
                            android:id="@+id/barrier_block_all_apps_end_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:barrierDirection="start"
                            app:constraint_referenced_ids="tb_block_all_apps,iv_loading_state"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <include
                        android:id="@+id/layout_live_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_centerHorizontal="true"
                        app:layout_constraintTop_toBottomOf="@+id/cl_block_all_apps"
                        layout="@layout/kid_device_location"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/layout_live_location"/>
                    <include
                        android:id="@+id/cly_not_free"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        app:layout_constraintTop_toBottomOf="@+id/wtv_net"
                        app:layout_goneMarginTop="@dimen/dp_0"
                        layout="@layout/parent_not_free"/>
                    <include
                        android:id="@+id/layout_payment_event"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        app:layout_constraintTop_toBottomOf="@+id/cly_not_free"
                        layout="@layout/payment_event_item"/>
                    <include
                        android:id="@+id/cly_lower_version"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_marginRight="@dimen/dp_10"
                        android:layout_marginHorizontal="@dimen/dp_10"
                        app:layout_constraintTop_toBottomOf="@+id/layout_payment_event"
                        layout="@layout/parent_device_fragment_low_version"/>
                    <include
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_marginRight="@dimen/dp_10"
                        android:layout_marginHorizontal="@dimen/dp_10"
                        app:layout_constraintTop_toBottomOf="@+id/layout_payment_event"
                        layout="@layout/parent_device_fragment_not_support"/>
                    <com.flashget.kid.common.widget.WarnTipsView
                        android:id="@+id/wtv_net"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_16"
                        app:layout_constraintTop_toTopOf="parent"
                        app:warn_endIconMode="chevron"
                        app:warn_message="@string/NetworkError_CantLoadData_Toast"/>
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/group_android"
                        android:tag="binding_10"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:constraint_referenced_ids="layout_live_location,recycler_view"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.legacy.widget.Space
                    android:id="@+id/v_banner_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rlFeatureList"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <com.flashget.parentalcontrol.widget.MyFloatingActionButton
            android:id="@+id/fab_live_api_test"
            android:background="@color/mainColorPrimary"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_text_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="直播 API\10事件测试"/>
        </com.flashget.parentalcontrol.widget.MyFloatingActionButton>
    </RelativeLayout>
</com.scwang.smart.refresh.layout.SmartRefreshLayout>
