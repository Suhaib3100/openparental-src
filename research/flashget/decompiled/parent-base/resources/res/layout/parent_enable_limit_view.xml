<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/clLimits"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_enable"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:layout_marginTop="@dimen/dp_16"
                style="@style/ContentBodyStyle">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tvEnableLimit"
                    android:paddingTop="@dimen/dp_11"
                    android:paddingBottom="@dimen/dp_11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Parent_UsageLimit_Enable"
                    android:layout_marginStart="16dp"
                    android:paddingVertical="@dimen/dp_11"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <ToggleButton
                    android:id="@+id/tgEnableLimit"
                    android:background="@drawable/toggle_button"
                    android:layout_width="38dp"
                    android:layout_height="24dp"
                    android:checked="true"
                    android:textOn=""
                    android:textOff=""
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvEnableLimit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvEnableLimit"/>
                <com.flashget.kid.common.widget.WarnTipsView
                    android:id="@+id/wtv_permissions"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_8"
                    android:layout_marginRight="@dimen/dp_8"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvEnableLimit"
                    app:warn_endIconMode="chevron"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cly_recycler"
                android:tag="@string/ContentBodyStyle"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_20"
                style="@style/ContentBodyStyle">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tvEnableAlready"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_16"
                    android:text="@string/Parent_UsageLimit_Added"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <com.flashget.parentalcontrol.ui.component.SwipeRecylerView
                    android:id="@+id/rvEnableAlready"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:overScrollMode="never"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvEnableAlready"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/fl_btn"
        android:tag="@string/ContentBodyStyle"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ContentBodyStyle">
        <TextView
            android:ellipsize="end"
            android:id="@+id/btEnableLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Parent_UsageLimit_Add"
            android:maxLines="1"
            style="@style/ButtonStyle"/>
    </FrameLayout>
</LinearLayout>
