<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/parent_feedback_activity_0"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Common_feedback"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:errorDesc="@string/Feedback_Failed_Des"
        app:errorDrawableId="@drawable/pic_nonetwork"
        app:errorResId="@layout/data_error"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:startGravity="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:layout_weight="1"
                android:overScrollMode="never"
                app:layout_constrainedHeight="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center_horizontal"
                    android:tag="@string/ContentBodyStyle"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_20"
                    style="@style/ContentBodyStyle">
                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="tv_email_tips,tv_email_must,tv_email,etEmail"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/IssueType_Title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Center"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/c_f55e61"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_type"
                        app:layout_constraintStart_toEndOf="@+id/tv_type"
                        app:layout_constraintTop_toTopOf="@+id/tv_type"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:textColorHint="@color/color_text_tertiary"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tvProblemType"
                        android:background="@drawable/corners_rectangle_e9e8ec_12_w1"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginTop="@dimen/dp_8"
                        android:hint="@string/IssueType_OptionsDes"
                        android:maxLines="1"
                        android:drawablePadding="@dimen/dp_10"
                        android:drawableEnd="@drawable/icon_list_more_arrow"
                        android:paddingStart="12dp"
                        android:paddingEnd="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_type"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:textPassword="false"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/c_f55e61"
                        android:id="@+id/tvProblemTypeTips"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        app:layout_constraintEnd_toEndOf="@+id/tvProblemType"
                        app:layout_constraintStart_toStartOf="@+id/tvProblemType"
                        app:layout_constraintTop_toBottomOf="@+id/tvProblemType"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/Common_Description"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvProblemTypeTips"
                        style="@style/TextStyle.Center"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/c_f55e61"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_description"
                        app:layout_constraintStart_toEndOf="@+id/tv_description"
                        app:layout_constraintTop_toTopOf="@+id/tv_description"/>
                    <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:textColorHint="@color/color_text_tertiary"
                        android:id="@+id/etProblemDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:hint="@string/Common_Description_TextTips"
                        app:editPaddingVertical="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_description"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:maxChars="500"
                        app:minInputHeight="@dimen/dp_140"
                        app:showClearIcon="false"
                        app:textPassword="false"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/Parent_Email_Title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/etProblemDescription"
                        style="@style/TextStyle.Center"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/c_f55e61"
                        android:id="@+id/tv_email_must"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_email"
                        app:layout_constraintStart_toEndOf="@+id/tv_email"
                        app:layout_constraintTop_toTopOf="@+id/tv_email"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_email_tips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:text="@string/Feedback_Email_Tips"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_email"
                        style="@style/TextStyle.Start"/>
                    <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:textColorHint="@color/color_text_tertiary"
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:hint="@string/Profile_Feedback_Enter_Email"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_email_tips"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:regexRule="@string/email_input_regex_rule"
                        app:textPassword="false"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_pic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/Common_UploadImages"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/etEmail"
                        style="@style/TextStyle.Center"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:overScrollMode="never"
                        app:layout_constraintTop_toBottomOf="@+id/tv_pic"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:tag="@string/ContentBodyStyle"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_36"
                style="@style/ContentBodyStyle">
                <TextView
                    android:id="@+id/btn_submit"
                    android:visibility="gone"
                    android:text="@string/fb_btn_commit"
                    style="@style/ButtonStyle"/>
            </FrameLayout>
        </LinearLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
    <LinearLayout
        android:background="@color/color_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
