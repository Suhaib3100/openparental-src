<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <ImageView
        android:id="@+id/ivMarker"
        android:layout_width="24dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_timepoint_nor"
        android:scaleType="center"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivSameLocationMarker"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="28dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_overlapping"
        android:scaleType="center"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ivDivider"
        android:background="@color/color_border_1"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:src="@drawable/device_track_drivider_line"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivMarker"
        app:layout_constraintStart_toStartOf="@+id/ivMarker"
        app:layout_constraintTop_toBottomOf="@+id/ivMarker"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/tvTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivMarker"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvLocationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvTime"
        app:layout_constraintTop_toBottomOf="@+id/tvTime"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:ellipsize="end"
        android:id="@+id/tvLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/LocationRequestError_Des"
        android:maxLines="2"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvTime"
        app:layout_constraintTop_toBottomOf="@+id/tvLocationName"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/tvGeofence"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="14dp"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="@+id/tvTime"
        app:layout_constraintTop_toBottomOf="@+id/tvLocation"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:gravity="center_vertical"
        android:id="@+id/tvGeofenceName"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_30"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvGeofence"
        app:layout_constraintTop_toTopOf="@+id/tvGeofence"
        style="@style/TextStyle.Start"/>
</androidx.constraintlayout.widget.ConstraintLayout>
