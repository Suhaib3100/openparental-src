<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layoutAppbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="13dp"
            android:layout_alignParentStart="true"
            app:srcCompat="@drawable/nav_ic_back"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/dp_32"
        android:paddingBottom="@dimen/dp_24"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutAppbar"
        style="@style/ContentBodyStyle">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Common_iOSMDM_RequirePassword"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/lg_pwd_hint"
            style="@style/TextStyle.Start"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_tertiary"
            android:id="@+id/etPassword"
            android:background="@drawable/parent_password_edittext_selector_background"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/dp_12"
            android:hint="@string/Common_Password_InputPrompt"
            android:singleLine="true"
            android:maxLength="20"
            android:inputType="textPassword"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/Common_Acount_Verification_Password_Confirm"
            style="@style/TextStyle.Start"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_tertiary"
            android:id="@+id/etConfirmPassword"
            android:background="@drawable/parent_password_edittext_selector_background"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/dp_12"
            android:hint="@string/Common_Acount_Verification_Password_Confirm"
            android:singleLine="true"
            android:maxLength="20"
            android:inputType="textPassword"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_32"/>
        <TextView
            android:id="@+id/ivNext"
            android:text="@string/Common_Confirm"
            android:textDirection="locale"
            style="@style/ButtonStyle"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
