<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/kid_open_guide_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="@drawable/kid_open_guide_view"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ivExit"
                android:padding="11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:src="@drawable/btn_pop_close_dark_grey"
                android:layout_marginEnd="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glContentStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.08"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glContentEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.92"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_main_text"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/Download_Tab_Children"
                app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
                app:layout_constraintStart_toEndOf="@+id/glContentStart"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Center"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_main_text"
                android:id="@+id/tvDescription0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/KidsDevices_Install_Des0"
                app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
                app:layout_constraintStart_toEndOf="@+id/glContentStart"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_main_text"
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/KidsDevices_Install_Des"
                app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
                app:layout_constraintStart_toEndOf="@+id/glContentStart"
                app:layout_constraintTop_toBottomOf="@+id/tvDescription0"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/ivStep1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="@+id/glContentStart"
                app:layout_constraintTop_toBottomOf="@+id/tvDescription"
                app:srcCompat="@drawable/pic_bind_device_step_one"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tvStep1_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/KidsDevices_Install_Des1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
                app:layout_constraintStart_toEndOf="@+id/ivStep1"
                app:layout_constraintTop_toTopOf="@+id/ivStep1"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tvStep2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/KidsDevices_Install_Des2"
                app:layout_constraintEnd_toEndOf="@+id/tvStep1_1"
                app:layout_constraintStart_toStartOf="@+id/tvStep1_1"
                app:layout_constraintTop_toBottomOf="@+id/tvStep1_1"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/ivStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/ivStep1"
                app:layout_constraintStart_toStartOf="@+id/glContentStart"
                app:layout_constraintTop_toTopOf="@+id/tvStep2"
                app:srcCompat="@drawable/pic_bind_device_step_two"/>
            <ImageView
                android:id="@+id/ivDivider1"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toTopOf="@+id/ivStep2"
                app:layout_constraintEnd_toEndOf="@+id/ivStep1"
                app:layout_constraintStart_toStartOf="@+id/glContentStart"
                app:layout_constraintTop_toBottomOf="@+id/ivStep1"
                app:srcCompat="@drawable/device_track_drivider"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_text_white"
                android:id="@+id/tvInstall"
                android:background="@drawable/corners_rectangle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="36dp"
                android:text="@string/KidsDevices_Install_Button"
                android:textDirection="locale"
                android:textAlignment="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
                app:layout_constraintStart_toStartOf="@+id/glContentStart"
                app:layout_constraintTop_toBottomOf="@+id/ivStep2"
                style="?android:attr/borderlessButtonStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
