<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/location_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/lopTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:notifyVisible="true"
        app:title="@string/location_freq_option"
        app:titleColor="#404040"
        app:titleSize="16"/>
    <View
        android:id="@+id/divider1"
        android:background="#e4e4e4"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lopTitle"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/lopFeqOne"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider1"
        app:notifyVisible="true"
        app:title="@string/location_freq_1_hr"
        app:titleColor="#464F60"
        app:titleSize="14"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/lopFreqTwo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lopFeqOne"
        app:notifyVisible="true"
        app:title="@string/location_freq_2_hr"
        app:titleColor="#464F60"
        app:titleSize="14"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/lopFreqThree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lopFreqTwo"
        app:notifyVisible="true"
        app:title="@string/location_freq_3_hr"
        app:titleColor="#464F60"
        app:titleSize="14"/>
    <View
        android:id="@+id/divider2"
        android:background="#efefef"
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lopFreqThree"/>
    <com.flashget.parentalcontrol.ui.component.BottomSheetDialogOptionPreference
        android:id="@+id/lopCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        app:notifyVisible="true"
        app:title="@string/Common_Cancel"
        app:titleColor="#464F60"
        app:titleSize="14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
