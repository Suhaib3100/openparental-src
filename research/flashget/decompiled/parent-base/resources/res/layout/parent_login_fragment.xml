<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layoutAppbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="13dp"
            android:layout_alignParentStart="true"
            app:srcCompat="@drawable/nav_ic_back_black"/>
        <ImageView
            android:id="@+id/ivMenu"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="13dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_more"/>
        <ImageView
            android:id="@+id/ivService"
            android:padding="8dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:contentDescription="@string/Common_feedback"
            android:layout_marginEnd="13dp"
            android:layout_toStartOf="@+id/ivMenu"
            app:srcCompat="@drawable/icon_nav_customer_service"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutAppbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vg_content_body"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ContentBodyStyle">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="4dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="4dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Parent_Signin_Title"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Center"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tvSignInMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/SignInPage_ChooseMethod_Des"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                style="@style/TextStyle.Center"/>
            <View
                android:background="@color/color_border_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvSignInMethod"
                app:layout_constraintEnd_toStartOf="@+id/tvSignInMethod"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="@+id/tvSignInMethod"/>
            <View
                android:background="@color/color_border_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="15dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvSignInMethod"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toEndOf="@+id/tvSignInMethod"
                app:layout_constraintTop_toTopOf="@+id/tvSignInMethod"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llGoogle"
                android:background="@drawable/bg_parent_login_method_card_selector"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingVertical="@dimen/dp_20"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvSignInMethod">
                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/icon_login_google"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/SignInPage_SignInGoogle_Title"
                        android:includeFontPadding="false"
                        style="@style/TextStyle"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/SignInPage_SignInGoogle_Des"
                        android:includeFontPadding="false"
                        style="@style/TextStyle"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/icon_list_more_arrow"
                    android:contentDescription="@null"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llEmail"
                android:background="@drawable/bg_parent_login_method_card_selector"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingVertical="@dimen/dp_20"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/llGoogle">
                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/icon_login_email"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/SignInPage_SignInEmail_Title"
                        android:includeFontPadding="false"
                        style="@style/TextStyle"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/SignInPage_SignInEmail_Des"
                        android:includeFontPadding="false"
                        style="@style/TextStyle"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/icon_list_more_arrow"
                    android:contentDescription="@null"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tvOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/Or_Divider_Text"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llEmail"
                style="@style/TextStyle.Center"/>
            <View
                android:id="@+id/viewOr1"
                android:background="@color/color_border_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvOr"
                app:layout_constraintEnd_toStartOf="@+id/tvOr"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="@+id/tvOr"/>
            <View
                android:id="@+id/viewOr2"
                android:background="@color/color_border_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvOr"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toEndOf="@+id/tvOr"
                app:layout_constraintTop_toTopOf="@+id/tvOr"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tvGuestEntry"
                android:background="@drawable/bg_parent_signup_entry_email_card"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingVertical="@dimen/dp_20"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvOr">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/icon_login_guest"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ContinueAsGuest_Btn"
                        android:includeFontPadding="false"
                        style="@style/TextStyle"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/SignInPage_Guest_Des"
                        android:includeFontPadding="false"
                        style="@style/TextStyle"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/icon_list_more_arrow"
                    android:contentDescription="@null"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tvHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Parent_Signin_Subtitle1"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvGuestEntry"
                style="@style/TextStyle.Center"/>
            <com.flashget.kid.common.widget.WarnTipsView
                android:id="@+id/wtvNet"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHint"
                app:warn_endIconMode="chevron"
                app:warn_message="@string/NetworkError_CantSignIn_Toast"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
