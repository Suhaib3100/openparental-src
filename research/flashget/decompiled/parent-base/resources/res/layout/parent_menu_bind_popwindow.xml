<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_rectangle_white_20dp"
    android:paddingTop="@dimen/dp_4"
    android:paddingBottom="@dimen/dp_4"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/dp_260"
    android:elevation="@dimen/dp_10"
    android:paddingVertical="@dimen/dp_4"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/ivLanguage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvLanguageTitle"
        app:srcCompat="@drawable/ic_language"/>
    <ImageView
        android:id="@+id/ivFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFeedbackTitle"
        app:srcCompat="@drawable/ic_feedback"/>
    <ImageView
        android:id="@+id/ivAbout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintStart_toStartOf="@+id/ivLanguage"
        app:layout_constraintTop_toTopOf="@+id/tvAboutTitle"
        app:srcCompat="@drawable/ic_about"/>
    <ImageView
        android:id="@+id/ivLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintStart_toStartOf="@+id/ivAbout"
        app:layout_constraintTop_toTopOf="@+id/tvLogoutTitle"
        app:srcCompat="@drawable/ic_logout"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvLanguageTitle"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Common_Language"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:paddingEnd="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_10"
        app:layout_constraintStart_toEndOf="@+id/ivLanguage"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tvLanguageTitleClickView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvLanguageTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvLanguageTitle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvFeedbackTitle"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Common_feedback"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:paddingEnd="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_10"
        app:layout_constraintStart_toEndOf="@+id/ivFeedback"
        app:layout_constraintTop_toBottomOf="@+id/dividerLanguage"/>
    <View
        android:id="@+id/tvFeedbackTitleClickView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvFeedbackTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFeedbackTitle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvAboutTitle"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Parent_Setting_About"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:paddingEnd="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_10"
        app:layout_constraintStart_toEndOf="@+id/ivAbout"
        app:layout_constraintTop_toBottomOf="@+id/dividerFeedback"/>
    <View
        android:id="@+id/tvAboutTitleClickView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvAboutTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvAboutTitle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvLogoutTitle"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Profile_Logout_Title"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:paddingEnd="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_10"
        app:layout_constraintStart_toEndOf="@+id/ivLogout"
        app:layout_constraintTop_toBottomOf="@+id/dividerAbout"/>
    <View
        android:id="@+id/tvLogoutTitleClickView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvLogoutTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvLogoutTitle"/>
    <View
        android:id="@+id/dividerLanguage"
        android:background="@color/menu_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_4"
        android:layout_marginHorizontal="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLanguageTitle"/>
    <View
        android:id="@+id/dividerFeedback"
        android:background="@color/menu_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFeedbackTitle"/>
    <View
        android:id="@+id/dividerAbout"
        android:background="@color/menu_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAboutTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
