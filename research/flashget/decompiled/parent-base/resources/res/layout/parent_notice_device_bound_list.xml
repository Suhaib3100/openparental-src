<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_scrollable="false"
    app:bp_title="@string/Parent_Device_Select_Title">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="3dp"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/rvDeviceBoundList"
            android:background="@android:color/transparent"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:paddingVertical="12dp"/>
        <TextView
            android:id="@+id/tvDone"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_Complete"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            style="@style/ButtonStyle"/>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
