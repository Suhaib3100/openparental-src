<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/kid_open_guide_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="17dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="@drawable/kid_open_guide_view"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ivExit"
                android:padding="11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:src="@drawable/pop_ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glContentStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.08"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glContentEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.92"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_main_text"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:text="@string/Parent_Bind_Open_Kid_Title"
                app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
                app:layout_constraintStart_toEndOf="@+id/glContentStart"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <com.flashget.parentalcontrol.ui.component.KidOpenTutorial
                android:id="@+id/kotOpenUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:content="@string/Parent_Bind_Open_Kid_Step1_Subtitle1"
                app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/glContentStart"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:showOpenUrl="true"
                app:title="@string/Parent_Bind_Open_Kid_Step1_Title"/>
            <com.flashget.parentalcontrol.ui.component.KidOpenTutorial
                android:id="@+id/kotPhoneOpen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:content="@string/Parent_Bind_Open_Kid_Step2_Subtitle1"
                app:layout_constraintEnd_toStartOf="@+id/glContentEnd"
                app:layout_constraintStart_toEndOf="@+id/glContentStart"
                app:layout_constraintTop_toBottomOf="@+id/kotOpenUrl"
                app:showOpenUrl="true"
                app:title="@string/Parent_Bind_Open_Kid_Step2_Title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
