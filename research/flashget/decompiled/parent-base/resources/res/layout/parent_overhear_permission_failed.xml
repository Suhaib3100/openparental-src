<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_vds_connection_fail"
    android:tag="layout/parent_overhear_permission_failed_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_tip"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/webrtc_connection_img_top"
            android:src="@drawable/pic_blankpage_no_microphone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/overhear_permission_fail_title"
            android:layout_marginLeft="@dimen/failed_page_content_title_margin_horizontal"
            android:layout_marginTop="@dimen/failed_page_content_icon_and_title_space"
            android:layout_marginRight="@dimen/failed_page_content_title_margin_horizontal"
            android:text="@string/Parent_Device_Lisitening_No_Auth_Title"
            android:layout_marginHorizontal="@dimen/failed_page_content_title_margin_horizontal"
            app:layout_constraintTop_toBottomOf="@+id/img_tip"
            style="@style/FailPageContentTitleStyle"/>
        <TextView
            android:id="@+id/overhear_permission_fail_tip"
            android:layout_width="wrap_content"
            android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
            android:layout_marginTop="@dimen/failed_page_content_title_and_desc_space"
            android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
            android:text="@string/Parent_Device_Lisitening_No_Auth_Content"
            android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/overhear_permission_fail_title"
            style="@style/FailPageContentDescStyle"/>
        <TextView
            android:id="@+id/bt_overhear_permission_got_it"
            android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
            android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
            android:layout_marginBottom="@dimen/failed_page_padding_bottom"
            android:text="@string/Common_Got_It"
            android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/FailPageBtnStyle.Main"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
