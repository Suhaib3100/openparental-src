<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/barView"
        android:background="@color/color_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@color/color_primary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toBottomOf="@+id/barView"
        app:menu="@menu/parent_data_menu"
        app:navigationIcon="@drawable/nav_ic_back"
        app:title="@string/Parent_Permission_Check_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_white"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <View
            android:id="@+id/v_no_scroll"
            android:background="@drawable/primary_gradient_up2down"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/fl_no_scroll_layout"
            android:tag="@string/CardBodyStyle"
            android:paddingTop="@dimen/dp_12"
            android:layout_height="match_parent"
            android:layout_marginBottom="55dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CardBodyStyle">
            <include
                android:id="@+id/permissionCheckLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/permission_checking_layout"/>
            <include
                android:id="@+id/permissionSuccessLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/permission_success_layout"/>
            <include
                android:id="@+id/permissionTimeoutLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/permission_timeout_layout"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_failed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/view"
                    android:background="@drawable/primary_gradient_up2down"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center_horizontal"
                    android:tag="@string/CardBodyStyle"
                    android:paddingTop="@dimen/dp_12"
                    android:layout_height="match_parent"
                    style="@style/CardBodyStyle">
                    <include
                        android:id="@+id/permissionFailedLayout"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/permission_failed_layout"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/c_61000000"
                        android:id="@+id/tvAppName"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_app_name"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Center"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/c_61000000"
                        android:gravity="center"
                        android:id="@+id/tvCompany"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_copyright_info"
                        android:textDirection="ltr"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvAppName"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
