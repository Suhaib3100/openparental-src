<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:paddingTop="@dimen/dp_24"
    android:paddingBottom="@dimen/dp_24"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp_24">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/unverifiedGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvUnverified,ivUnverified"/>
    <ImageView
        android:id="@+id/ivProfile"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:src="@drawable/pic_avatar_defauil_signed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMyAccount"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingEnd="36dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivProfile"
        app:layout_constraintTop_toTopOf="@+id/ivProfile">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_text_primary"
            android:ellipsize="end"
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:textDirection="ltr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProfileName"
            style="@style/TextStyle.Start"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_text_white"
        android:gravity="center_vertical"
        android:id="@+id/tvUnverified"
        android:background="@drawable/corners_recetangle_246949c9_18"
        android:paddingTop="@dimen/dp_3"
        android:paddingBottom="@dimen/dp_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/Unverified_State"
        android:includeFontPadding="false"
        android:drawablePadding="2.5dp"
        android:drawableStart="@drawable/pic_email_unverified"
        android:paddingStart="10.5dp"
        android:paddingEnd="@dimen/dp_18"
        android:paddingVertical="@dimen/dp_3"
        app:layout_constraintStart_toStartOf="@+id/clMyAccount"
        app:layout_constraintTop_toBottomOf="@+id/clMyAccount"/>
    <ImageView
        android:id="@+id/ivUnverified"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/icon_list_more_arrow_white_mini"
        android:layout_marginStart="-18dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvUnverified"
        app:layout_constraintStart_toEndOf="@+id/tvUnverified"
        app:layout_constraintTop_toTopOf="@+id/tvUnverified"/>
    <ImageView
        android:id="@+id/ivRightArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_list_more_arrow_black"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/ivProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivProfile"/>
</androidx.constraintlayout.widget.ConstraintLayout>
