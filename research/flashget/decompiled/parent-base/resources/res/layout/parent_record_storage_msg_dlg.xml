<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/parent_bind_code_dlg_bg"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="30sp"
        android:layout_gravity="center"
        android:background="@drawable/pic_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/Parent_Device_Remote_Camera_Title"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/Parent_Device_Remote_Camera_Subtitle"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:breakStrategy="simple"
        style="@style/TextStyle.Start"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp">
        <ToggleButton
            android:id="@+id/tbNoShowWebRtcMsg"
            android:visibility="visible"
            android:layout_width="14dp"
            android:layout_height="18dp"
            android:checked="false"
            android:button="@drawable/radio_button_selector"
            android:layout_centerVertical="true"
            android:backgroundTint="@color/color_white"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_text_tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Parent_No_prompt"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/tbNoShowWebRtcMsg"
            style="@style/TextStyle.Start"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/gray_a4a8b3"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvCancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="75dp"
            android:text="@string/Common_Cancel"
            android:maxLines="1"
            android:paddingEnd="5dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/colorPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvOK"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="75dp"
            android:text="@string/Common_Continue"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:layout_toEndOf="@+id/tvCancel"/>
    </RelativeLayout>
</LinearLayout>
