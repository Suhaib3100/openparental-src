<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/parent_remote_operation_network_unavailable_0"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.parentalcontrol.widget.TopScrollView
        android:orientation="vertical"
        android:id="@+id/ll_network_unavailable_fail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_20"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/button_network_unavailable_retry"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.flashget.parentalcontrol.widget.SingleCountLottieAnimationView
                android:id="@+id/ivLinkUnable"
                android:tag="binding_1"
                android:layout_width="@dimen/failed_page_anim_width"
                android:layout_height="@dimen/failed_page_anim_height"
                android:layout_marginTop="@dimen/webrtc_connection_img_top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_autoPlay="true"
                app:lottie_fileName="pic_link_device_fail.json"
                app:lottie_loop="false"/>
            <TextView
                android:id="@+id/network_unavailable_title"
                android:layout_marginLeft="@dimen/failed_page_content_title_margin_horizontal"
                android:layout_marginTop="@dimen/failed_page_content_icon_and_title_space"
                android:layout_marginRight="@dimen/failed_page_content_title_margin_horizontal"
                android:text="@string/AirMirror_Connect_Server_Failed"
                android:layout_marginHorizontal="@dimen/failed_page_content_title_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ivLinkUnable"
                style="@style/FailPageContentTitleStyle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/network_unavailable_title_tip_step"
                android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
                android:layout_marginTop="@dimen/failed_page_content_title_and_desc_space"
                android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
                android:text="@string/AirMirror_Connect_Server_Failed_Resolution"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/network_unavailable_title"
                style="@style/FailPageContentDescStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.parentalcontrol.widget.TopScrollView>
    <TextView
        android:id="@+id/button_network_unavailable_retry"
        android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginBottom="@dimen/failed_page_btn_sapce"
        android:text="@string/Common_Retry_Title"
        android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/button_network_unavailable_switch_route"
        app:layout_goneMarginBottom="@dimen/failed_page_padding_bottom"
        style="@style/FailPageBtnStyle.Main"/>
    <TextView
        android:id="@+id/button_network_unavailable_switch_route"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginBottom="@dimen/dp_20"
        android:text="@string/Webrtc_SwitchLine_Button"
        android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/tv_contact_us"
        style="@style/FailPageBtnStyle.LightMain"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_contact_us"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8"
        android:text="@string/Common_ContactUs"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
