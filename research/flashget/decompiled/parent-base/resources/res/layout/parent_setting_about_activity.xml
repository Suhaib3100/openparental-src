<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Parent_Setting_About"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_10"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/vg_content_body"
            style="@style/ContentBodyStyle">
            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginBottom="14dp"
                app:layout_constraintBottom_toTopOf="@+id/tvAppName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/pic_about_me_logo"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="@string/parent_app_name"
                app:layout_constraintBottom_toTopOf="@+id/tvVersionName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/TextStyle.Center"/>
            <TextView
                android:id="@+id/tvVersionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.36"
                style="@style/TextStyle.Center"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llContent"
                android:background="@drawable/corners_rectangle_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvVersionName">
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/mpUpdate"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/au_check_update"
                    app:dividerMargin="14dp"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/mpHelp"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/rs_ar_not_support_tip_link"
                    app:dividerMargin="14dp"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/mpSendError"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/Common_SendErrorLogs_Button"
                    app:dividerMargin="14dp"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/mpTos"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/Common_TOS"
                    app:dividerMargin="14dp"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/mpPP"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/Common_PrivacyPolicy"
                    app:dividerMargin="14dp"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/mp_switch_server"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/SwitchServer_PopUp_Title"
                    app:dividerMargin="14dp"
                    app:showMoreDivider="false"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/gray_a4a8b3"
        android:gravity="center"
        android:id="@+id/tvAboutPolicy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:text="@string/Common_copyright_info"
        android:textDirection="ltr"/>
</LinearLayout>
