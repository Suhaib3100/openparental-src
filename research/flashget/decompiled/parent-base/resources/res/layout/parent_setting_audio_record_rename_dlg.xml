<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:orientation="vertical"
    android:background="@drawable/corners_rectangle_white_16dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvAudioRenameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/Parent_Setting_Records_Rename"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        style="@style/TextStyle.Center"/>
    <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
        android:textSize="14sp"
        android:id="@+id/etAudioRenameEdit"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint=""
        android:layout_below="@+id/tvAudioRenameTitle"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:maxChars="50"
        app:textPassword="false"/>
    <TextView
        android:id="@+id/tvAudioRenameOK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginRight="@dimen/dp_20"
        android:text="@string/common_save_btn"
        android:layout_below="@+id/etAudioRenameEdit"
        android:layout_marginHorizontal="@dimen/dp_20"
        style="@style/ButtonStyle"/>
    <TextView
        android:id="@+id/tvAudioRenameCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_24"
        android:text="@string/Common_Cancel"
        android:layout_below="@+id/tvAudioRenameOK"
        android:layout_marginHorizontal="@dimen/dp_20"
        style="@style/BorderButtonStyle"/>
</RelativeLayout>
