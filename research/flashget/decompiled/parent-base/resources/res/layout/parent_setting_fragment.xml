<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/barView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/pic_me_top_bg"
        android:layout_width="match_parent"
        android:layout_height="344dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_profile">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/vg_card_body"
            android:tag="@string/CardBodyStyle"
            style="@style/CardBodyStyle">
            <LinearLayout
                android:background="@drawable/parent_profile_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.flashget.parentalcontrol.ui.component.SubscribeItemPreference
                    android:id="@+id/itemSubscribe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_free_trial"
                    app:layout_constraintTop_toTopOf="parent"
                    app:mainText="@string/Payment_Sub_Will_Expire"
                    app:mode="twoLine"
                    app:subText="@string/Payment_Subscribe"
                    app:title="@string/Payment_Trial"/>
            </LinearLayout>
            <include
                android:id="@+id/profileMineLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                layout="@layout/profile_mine_layout"/>
            <include
                android:id="@+id/profileHelpLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                layout="@layout/profile_help_layout"/>
            <include
                android:id="@+id/profileOtherLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="@dimen/dp_10"
                layout="@layout/profile_other_layout"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:gravity="center_horizontal"
                android:id="@+id/tvLogout"
                android:background="@drawable/parent_profile_background"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/Profile_Logout_Title"/>
            <androidx.legacy.widget.Space
                android:id="@+id/v_banner_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/fl_profile"
        android:tag="@string/CardBodyStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barView"
        style="@style/CardBodyStyle">
        <include
            android:id="@+id/profileLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/parent_profile_item"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
