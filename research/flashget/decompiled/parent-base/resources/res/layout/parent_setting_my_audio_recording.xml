<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fl_search"
        android:tag="@string/ContentBodyStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbSingleSelect"
        style="@style/ContentBodyStyle">
        <include
            android:id="@+id/parentSearchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            layout="@layout/parent_search_bar_layout"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSingleList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llEmpty"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbSingleSelect">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ivEmptyIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pic_nonews"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/c_999999"
            android:gravity="center_horizontal"
            android:id="@+id/tvEmptyTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="@string/Common_No_Data"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
    <com.flashget.parentalcontrol.ui.component.ParentProfileToolbar
        android:id="@+id/tbSingleSelect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:rightIcon="@drawable/nav_ic_checkbox_black"
        app:title="@string/Parent_Setting_My_Recordings"
        app:toolbarMode="2"
        app:toolbarTextStyle="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
