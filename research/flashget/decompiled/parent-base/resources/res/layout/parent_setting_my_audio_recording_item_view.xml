<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlItemRoot"
    android:background="@drawable/corners_rectangle_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ToggleButton
        android:id="@+id/tbRecording"
        android:background="@drawable/parent_setting_audio_recording_multi_selector"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:checked="false"
        android:button="@drawable/parent_setting_audio_recording_multi_selector"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginStart="12dp"/>
    <ImageView
        android:id="@+id/ivRecording"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="12dp"
        app:srcCompat="@drawable/ic_recording_list"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tvFileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/parent_my_recording_item_title"
        android:maxLines="1"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="15dp"
        android:layout_toStartOf="@+id/tvCreateDate"
        android:layout_alignParentStart="true"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/c_a4a8b3"
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="22dp"
        android:text="12:22"
        android:layout_below="@+id/tvFileName"
        android:layout_marginStart="34dp"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/c_a4a8b3"
        android:id="@+id/tvCreateDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="2020年7月31日"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"
        style="@style/TextStyle.End"/>
    <ImageButton
        android:id="@+id/ibRecordingFeature"
        android:background="@android:color/transparent"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_recording_more"
        android:layout_below="@+id/tvCreateDate"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/divider1"
        android:background="@drawable/parent_setting_audio_record_multi_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/llSingleFeatures"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llSingleFeatures"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:weightSum="3"
        android:divider="@drawable/parent_setting_audio_record_multi_separator"
        android:layout_below="@+id/ibRecordingFeature"
        android:showDividers="middle"
        android:dividerPadding="10dp">
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/tvSingleRename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Setting_Records_Rename"
            android:drawableTop="@drawable/ic_recording_edit"
            android:layout_weight="1"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/tvSingleShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/common_share"
            android:drawableTop="@drawable/ic_recording_share"
            android:layout_weight="1"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/tvSingleDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Setting_Records_Delete"
            android:drawableTop="@drawable/ic_recording_delete"
            android:layout_weight="1"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
</RelativeLayout>
