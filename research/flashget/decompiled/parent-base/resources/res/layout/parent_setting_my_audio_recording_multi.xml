<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llEmpty"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbMultiSelect">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ivEmptyIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pic_nonews"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/c_999999"
            android:gravity="center_horizontal"
            android:id="@+id/tvEmptyTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:text="@string/Common_No_Data"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMultiList"
        android:tag="@string/ContentBodyStyle"
        android:background="@android:color/transparent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/llMultiFeature"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbMultiSelect"
        style="@style/ContentBodyStyle"/>
    <com.flashget.parentalcontrol.ui.component.ParentProfileToolbar
        android:id="@+id/tbMultiSelect"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:rightText="@string/Common_Cancel"
        app:title="@string/Parent_Setting_Records_Select_All"
        app:toolbarMode="3"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llMultiFeature"
        android:background="@color/color_bg_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:weightSum="2"
        android:divider="@drawable/parent_setting_audio_record_multi_separator"
        android:layout_weight="1"
        android:showDividers="middle"
        android:dividerPadding="10dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/tvMultiShare"
            android:paddingTop="11dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/common_share"
            android:drawableTop="@drawable/ic_recording_share"
            android:layout_weight="1"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/tvMultiDelete"
            android:paddingTop="11dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Setting_Records_Delete"
            android:drawableTop="@drawable/ic_recording_delete"
            android:layout_weight="1"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
