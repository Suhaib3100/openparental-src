<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/edit_child_dialog_bg"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/flAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:srcCompat="@drawable/device_ic_default"/>
        <ImageView
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:scaleType="matrix"
            android:rotation="180"
            app:srcCompat="@drawable/camera_setting_bg"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:srcCompat="@drawable/setting_ic_setavatar"/>
    </FrameLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/Parent_Tabbar_Device_Title"
        android:layout_below="@+id/flAvatar"
        android:layout_marginStart="20dp"
        style="@style/TextStyle.Start"/>
    <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
        android:textSize="14sp"
        android:textColor="@color/color_text_secondary"
        android:textColorHint="@color/gray_a4a8b3"
        android:id="@+id/etPhone"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/Parent_Device_Edit_Enter_Device"
        android:singleLine="true"
        android:layout_below="@+id/tvName"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/red_e13e3e"
        android:id="@+id/tvPhoneErrorTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Common_rename_empty"
        android:layout_below="@+id/etPhone"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/Parent_Device_Edit_Nickname"
        android:layout_below="@+id/tvPhoneErrorTitle"
        android:layout_marginStart="20dp"
        style="@style/TextStyle.Start"/>
    <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
        android:textSize="14sp"
        android:textColor="@color/color_text_secondary"
        android:textColorHint="@color/gray_a4a8b3"
        android:id="@+id/etNote"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:hint="@string/Parent_Device_Edit_Enter_Nickname"
        android:singleLine="true"
        android:layout_below="@+id/tvNote"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:maxChars="30"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/red_e13e3e"
        android:id="@+id/tvNoteErrorTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Account_Signup_Emoji_NotAllow"
        android:layout_below="@+id/etNote"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        style="@style/TextStyle"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/gray_a4a8b3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvClose"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:minWidth="74dp"
        android:text="@string/Common_Cancel"
        android:maxLines="1"
        android:layout_below="@+id/tvNoteErrorTitle"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/tvEnter"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvEnter"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:minWidth="74dp"
        android:text="@string/Common_Confirm"
        android:maxLines="1"
        android:layout_below="@+id/tvNoteErrorTitle"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        style="@style/TextStyle.Center"/>
</RelativeLayout>
