<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/parent_my_device_border_2"
    android:paddingLeft="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingRight="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    android:minHeight="@dimen/dp_80"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_12">
    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/pic_home_avatar_default_signed"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textDirection="locale"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toTopOf="@+id/tvPhone"
        app:layout_constraintEnd_toStartOf="@+id/ivEdit"
        app:layout_constraintStart_toEndOf="@+id/ivArrow"
        app:layout_constraintTop_toTopOf="@+id/ivArrow"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_text_secondary"
        android:ellipsize="end"
        android:id="@+id/tvPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/tvName"
        android:textDirection="locale"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivArrow"
        app:layout_constraintEnd_toStartOf="@+id/ivEdit"
        app:layout_constraintStart_toEndOf="@+id/ivArrow"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        style="@style/TextStyle.Start"/>
    <ImageView
        android:id="@+id/ivEdit"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivDelete"
        app:layout_constraintEnd_toStartOf="@+id/ivDivider"
        app:layout_constraintTop_toTopOf="@+id/ivDelete"
        app:srcCompat="@drawable/device_ic_edit"/>
    <View
        android:id="@+id/ivDivider"
        android:background="@color/gray_40979797"
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="9.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivDelete"
        app:layout_constraintEnd_toStartOf="@+id/ivDelete"
        app:layout_constraintTop_toTopOf="@+id/ivDelete"/>
    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivArrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivArrow"
        app:srcCompat="@drawable/device_ic_delete"/>
</androidx.constraintlayout.widget.ConstraintLayout>
