<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56">
        <ImageView
            android:id="@+id/ivMenu"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="13dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_more"/>
        <ImageView
            android:id="@+id/ivService"
            android:padding="8dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:contentDescription="@string/Common_feedback"
            android:layout_marginEnd="13dp"
            android:layout_toStartOf="@+id/ivMenu"
            app:srcCompat="@drawable/icon_nav_customer_service"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/vg_content_body"
        android:paddingTop="@dimen/dp_48"
        style="@style/ContentBodyStyle">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="4dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="4dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Signup_Title"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_text_tertiary"
            android:id="@+id/tvSignInWith"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/ChooseSignUpMethod_Title"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toEndOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/TextStyle.Center"/>
        <View
            android:background="@drawable/bg_parent_signup_entry_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvSignInWith"
            app:layout_constraintEnd_toStartOf="@+id/tvSignInWith"
            app:layout_constraintStart_toEndOf="@+id/glStart"
            app:layout_constraintTop_toTopOf="@+id/tvSignInWith"/>
        <View
            android:background="@drawable/bg_parent_signup_entry_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvSignInWith"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toEndOf="@+id/tvSignInWith"
            app:layout_constraintTop_toTopOf="@+id/tvSignInWith"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llGoogle"
            android:background="@drawable/bg_parent_login_method_card_selector"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingVertical="@dimen/dp_20"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toEndOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvSignInWith">
            <ImageView
                android:duplicateParentState="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_login_google"
                android:contentDescription="@null"
                android:layout_marginEnd="12dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/SignUpGoogle_Btn"
                    style="@style/TextStyle"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/FastestSignUpWay_Des"
                    style="@style/TextStyle"/>
            </LinearLayout>
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/icon_list_more_arrow"
                android:contentDescription="@null"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llEmailSignUp"
            android:background="@drawable/bg_parent_login_method_card_selector"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingVertical="20dp"
            app:layout_constraintEnd_toStartOf="@+id/glEnd"
            app:layout_constraintStart_toEndOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/llGoogle">
            <ImageView
                android:duplicateParentState="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_login_email"
                android:contentDescription="@null"
                android:layout_marginEnd="12dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/SignUpEmail_Btn"
                    style="@style/TextStyle"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/CreateAccountEmail_Des"
                    style="@style/TextStyle"/>
            </LinearLayout>
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/icon_list_more_arrow"
                android:contentDescription="@null"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/fl_btn"
        android:paddingTop="@dimen/dp_32"
        android:paddingBottom="@dimen/dp_24"
        style="@style/ContentBodyStyle">
        <com.flashget.kid.common.widget.WarnTipsView
            android:id="@+id/wtvNet"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            app:warn_endIconMode="chevron"
            app:warn_message="@string/NetworkError_CantSignUp_Toast"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <View
                android:background="@drawable/bg_parent_signup_entry_line"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_text_tertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Or_Divider_Text"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                style="@style/TextStyle.Center"/>
            <View
                android:background="@drawable/bg_parent_signup_entry_line"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_text_secondary"
            android:gravity="center"
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/AlreadyHaveAnAccount_Des"
            style="@style/TextStyle"/>
    </LinearLayout>
</LinearLayout>
