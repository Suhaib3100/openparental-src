<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingTop="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivBack"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/btn_pop_close"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_50"
            android:layout_marginRight="@dimen/dp_50"
            android:text="@string/Common_signup"
            android:layout_marginHorizontal="@dimen/dp_50"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Center"/>
        <ImageView
            android:id="@+id/ivMenu"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="13dp"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_more"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/tvNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivMenu">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/vg_content_body"
            android:tag="@string/ContentBodyStyle"
            android:paddingBottom="20dp"
            style="@style/ContentBodyStyle">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="0dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/gtEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="0dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/Parent_Email_Title"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toTopOf="@+id/etEmail"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/TextStyle.Start"/>
            <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_tertiary"
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:hint="@string/Profile_Feedback_EnterEmail"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toTopOf="@+id/tvPassword"
                app:layout_constraintEnd_toStartOf="@+id/gtEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvEmail"
                app:layout_constraintVertical_chainStyle="packed"
                app:regexRule="@string/email_input_regex_rule"
                app:textPassword="false"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/lg_pwd_hint"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toTopOf="@+id/etPassword"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/etEmail"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/TextStyle.Start"/>
            <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_tertiary"
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:hint="@string/Common_Password_InputPrompt"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/gtEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvPassword"
                app:layout_constraintVertical_chainStyle="packed"
                app:maxChars="48"
                app:newPassword="true"
                app:textPassword="true"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvPasswordConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/Common_Button_Confirm"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/etPassword"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/TextStyle.Start"/>
            <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_tertiary"
                android:id="@+id/etPasswordConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:hint="@string/ConfirmPassword_Input_Repeat"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/gtEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvPasswordConfirm"
                app:maxChars="48"
                app:textPassword="true"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvNickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/Parent_Device_Edit_Nickname"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/etPasswordConfirm"
                style="@style/TextStyle.Start"/>
            <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_tertiary"
                android:id="@+id/etNickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:hint="@string/Parent_Account_Input_Nickname"
                android:inputType="textPersonName"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/gtEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvNickname"
                app:textPassword="false"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tvPolicy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/parent_signup_policy"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:breakStrategy="simple"
                app:layout_constraintEnd_toStartOf="@+id/gtEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/etNickname"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/fl_btn"
        android:tag="@string/ContentBodyStyle"
        android:paddingTop="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_20"
        style="@style/ContentBodyStyle">
        <com.flashget.kid.common.widget.WarnTipsView
            android:id="@+id/wtv_net"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            app:warn_endIconMode="chevron"
            app:warn_message="@string/NetworkError_CantSignUp_Toast"/>
        <TextView
            android:id="@+id/tvNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_4"
            android:layout_marginRight="@dimen/dp_4"
            android:layout_marginBottom="16dp"
            android:text="@string/Common_signup"
            android:textDirection="locale"
            android:layout_marginHorizontal="@dimen/dp_4"
            style="@style/ButtonStyle"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_text_tertiary"
            android:id="@+id/tvHint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Parent_Signup_Subtitle1"
            style="@style/TextStyle"/>
    </LinearLayout>
</LinearLayout>
