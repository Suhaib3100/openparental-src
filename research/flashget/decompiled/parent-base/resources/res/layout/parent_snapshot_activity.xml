<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/parent_snapshot_activity_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/parent_snapshot_setting"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/ScreenSnapshot_Page_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:tag="@string/ContentBodyStyle"
            android:paddingBottom="20dp"
            android:layout_height="match_parent"
            style="@style/ContentBodyStyle">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llContent"
                android:background="@drawable/corners_rectangle_white"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_screen_snapshot_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ScreenSnapshot_Page_Title1"
                    android:layout_marginStart="16dp"
                    style="@style/TextStyle"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/tv_snapshot"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:title="@string/FeatureName_SnapshotNow"
                    app:dividerMargin="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:mp_subTitleSize="@dimen/sp_14"
                    app:photoIcon="@drawable/ic_immediate_snapshot"
                    app:showMoreDivider="false"
                    app:showMoreIcon="true"
                    app:titleColor="@color/color_text_primary"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/tv_snapshot_setting"
                    android:background="@drawable/kid_about_item_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/ScreenSnapshot_Page_Title1"
                    app:dividerMargin="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:mp_subTitleSize="@dimen/sp_14"
                    app:photoIcon="@drawable/ic_setting_snapshot"
                    app:showMoreDivider="false"
                    app:showMoreIcon="false"
                    app:titleColor="@color/color_text_primary"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llyCameraContent"
                android:background="@drawable/corners_rectangle_white"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llContent">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_camera_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/Home_Snapshot"
                    android:layout_marginStart="16dp"
                    style="@style/TextStyle"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/tv_camera_font"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:title="@string/Common_Camera_Front"
                    app:dividerMargin="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:mp_subTitleSize="@dimen/sp_14"
                    app:photoIcon="@drawable/ic_front_camera"
                    app:showMoreIcon="true"
                    app:titleColor="@color/color_text_primary"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/tv_camera_back"
                    android:background="@drawable/kid_about_item_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/Common_Camera_Back"
                    app:dividerMargin="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:mp_subTitleSize="@dimen/sp_14"
                    app:photoIcon="@drawable/ic_rear_camera"
                    app:showMoreDivider="false"
                    app:showMoreIcon="true"
                    app:titleColor="@color/color_text_primary"/>
                <com.flashget.kid.common.ui.base.MorePreferenceTri
                    android:id="@+id/tv_camera_setting"
                    android:background="@drawable/kid_about_item_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:title="@string/ScreenSnapshot_Page_Title1"
                    app:dividerMargin="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:mp_subTitleSize="@dimen/sp_14"
                    app:photoIcon="@drawable/ic_setting_snapshot"
                    app:showMoreDivider="false"
                    app:showMoreIcon="false"
                    app:titleColor="@color/color_text_primary"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_ScheduledSnapshot"
                android:background="@drawable/corners_rectangle_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llyCameraContent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_camera_timer_title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/Common_ScheduledSnapshot"
                        android:layout_marginStart="16dp"
                        style="@style/TextStyle"/>
                </LinearLayout>
                <com.flashget.kid.common.ui.base.views.MultiStateView
                    android:id="@+id/multi_snapshot_timing"
                    android:padding="0.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorResId="@layout/snap_config_error"
                    app:loadingResId="@layout/snap_config_loading">
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/dp_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_timed_snapshot"
                            android:paddingLeft="@dimen/dp_16"
                            android:paddingTop="@dimen/dp_14"
                            android:paddingRight="@dimen/dp_16"
                            android:paddingBottom="@dimen/dp_14"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:paddingHorizontal="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_14">
                            <ImageView
                                android:id="@+id/iv_timed_snapshot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_timed_snapshot"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <View
                                android:id="@+id/iv_snapshot_dot"
                                android:background="@drawable/dot_shape_unread_red"
                                android:visibility="gone"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="-6dp"
                                android:layout_marginEnd="-3dp"
                                app:layout_constraintEnd_toEndOf="@+id/iv_timed_snapshot"
                                app:layout_constraintTop_toTopOf="@+id/iv_timed_snapshot"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/color_text_primary"
                                android:ellipsize="end"
                                android:id="@+id/tv_timed_snapshot"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/Common_ScheduledRules"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_marginEnd="@dimen/dp_12"
                                android:layout_alignParentStart="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tv_timed_snapshot_summary"
                                app:layout_constraintHorizontal_chainStyle="spread_inside"
                                app:layout_constraintStart_toEndOf="@+id/iv_timed_snapshot"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextStyle.Start"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/color_text_secondary"
                                android:id="@+id/tv_timed_snapshot_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="@dimen/dp_130"
                                android:text="@string/KeyMapping_Message_Off"
                                android:maxLines="2"
                                android:drawableEnd="@drawable/icon_list_more_arrow"
                                android:layout_alignParentStart="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/tv_timed_snapshot"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_goneMarginStart="@dimen/dp_12"
                                style="@style/TextStyle.End"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <View
                            android:background="@color/color_border_2"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_1"
                            android:layout_marginLeft="@dimen/dp_16"
                            android:layout_marginRight="@dimen/dp_16"
                            android:layout_marginHorizontal="@dimen/dp_16"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_scheduled_logs"
                            android:paddingLeft="@dimen/dp_16"
                            android:paddingTop="@dimen/dp_14"
                            android:paddingRight="@dimen/dp_16"
                            android:paddingBottom="@dimen/dp_14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/dp_16"
                            android:paddingHorizontal="@dimen/dp_16"
                            android:paddingVertical="@dimen/dp_14">
                            <ImageView
                                android:id="@+id/iv_scheduled_logs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_task_log"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/color_text_primary"
                                android:ellipsize="end"
                                android:id="@+id/tv_scheduled_logs"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/Common_ScheduledLogs"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_alignParentStart="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tv_scheduled_logs_summary"
                                app:layout_constraintHorizontal_weight="1"
                                app:layout_constraintStart_toEndOf="@+id/iv_scheduled_logs"
                                app:layout_constraintTop_toTopOf="parent"
                                style="@style/TextStyle.Start"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/color_text_primary"
                                android:id="@+id/tv_scheduled_logs_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableEnd="@drawable/icon_list_more_arrow"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_alignParentStart="true"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_weight="1.2"
                                app:layout_constraintStart_toEndOf="@+id/tv_scheduled_logs"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_goneMarginStart="@dimen/dp_12"
                                style="@style/TextStyle.End"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_exception"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp_4"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    </LinearLayout>
                </com.flashget.kid.common.ui.base.views.MultiStateView>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/ll_snapshot_files"
                android:tag="binding_1"
                android:background="@drawable/corners_rectangle_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_ScheduledSnapshot">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_snapshot_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ScreenSnapshot_Page_Title2"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_primary"
                    android:id="@+id/tv_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/common_all_item"
                    app:layout_constraintBottom_toBottomOf="@+id/img_arrow"
                    app:layout_constraintEnd_toStartOf="@+id/img_arrow"
                    app:layout_constraintTop_toTopOf="@+id/img_arrow"/>
                <ImageView
                    android:id="@+id/img_arrow"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/icon_list_more_arrow_purple"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_snapshot_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_snapshot_title"/>
                <com.flashget.kid.common.ui.base.views.MultiStateView
                    android:id="@+id/multi_state_view"
                    android:background="@drawable/common_stroke_e8e6ec_ffffff_8"
                    android:padding="0.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginHorizontal="16dp"
                    app:emptyDrawableId="@drawable/pic_nonews"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_snapshot_title">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_content"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.flashget.kid.common.ui.base.views.MultiStateView
                            android:id="@+id/img_multi_state_view"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            app:emptyResId="@layout/default_img_error1"
                            app:errorResId="@layout/default_img_error"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:loadingResId="@layout/default_img_loading"
                            app:timeoutResId="@layout/default_img_timeout"
                            app:waitLoadingResId="@layout/default_img_wait_loading">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/cl"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <com.flashget.parentalcontrol.widget.NoScrollPhotoView
                                    android:id="@+id/img_snapshot"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                                <ImageView
                                    android:id="@+id/img_video"
                                    android:layout_width="@dimen/dp_48"
                                    android:layout_height="@dimen/dp_48"
                                    android:src="@drawable/icon_video_play"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_recording"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.flashget.kid.common.ui.base.views.MultiStateView>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_text_white"
                            android:gravity="center"
                            android:id="@+id/tv_time"
                            android:background="@drawable/common_90333137_bottom8"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="现在"
                            android:paddingVertical="6dp"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                        <eightbitlab.com.blurview.BlurView
                            android:id="@+id/blur_view"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.flashget.kid.common.ui.base.views.MultiStateView>
                <include
                    android:id="@+id/top"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:elevation="@dimen/dp_0"
                    app:layout_constraintBottom_toBottomOf="@+id/multi_state_view"
                    app:layout_constraintEnd_toEndOf="@+id/multi_state_view"
                    app:layout_constraintStart_toStartOf="@+id/multi_state_view"
                    app:layout_constraintTop_toTopOf="@+id/multi_state_view"
                    layout="@layout/item_trial_large"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_black_bottom"
        android:tag="@string/ContentBodyStyle"
        android:background="@drawable/bg_white_16"
        android:paddingBottom="@dimen/dp_20"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_20"
        android:elevation="@dimen/dp_10"
        android:layout_marginHorizontal="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ContentBodyStyle">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/c_161419"
            android:id="@+id/tv_black_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/CameraSnapshot_BlackImagesToast_Des"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_primary"
            android:gravity="center"
            android:id="@+id/btn_black_yes"
            android:background="@drawable/corners_rectangle_7e5ded_18_w1"
            android:padding="@dimen/dp_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/Common_Yes"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/btn_black_no"
            app:layout_constraintStart_toStartOf="@+id/tv_black_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_black_title"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_primary"
            android:gravity="center"
            android:id="@+id/btn_black_no"
            android:background="@drawable/corners_rectangle_7e5ded_18_w1"
            android:padding="@dimen/dp_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/Common_No"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="@+id/tv_black_title"
            app:layout_constraintStart_toEndOf="@+id/btn_black_yes"
            app:layout_constraintTop_toBottomOf="@+id/tv_black_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
