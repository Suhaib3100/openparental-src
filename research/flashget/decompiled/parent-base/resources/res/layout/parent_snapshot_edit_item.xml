<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/dp_8"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.flashget.kid.common.ui.base.views.MultiStateView
            android:id="@+id/multi_state_view"
            android:background="@drawable/corners_rectangle_white_8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:emptyResId="@layout/default_img_error_small1"
            app:errorResId="@layout/default_img_error_small1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:loadingResId="@layout/default_img_loading_small"
            app:timeoutResId="@layout/default_img_timeout_small"
            app:waitLoadingResId="@layout/default_img_wait_loading_small">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img_snapshot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"/>
                <ImageView
                    android:id="@+id/img_video"
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:src="@drawable/icon_video_play"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.4"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.flashget.kid.common.ui.base.views.MultiStateView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lly_bottom"
            android:background="@drawable/common_90333137_bottom8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_text_white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_nick_name"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="现在"
                android:singleLine="true"
                android:paddingVertical="3dp"/>
            <TextView
                android:textSize="@dimen/dp_10"
                android:textColor="@color/color_text_white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_time"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="现在"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginStart="@dimen/dp_2"
            app:layout_constraintStart_toStartOf="@+id/multi_state_view"
            app:layout_constraintTop_toTopOf="@+id/multi_state_view">
            <ImageView
                android:id="@+id/img_left"
                android:visibility="invisible"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_4"/>
            <ImageView
                android:id="@+id/img_sound"
                android:visibility="invisible"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/icon_subscript_no_sound"
                android:layout_marginStart="@dimen/dp_4"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_text_white"
                android:gravity="center"
                android:id="@+id/tv_violation"
                android:background="@drawable/corners_recetangle_ffa707_10"
                android:paddingLeft="@dimen/dp_9"
                android:paddingTop="@dimen/dp_2"
                android:paddingRight="@dimen/dp_9"
                android:paddingBottom="@dimen/dp_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"
                android:paddingHorizontal="@dimen/dp_9"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/img_dot"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="@+id/multi_state_view"
            app:layout_constraintTop_toTopOf="@+id/multi_state_view"
            style="@style/Dot_No_Border"/>
        <ImageView
            android:id="@+id/img_bg"
            android:background="@drawable/corners_rectangle_66000000_8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/img_selected"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:src="@drawable/parent_setting_audio_recording_multi_selector"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="@+id/multi_state_view"
            app:layout_constraintTop_toTopOf="@+id/multi_state_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
