<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/parent_snapshot_list_menu"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/ScreenSnapshot_Page_Title"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <com.flashget.parentalcontrol.ui.component.SwitchDayPreference
        android:layout_gravity="center_horizontal"
        android:id="@+id/snapshot_switch_day"
        android:tag="@string/ContentBodyStyle"
        android:background="@android:color/transparent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/ContentBodyStyle"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        app:emptyResId="@layout/parent_snapshot_list_activity_empty"
        app:loadingResId="@layout/parent_snapshot_list_activity_loading">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="@string/ContentBodyStyle"
            android:layout_height="match_parent"
            style="@style/ContentBodyStyle">
            <com.jcodecraeer.xrecyclerview.XRecyclerViewMulItem
                android:layout_gravity="center_horizontal"
                android:id="@+id/recyclerView"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:spanCount="3"/>
            <View
                android:id="@+id/view"
                android:layout_width="0dp"
                android:layout_height="0.1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top"/>
            <include
                android:id="@+id/top"
                android:background="@color/color_bg_1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/dp_0"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/item_trial_snapshot_header"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
</LinearLayout>
