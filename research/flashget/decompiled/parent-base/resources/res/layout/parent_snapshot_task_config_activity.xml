<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/parent_snapshot_task_config_activity_0"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/CommonAppTheme.FeedBackToolBarStyle"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/nav_ic_back_black"
        app:title="@string/Common_ScheduledRules"
        app:titleTextAppearance="@style/toolbar_style_bold"
        app:titleTextColor="@color/color_text_primary"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_20"
        app:layout_constraintBottom_toTopOf="@+id/fl_btn"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="@string/ContentBodyStyle"
            style="@style/ContentBodyStyle">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/corners_rectangle_white"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_ScheduledStatus"
                    style="@style/TextStyle.Start"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lly_camera"
                android:background="@drawable/corners_rectangle_white"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ad_permission_camera"
                    style="@style/TextStyle.Start"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_camera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/lly_recording_duration"
                android:background="@drawable/corners_rectangle_white"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_recording_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/CameraRecording_LengthOfEachRecording"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_record_time_title"
                    android:paddingTop="@dimen/dp_17"
                    android:paddingBottom="@dimen/dp_17"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Recording_Duration"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:paddingVertical="@dimen/dp_17"
                    app:layout_constraintEnd_toStartOf="@+id/tv_record_time"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_recording_duration"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_record_time"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:drawableEnd="@drawable/icon_list_more_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_record_time_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_record_time_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_timer_record"
                android:background="@drawable/corners_rectangle_white"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_FrequencyDaily"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_timer_record_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_start_time_title"
                        android:paddingTop="@dimen/dp_17"
                        android:paddingBottom="@dimen/dp_17"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Common_TimeRange"
                        android:layout_marginEnd="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_17"
                        app:layout_constraintEnd_toStartOf="@+id/tv_start_time"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_secondary"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_start_time"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:drawableEnd="@drawable/icon_list_more_arrow"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_start_time_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_start_time_title"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cly_upgrade"
                        android:background="@drawable/timer_config_upgrade"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/divider1">
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold"
                            android:textColor="@color/c_514089"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_upgrade"
                            android:tag="binding_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:drawablePadding="@dimen/dp_6"
                            android:drawableStart="@drawable/ic_free_trial"
                            android:layout_marginStart="@dimen/dp_12"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/c_514089"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_12"
                            android:layout_marginTop="@dimen/dp_9"
                            android:layout_marginRight="@dimen/dp_12"
                            android:layout_marginBottom="@dimen/dp_12"
                            android:text="@string/CameraRecording_TimeRange_UpgradeTips"
                            android:layout_marginHorizontal="@dimen/dp_12"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_upgrade"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_frequency_title"
                        android:paddingTop="@dimen/dp_19"
                        android:paddingBottom="@dimen/dp_19"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Calendars_Repeat"
                        android:layout_marginEnd="@dimen/dp_10"
                        android:paddingVertical="@dimen/dp_19"
                        app:layout_constraintEnd_toStartOf="@+id/tv_frequency"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cly_upgrade"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_secondary"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_frequency"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:drawableEnd="@drawable/icon_list_more_arrow"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_frequency_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_frequency_title"/>
                    <View
                        android:id="@+id/divider1"
                        android:background="@color/color_border_2"
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_1"
                        app:layout_constraintTop_toBottomOf="@+id/tv_start_time_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/fl_btn"
        android:tag="@string/ContentBodyStyle"
        android:layout_marginBottom="@dimen/dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ContentBodyStyle">
        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Common_ModifiedSettingsPopUp_Title"
            style="@style/ButtonStyle"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
