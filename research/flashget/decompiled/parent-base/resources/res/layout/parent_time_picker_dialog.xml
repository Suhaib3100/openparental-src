<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/parent_time_picker_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/LimitFeature_SetTime_Title">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bottom_white_24_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tv_complete"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_Confirm"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/h_picker"
            style="@style/ButtonStyle"/>
        <View
            android:background="@drawable/corners_rectangle_197e5ded_8"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/h_picker"
            app:layout_constraintTop_toTopOf="@+id/h_picker"/>
        <com.flashget.parentalcontrol.widget.wheel.WheelPicker
            android:id="@+id/h_picker"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_220"
            android:paddingStart="@dimen/dp_48"
            app:layout_constraintLeft_toRightOf="@+id/am_pm_picker"
            app:layout_constraintRight_toLeftOf="@+id/min_picker"
            app:layout_constraintTop_toTopOf="parent"
            app:wheel_selected_show_title="h"
            app:wheel_selected_title_margin="0dp"/>
        <com.flashget.parentalcontrol.widget.wheel.WheelPicker
            android:id="@+id/min_picker"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_220"
            android:paddingEnd="@dimen/dp_62"
            app:layout_constraintLeft_toRightOf="@+id/h_picker"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:wheel_selected_show_title="min"
            app:wheel_selected_title_margin="@dimen/dp_8"/>
        <com.flashget.parentalcontrol.widget.wheel.WheelPicker
            android:id="@+id/am_pm_picker"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_220"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/h_picker"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
