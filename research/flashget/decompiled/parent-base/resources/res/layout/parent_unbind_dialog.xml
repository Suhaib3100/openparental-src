<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_rectangle_white_top24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="ifContentScrolls">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/Parent_Authorization"
        android:layout_marginStart="@dimen/dp_52"
        android:layout_marginEnd="@dimen/dp_52"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Center"/>
    <ImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/dp_13"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_6"
        android:src="@drawable/ic_close"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/llMsg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/text_msg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="@dimen/dp_2"
                    style="@style/TextStyle.Start"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llTips"
                android:background="@drawable/parent_unbind_tips_bg"
                android:paddingTop="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llMsg">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_40">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/dp_30"
                        android:layout_height="@dimen/dp_30"
                        android:src="@drawable/icon_unbind_record"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Unbind_Instruction_Des1"
                        android:layout_weight="1"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:layout_marginStart="@dimen/dp_12"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
                <View
                    android:background="@drawable/parent_unbind_tips_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_40"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_40">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/dp_30"
                        android:layout_height="@dimen/dp_30"
                        android:src="@drawable/icon_unbind_set"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Unbind_Instruction_Des2"
                        android:layout_weight="1"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:layout_marginStart="@dimen/dp_12"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
                <View
                    android:background="@drawable/parent_unbind_tips_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_40"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_28">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/dp_30"
                        android:layout_height="@dimen/dp_30"
                        android:src="@drawable/icon_unbind_phone"
                        android:contentDescription="@null"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_Unbind_Instruction_Des3"
                        android:layout_weight="1"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:layout_marginStart="@dimen/dp_12"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
            </LinearLayout>
            <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                android:textSize="@dimen/sp_14"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/etPwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_22"
                android:layout_marginRight="@dimen/dp_20"
                android:text=""
                android:hint="@string/Common_Password_InputPrompt"
                android:inputType="textPassword"
                android:fontFamily="sans-serif"
                android:layout_marginHorizontal="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llTips"
                app:textPassword="true"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_primary"
                android:layout_gravity="end"
                android:id="@+id/tvForget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginRight="@dimen/dp_20"
                android:text="@string/ad_setting_account_change_pw_forget"
                android:layout_marginHorizontal="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="@+id/etPwd"
                app:layout_constraintTop_toBottomOf="@+id/etPwd"
                style="@style/TextStyle.End"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:id="@+id/tvOK"
        android:background="@drawable/corners_rectangle_ff6479_22"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_36"
        android:layout_marginRight="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_36"
        android:text="@string/Parent_Device_Unbind"
        android:textDirection="locale"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nsv"
        style="@style/ButtonStyle"/>
    <TextView
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tvCancel"
        android:background="@drawable/corners_rectangle_stroke_e8e6ec_22"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_24"
        android:text="@string/Common_Cancel"
        android:textDirection="locale"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvOK"
        style="@style/BorderButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
