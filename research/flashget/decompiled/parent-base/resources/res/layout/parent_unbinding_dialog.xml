<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/dialog_corners_rectangle"
    android:layout_width="@dimen/max_popup_width"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ivAlertImgNoTitleDlg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:src="@drawable/pic_pop_no_find_device"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/c_de000000"
                    android:gravity="center"
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="未检测到绑定设备"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="@style/TextStyle.Center"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/c_999999"
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="抱歉，未检测到您有新绑定的设备，请确认已在 FlashGet Kids 中填写正确的绑定码"
                    android:lineSpacingExtra="3sp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="@style/TextStyle.Start"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:id="@+id/llBtnPane"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:textColor="@color/ad_dlg_btn_text_cancel"
                    android:gravity="center"
                    android:id="@+id/tvCancel"
                    android:background="@drawable/ad_dlg_btn_color_bg"
                    android:focusable="true"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:text="@string/Common_Cancel"
                    android:textDirection="locale"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginEnd="3dp"
                    style="@style/ad_dlg_base_btn"/>
                <TextView
                    android:textColor="@color/color_primary"
                    android:gravity="center"
                    android:id="@+id/tvOK"
                    android:background="@drawable/ad_dlg_btn_color_bg"
                    android:focusable="true"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:text="@string/Common_Confirm"
                    android:textDirection="locale"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    style="@style/ad_dlg_base_btn"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
