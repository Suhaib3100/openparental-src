<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.kid.common.ui.base.views.BarView
        android:id="@+id/barView"
        android:background="@color/color_bg_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.flashget.parentalcontrol.ui.component.ParentProfileToolbar
        android:id="@+id/tbUsageTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/barView"
        app:rightIcon="@drawable/nav_ic_checkbox_black"
        app:title="@string/parent_usage_time_limit_title"
        app:toolbarBackgroundColor="@android:color/white"
        app:toolbarMode="1"
        app:toolbarTextStyle="1"/>
    <com.flashget.kid.common.ui.base.views.MultiStateView
        android:id="@+id/multi_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:errorDrawableId="@drawable/pic_nonetwork"
        app:errorResId="@layout/activity_keyword_app_manager_error"
        app:errorTitle="@string/Common_PageLoadingFailed_Des"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbUsageTime">
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fcvUsageTime"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.flashget.kid.common.ui.base.views.MultiStateView>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/cpLoading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
