<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glViewTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clEmpty"
        android:tag="@string/ContentBodyStyle"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/glViewTop"
        style="@style/ContentBodyStyle">
        <ImageView
            android:id="@+id/ivUsageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pic_application_time_limit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/btEmptyAddLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_62"
            android:layout_marginTop="@dimen/dp_43"
            android:layout_marginRight="@dimen/dp_62"
            android:text="@string/Parent_UsageLimit_Add"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/dp_62"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUsageTimeHint"
            style="@style/ButtonStyle"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:gravity="center"
            android:id="@+id/tvUsageTimeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/Parent_UsageLimit_App_Empty_Title"
            android:minLines="3"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivUsageTime"
            style="@style/TextStyle.Start"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/include"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/parent_enable_limit_view"/>
    <include
        android:id="@+id/appEmpty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/parent_data_empty"/>
    <include
        android:id="@+id/rlLoadingPanel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/default_loading"/>
</androidx.constraintlayout.widget.ConstraintLayout>
