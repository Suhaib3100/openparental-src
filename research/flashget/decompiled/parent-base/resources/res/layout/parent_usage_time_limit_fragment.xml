<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_bg_1"
    android:paddingBottom="20dp"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:tag="@string/ContentBodyStyle"
        android:layout_height="match_parent"
        style="@style/ContentBodyStyle">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cly_limit_name"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvLimitType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/Parent_UsageLimit_Type_Title"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <RadioGroup
                android:id="@+id/rgLimitType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:divider="@drawable/radio_group_divider"
                android:showDividers="middle"
                android:dividerPadding="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.flashget.parentalcontrol.ui.component.SubtitleRadioButton
                    android:gravity="top"
                    android:id="@+id/rbTimeLimit"
                    android:background="@color/ad_transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="12dp"
                    android:checked="true"
                    android:button="@drawable/select_app_box_style"
                    android:paddingStart="@dimen/dp_5"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="12dp"
                    app:subtitleText="@string/Parent_UsageLimit_ScreenTime_UsageTime"
                    app:subtitleTextAppearance="@style/ad_textAppearance_radio_subtitle"
                    app:titleText="@string/Parent_UsageLimit_Time_Title"
                    app:titleTextAppearance="@style/ad_textAppearance_radio_title"/>
                <com.flashget.parentalcontrol.ui.component.SubtitleRadioButton
                    android:gravity="top"
                    android:id="@+id/rbTimeSpanLimit"
                    android:background="@color/ad_transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="12dp"
                    android:button="@drawable/select_app_box_style"
                    android:paddingStart="@dimen/dp_5"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="12dp"
                    app:subtitleText="@string/Parent_UsageLimit_ScreenTime_Disable_Period"
                    app:subtitleTextAppearance="@style/ad_textAppearance_radio_subtitle"
                    app:titleText="@string/Parent_UsageLimit_Time_Period_Title"
                    app:titleTextAppearance="@style/ad_textAppearance_radio_title"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cly_limit_type"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:paddingBottom="@dimen/dp_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/cly_limit_name">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvLimitSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/Parent_UsageLimit_Settings_Title"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cly_limit_name"
                style="@style/TextStyle.Start"/>
            <com.flashget.parentalcontrol.ui.usagetime.component.UsageLimitTogglePreference
                android:id="@+id/tgUsageLimitPreference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLimitSettings"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clLimits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cly_limit_type">
            <com.flashget.parentalcontrol.ui.usagetime.component.TimeLimitRadioGroupPreference
                android:id="@+id/rgUsageLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clTimeSpanLimits"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="89dp"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgUsageLimit">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clLimitsStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/vDivider"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_UsageLimit_Start"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_tertiary"
                        android:id="@+id/tvLimitsStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:30"
                        android:layout_marginEnd="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivLimitStartArrow"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.End"/>
                    <ImageView
                        android:id="@+id/ivLimitStartArrow"
                        android:background="@drawable/icon_list_more_arrow"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/vDivider"
                    android:background="@color/color_border_2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clLimitsEnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vDivider">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_UsageLimit_End"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_tertiary"
                        android:id="@+id/tvLimitsEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18:30"
                        android:layout_marginEnd="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivLimitsEndArrow"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.End"/>
                    <ImageView
                        android:id="@+id/ivLimitsEndArrow"
                        android:background="@drawable/icon_list_more_arrow"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clAvailableTime"
                android:background="@drawable/corners_rectangle_white_16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:minHeight="44dp"
                android:paddingVertical="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgUsageLimit">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_primary"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvAvailableTimeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/Parent_UsageLimit_Time_Title"
                    android:maxLines="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="@dimen/dp_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvAvailableTime"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_tertiary"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvAvailableTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minWidth="80dp"
                    android:text="@string/Parent_UsageLimit_EveryDay_Custom_Period"
                    android:maxLines="1"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivLimitEndArrow"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.End"/>
                <ImageView
                    android:id="@+id/ivLimitEndArrow"
                    android:background="@drawable/icon_list_more_arrow"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clCategoryApps"
            android:background="@drawable/corners_rectangle_white_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clLimits">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tvCategoryAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/Parent_UsageLimit_Category_And_App"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAppLimits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCategoryAppsTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textStyle="normal"
            android:textColor="@color/color_danger_text"
            android:gravity="center"
            android:id="@+id/tvDeleteLimits"
            android:background="@drawable/corners_rectangle_white_24"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Parent_UsageLimit_Delete_Title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clCategoryApps"
            style="@style/ButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
