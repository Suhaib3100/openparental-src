<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/footer_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/color_border_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black_2d2f33"
        android:gravity="center"
        android:id="@+id/tvCamera"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Common_take_photos"
        android:textDirection="locale"
        style="@style/TextStyle.Center"/>
    <View
        android:background="@color/color_border_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black_2d2f33"
        android:gravity="center"
        android:id="@+id/tvImage"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/parent_my_device_select_photo"
        android:textDirection="locale"
        style="@style/TextStyle.Center"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:background="@color/gray_efefef"
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/black_2d2f33"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tvCancel"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:text="@string/Common_Cancel"
            android:textDirection="locale"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
</LinearLayout>
