<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:tag="@string/ContentBodyStyle"
    android:background="@color/color_bg_2"
    android:paddingTop="@dimen/dp_20"
    android:paddingBottom="24dp"
    android:layout_height="match_parent"
    style="@style/ContentBodyStyle">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Common_Email_Verification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvVerifyTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/Common_Email_Verification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tvVerifyContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/Common_Account_Verification_Des"
        android:textDirection="locale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVerifyTitle"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:id="@+id/tvCodeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/kid_limit_verify_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvModifyMail"/>
    <com.flashget.kid.common.widget.VerifyCodeInputView
        android:id="@+id/edVerifyCode"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCodeTitle"
        app:verifyCodeBoxBackgroundColor="@color/color_bg_2"
        app:verifyCodeBoxGap="8dp"
        app:verifyCodeBoxHeight="48dp"
        app:verifyCodeBoxRadius="12dp"
        app:verifyCodeBoxWidth="44dp"
        app:verifyCodeCursorColor="@color/color_primary"
        app:verifyCodeCursorHeight="24dp"
        app:verifyCodeCursorWidth="3dp"
        app:verifyCodeErrorStrokeColor="@color/color_danger"
        app:verifyCodeFocusedStrokeColor="@color/color_primary"
        app:verifyCodeLength="6"
        app:verifyCodeNormalStrokeColor="@color/color_fill_1"
        app:verifyCodeStrokeWidth="2dp"
        app:verifyCodeTextColor="@color/color_text_primary"
        app:verifyCodeTextSize="20sp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_danger"
        android:id="@+id/tvVerifyCodeError"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@+id/edVerifyCode"
        app:layout_constraintStart_toStartOf="@+id/edVerifyCode"
        app:layout_constraintTop_toBottomOf="@+id/edVerifyCode"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tvCountdown"
        android:background="@android:color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/transfer_chatitem_resend_action"
        app:layout_constraintEnd_toEndOf="@+id/edVerifyCode"
        app:layout_constraintStart_toStartOf="@+id/edVerifyCode"
        app:layout_constraintTop_toBottomOf="@+id/tvVerifyCodeError"
        style="@style/TextStyle.End"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/btVerify"
        android:background="@drawable/corners_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="20dp"
        android:text="@string/common_verify_login_btn"
        android:maxLines="1"
        android:textDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/tvWebActivate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCountdown"
        app:layout_constraintVertical_bias="1"
        style="@style/ButtonStyle"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_primary"
        android:id="@+id/tvModifyMail"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/Change_Email_Link_Message"
        android:textDirection="locale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVerifyContent"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_text_tertiary"
        android:id="@+id/tvWebActivate"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Account_Signup_NotReceivieCode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TextStyle.Center"/>
</androidx.constraintlayout.widget.ConstraintLayout>
