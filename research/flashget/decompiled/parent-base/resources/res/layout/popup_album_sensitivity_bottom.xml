<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/AlbumsSafety_DetectionSensitivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/bg_white_top_16"
        android:paddingBottom="@dimen/dp_36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@color/color_border_2"
        android:showDividers="middle">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/AlbumSafety_DetectionSensitivity_Des"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:id="@+id/btn_high"
            android:background="@drawable/corners_rectangle_147e5ded_12"
            android:paddingLeft="@dimen/dp_19"
            android:paddingTop="@dimen/dp_12"
            android:paddingRight="@dimen/dp_19"
            android:paddingBottom="@dimen/dp_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/AlbumSafety_DetectionSensitivity_Low"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:paddingHorizontal="@dimen/dp_19"
            android:paddingVertical="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:textColor="@color/color_text_white"
            android:background="@drawable/corners_rectangle_f95a6f_ff8a6d_12_bottom_0"
            android:paddingLeft="@dimen/dp_12"
            android:paddingTop="@dimen/dp_1"
            android:paddingRight="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PricingPage_Recommended"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_1"
            app:layout_constraintBottom_toTopOf="@+id/btn_high"
            app:layout_constraintEnd_toEndOf="@+id/btn_high"
            app:layout_constraintTop_toTopOf="@+id/btn_high"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:id="@+id/btn_medium"
            android:background="@drawable/corners_recetangle_ffffff_e8e6ec_12"
            android:paddingLeft="@dimen/dp_19"
            android:paddingTop="@dimen/dp_12"
            android:paddingRight="@dimen/dp_19"
            android:paddingBottom="@dimen/dp_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/AlbumSafety_DetectionSensitivity_Medium"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:paddingHorizontal="@dimen/dp_19"
            android:paddingVertical="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_high"
            style="@style/TextStyle.Start"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:id="@+id/btn_low"
            android:background="@drawable/corners_recetangle_ffffff_e8e6ec_12"
            android:paddingLeft="@dimen/dp_19"
            android:paddingTop="@dimen/dp_12"
            android:paddingRight="@dimen/dp_19"
            android:paddingBottom="@dimen/dp_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/AlbumSafety_DetectionSensitivity_High"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:paddingHorizontal="@dimen/dp_19"
            android:paddingVertical="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_medium"
            style="@style/TextStyle.Start"/>
        <TextView
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="48dp"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/Common_Button_Confirm"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintTop_toBottomOf="@+id/btn_low"
            style="@style/ButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
