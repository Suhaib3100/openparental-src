<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_alert_operate_url_0"
    android:background="@drawable/bottom_white_24_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_visit_url"
        android:tag="binding_1"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/BrowserSafety_AccessThisURL_Button"
        android:paddingVertical="@dimen/dp_14"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_add_white"
        android:tag="binding_2"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/BrowserSafety_URLWhitelist_AddTitle"
        android:paddingVertical="@dimen/dp_14"
        app:layout_constraintTop_toBottomOf="@+id/tv_visit_url"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_allow_today"
        android:tag="binding_3"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Parent_Device_Alert_Today_Available"
        android:paddingVertical="@dimen/dp_14"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_white"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_allow_half_hour"
        android:tag="binding_4"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_14"
        app:layout_constraintTop_toBottomOf="@+id/tv_allow_today"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_allow_quarter_hour"
        android:tag="binding_5"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_14"
        app:layout_constraintTop_toBottomOf="@+id/tv_allow_half_hour"/>
    <View
        android:id="@+id/divider"
        android:background="@color/color_border_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_6"
        app:layout_constraintTop_toBottomOf="@+id/tv_allow_quarter_hour"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:tag="binding_6"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Common_Cancel"
        android:paddingVertical="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
