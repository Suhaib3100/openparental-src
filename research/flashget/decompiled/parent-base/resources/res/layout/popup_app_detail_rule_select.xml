<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/Common_AppRules">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/cpLoading"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_40"
            android:indeterminate="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/rg_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toTopOf="parent">
            <RadioButton
                android:id="@+id/rb_allow"
                android:background="@drawable/app_rule_check_background_selector"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/Parent_Device_Alert_Allow"
                android:drawablePadding="8dp"
                android:drawableEnd="@drawable/app_rule_check_selector"/>
            <RadioButton
                android:id="@+id/rb_disable"
                android:background="@drawable/app_rule_check_background_selector"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/Common_Block"
                android:drawablePadding="8dp"
                android:drawableEnd="@drawable/app_rule_check_selector"/>
            <RadioButton
                android:id="@+id/rb_custom"
                android:background="@drawable/app_rule_check_background_selector"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/Setting_RadioButton_Default"
                android:drawablePadding="8dp"
                android:drawableEnd="@drawable/app_rule_check_selector"/>
        </RadioGroup>
        <TextView
            android:id="@+id/tv_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_Button_Confirm"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rg_rules"
            style="@style/ButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
