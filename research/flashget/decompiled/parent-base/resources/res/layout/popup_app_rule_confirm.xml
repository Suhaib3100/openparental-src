<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_app_rule_confirm_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_scrollable="false"
    app:bp_title="@string/AppRules_AddToAllowedApps_Title">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/allowed_apps_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/AppRules_AllowedApps_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/move_app_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/AppRules_MoveAppToOtherList_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/allowed_apps_desc"
                style="@style/TextStyle.Start"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:background="@drawable/corners_recetangle_f6f4fa_16"
                android:paddingTop="@dimen/dp_12"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:overScrollMode="never"
                app:layout_constraintBottom_toTopOf="@+id/tv_complete"
                app:layout_constraintTop_toBottomOf="@+id/move_app_desc"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_Button_Confirm"
            style="@style/ButtonStyle"/>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
