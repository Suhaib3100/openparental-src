<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_app_rule_switch_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/Parent_Device_Application_List_Title">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_all"
            android:tag="binding_1"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_applist_all"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Common_AllApps"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/iv_all"
                app:layout_constraintTop_toTopOf="@+id/iv_all"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_all_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/AppRules_AllApps_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_all"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_allow"
            android:tag="binding_2"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">
            <ImageView
                android:id="@+id/iv_allow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_applist_allow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Common_AllowedApps"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/iv_allow"
                app:layout_constraintTop_toTopOf="@+id/iv_allow"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/AppRules_AllowedApps_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_allow"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_disable"
            android:tag="binding_3"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">
            <ImageView
                android:id="@+id/iv_disable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_applist_disable"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Common_BlockedApps"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/iv_disable"
                app:layout_constraintTop_toTopOf="@+id/iv_disable"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/AppRules_BlockedApps_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_disable"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
