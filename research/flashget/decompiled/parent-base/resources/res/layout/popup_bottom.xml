<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_closeButtonVisible="false"
    app:bp_scrollable="false">
    <View
        android:background="@color/color_bg_1"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@color/color_bg_1"
        android:showDividers="middle">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/rv_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <View
            android:background="@color/color_border_2"
            android:layout_width="match_parent"
            android:layout_height="5dp"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/Common_Cancel"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
