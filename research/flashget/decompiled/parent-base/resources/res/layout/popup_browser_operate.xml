<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_browser_operate_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_btn_text="@string/Common_Button_Confirm"
    app:bp_btn_visible="true"
    app:bp_scrollable="false"
    app:bp_title="@string/KeyMapping_Column_Operate">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_operate_access"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tv_operate_access"
                android:tag="binding_2"
                android:paddingTop="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/BrowserSafety_AccessThisURL_Button"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_14"
                app:layout_constraintEnd_toStartOf="@+id/img_operate_access"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/img_operate_access"
                android:tag="binding_3"
                android:visibility="invisible"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/btn_list_select_pre"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_operate_white"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/cly_operate_access">
            <TextView
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tv_operate_white"
                android:tag="binding_5"
                android:paddingTop="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/BrowserSafety_URLWhitelist_AddTitle"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_14"
                app:layout_constraintEnd_toStartOf="@+id/img_operate_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/img_operate_white"
                android:tag="binding_6"
                android:visibility="invisible"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/btn_list_select_pre"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_operate_black"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/cly_operate_white">
            <TextView
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tv_operate_black"
                android:tag="binding_8"
                android:paddingTop="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/BrowserSafety_URLBlacklist_AddTitle"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_14"
                app:layout_constraintEnd_toStartOf="@+id/img_operate_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <ImageView
                android:id="@+id/img_operate_black"
                android:tag="binding_9"
                android:visibility="invisible"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/btn_list_select_pre"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
