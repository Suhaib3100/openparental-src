<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_camera_recording_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/Select_Recording_Time">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bottom_white_24_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.flashget.parentalcontrol.widget.wheel.WheelPicker
            android:id="@+id/min_picker"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_220"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:wheel_selected_title_margin="@dimen/dp_8"/>
        <View
            android:background="@drawable/corners_rectangle_197e5ded_8"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/min_picker"
            app:layout_constraintTop_toTopOf="@+id/min_picker"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Start_Recording"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/min_picker"
            style="@style/ButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
