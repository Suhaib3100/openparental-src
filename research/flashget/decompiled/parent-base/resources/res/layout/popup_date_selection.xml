<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_date_selection_0"
    android:background="@drawable/bottom_white_24_bg"
    android:paddingBottom="@dimen/dp_35"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_close"
        android:padding="@dimen/dp_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/btn_pop_close"
        android:layout_marginEnd="@dimen/dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/clMonth"
        android:background="@drawable/corners_rectangle_f4f3f7_20"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_36"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/exFivePreviousMonthImage"
            android:background="@drawable/corners_recetangle_e5dffb_20"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:src="@drawable/date_btn_left_purple"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_marginEnd="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_text_primary"
            android:id="@+id/exFiveMonthYearText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/exFiveNextMonthImage"
            app:layout_constraintStart_toEndOf="@+id/exFivePreviousMonthImage"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/exFiveNextMonthImage"
            android:background="@drawable/corners_recetangle_e5dffb_20"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:src="@drawable/date_btn_right_purple"
            android:scaleType="centerInside"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/legendLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/clMonth"
        layout="@layout/calendar_day_legend_container"/>
    <com.kizitonwose.calendar.view.CalendarView
        android:id="@+id/exOneCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:cv_daySize="seventhWidth"
        app:cv_dayViewResource="@layout/new_calendar_day"
        app:cv_outDateStyle="endOfGrid"
        app:layout_constraintTop_toBottomOf="@+id/legendLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
