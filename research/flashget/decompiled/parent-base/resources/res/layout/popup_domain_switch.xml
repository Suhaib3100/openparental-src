<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_desc="@string/SwitchServer_PopUp_Des"
    app:bp_descTextColor="@color/color_text_secondary"
    app:bp_desc_gravity="start"
    app:bp_scrollable="true"
    app:bp_title="@string/SwitchServer_PopUp_Title">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/dp_20"
        android:paddingRight="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_20">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tv_tips"
            android:background="@drawable/bg_tips"
            android:paddingLeft="@dimen/dp_10"
            android:paddingTop="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/SwitchServer_PopUp_Tips"
            android:drawablePadding="@dimen/dp_8"
            android:lineSpacingMultiplier="1.2"
            android:drawableStart="@drawable/ic_tips_purple"
            android:paddingHorizontal="@dimen/dp_10"
            android:paddingVertical="@dimen/dp_10"/>
        <RelativeLayout
            android:id="@+id/rl_server1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:minHeight="@dimen/dp_58">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_server1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/SwitchServer_ServerOption"
                android:maxLines="1"
                android:layout_centerVertical="true"
                style="@style/TextStyle.Start"/>
            <CheckBox
                android:layout_gravity="end"
                android:id="@+id/cb_server1"
                android:background="@drawable/check_box_selector"
                android:clickable="false"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:checked="true"
                android:button="@null"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/v_divider"
            android:background="@color/color_border_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <RelativeLayout
            android:id="@+id/rl_server2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_58">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_server2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/SwitchServer_ServerOption"
                android:maxLines="1"
                android:layout_centerVertical="true"
                style="@style/TextStyle.Start"/>
            <CheckBox
                android:layout_gravity="end"
                android:id="@+id/cb_server2"
                android:background="@drawable/check_box_selector"
                android:clickable="false"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:button="@null"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/tv_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Switch_Button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_tips"
            style="@style/ButtonStyle"/>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
