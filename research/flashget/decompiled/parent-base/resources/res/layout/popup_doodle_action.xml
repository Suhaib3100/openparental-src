<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_white_bottom_16"
    android:padding="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_narrow"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/icon_painting_brush_narrow"/>
        <SeekBar
            android:id="@+id/sb_size"
            android:paddingLeft="@dimen/dp_0"
            android:paddingRight="@dimen/dp_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_8"
            android:max="100"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_0"/>
        <ImageView
            android:id="@+id/iv_enlarge"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/icon_painting_brush_enlarge"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_4"
        android:layout_below="@+id/ll_size"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="9"/>
    <View
        android:id="@+id/v_sel_color"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="-2dp"
        android:layout_marginBottom="-2dp"
        android:layout_alignTop="@+id/rv_color"
        android:layout_alignBottom="@+id/rv_color"/>
</RelativeLayout>
