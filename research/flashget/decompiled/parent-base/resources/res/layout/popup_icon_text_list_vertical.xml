<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_white_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/header"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:includeFontPadding="false"
                app:lineHeight="22sp"
                style="@style/TextStyle.Center"/>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:scrollbarStyle="insideOverlay"
            android:id="@+id/body_scroll"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/body_content"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    app:lineHeight="20sp"
                    style="@style/TextStyle.Start"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_sub_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    app:lineHeight="20sp"
                    style="@style/TextStyle.Start"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/item_container"
                    android:background="@drawable/corners_rectangle_107e5ded_12"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/footer"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_confirm"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1"
                app:lineHeight="24sp"
                style="@style/ButtonStyle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_cancel"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="44dp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1"
                app:lineHeight="22sp"
                style="@style/BorderButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_close"
        android:padding="13dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/btn_pop_close"
        android:contentDescription="@string/Common_close"
        android:layout_marginEnd="1dp"/>
</FrameLayout>
