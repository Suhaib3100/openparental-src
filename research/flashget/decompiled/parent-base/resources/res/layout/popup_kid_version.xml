<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_kid_version_0"
    android:background="@drawable/bg_white_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">
            <ImageView
                android:id="@+id/iv_icon"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pic_pop_software_version_low"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/KidsForChild_VersionOld_Title"
                style="@style/TextStyle.Center"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10">
                <ImageView
                    android:id="@+id/img_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_version_arrow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/tv_old_version_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Setting_Lable_CurrentVersion"
                    android:layout_marginEnd="@dimen/dp_8"
                    app:layout_constraintEnd_toStartOf="@+id/img_version"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_old_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0.9"
                    app:layout_constraintEnd_toEndOf="@+id/tv_old_version_tip"
                    app:layout_constraintStart_toStartOf="@+id/tv_old_version_tip"
                    app:layout_constraintTop_toBottomOf="@+id/tv_old_version_tip"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/tv_new_version_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_CompatibleVersion"
                    android:layout_marginStart="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/img_version"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_new_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0.9"
                    app:layout_constraintEnd_toEndOf="@+id/tv_new_version_tips"
                    app:layout_constraintStart_toStartOf="@+id/tv_new_version_tips"
                    app:layout_constraintTop_toBottomOf="@+id/tv_new_version_tips"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cl_android_k_guid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/KidsForChild_VersionOld_Des"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_sub_des"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/Parent_Bind_Step2_Subtitle1"
                    style="@style/TextStyle.Start"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_extra"
                    android:background="@drawable/common_f4f2f8_18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_primary"
                        android:id="@+id/tv_extra"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="test-www.flashget.kids/openkids/538010458"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginVertical="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/img_extra"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/img_extra"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_share"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cly_warning"
                    android:background="@drawable/bg_fef1e4_feead8_12"
                    android:paddingLeft="@dimen/dp_12"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingRight="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_12">
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_warn"
                        android:id="@+id/iv_warning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/dp_4"
                        android:drawableStart="@drawable/icon_warn_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_warn_tips1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/ParentApp_UpgradeChildApp_Tips1"
                        app:layout_constraintTop_toBottomOf="@+id/iv_warning"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/ParentApp_UpgradeChildApp_Tips2"
                        app:layout_constraintTop_toBottomOf="@+id/tv_warn_tips1"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cl_ios_k_guid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10">
                <com.flashget.kid.common.widget.DashView
                    android:id="@+id/dv_ios_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_2"
                    app:dashColor="@color/color_border_1"
                    app:dashGap="4dp"
                    app:dashLength="4dp"
                    app:dashThickness="1dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_text_secondary"
                    android:id="@+id/tv_ios_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/Kidsafe_UpgradeOldVersion_Des"
                    style="@style/TextStyle.Start"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_ios_step"
                    android:background="@drawable/bg_tips"
                    android:paddingLeft="@dimen/dp_12"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:paddingHorizontal="@dimen/dp_12">
                    <com.flashget.kid.common.widget.DashView
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/dp_2"
                        android:layout_marginBottom="@dimen/dp_2"
                        android:layout_marginVertical="@dimen/dp_2"
                        app:dashCap="round"
                        app:dashColor="@color/color_text_disabled"
                        app:dashFitMode="even"
                        app:dashGap="3dp"
                        app:dashLength="3dp"
                        app:dashOrientation="vertical"
                        app:dashThickness="1.5dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_ios_step_2_num"
                        app:layout_constraintEnd_toEndOf="@+id/tv_ios_step_1_num"
                        app:layout_constraintStart_toStartOf="@+id/tv_ios_step_1_num"
                        app:layout_constraintTop_toBottomOf="@+id/tv_ios_step_1_num"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_white"
                        android:gravity="center"
                        android:id="@+id/tv_ios_step_1_num"
                        android:background="@drawable/bg_ios_step_number"
                        android:layout_width="@dimen/dp_15"
                        android:layout_height="@dimen/dp_15"
                        android:layout_marginTop="@dimen/dp_1_5"
                        android:text="1"
                        android:includeFontPadding="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_ios_step_1_desc"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_ios_step_1_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/dp_18"
                        android:text="@string/Kidsafe_UpgradeOldVersion_Step1"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_ios_step_1_num"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TextStyle.Start"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_text_white"
                        android:gravity="center"
                        android:id="@+id/tv_ios_step_2_num"
                        android:background="@drawable/bg_ios_step_number"
                        android:layout_width="@dimen/dp_15"
                        android:layout_height="@dimen/dp_15"
                        android:layout_marginTop="@dimen/dp_1_5"
                        android:text="2"
                        android:includeFontPadding="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_ios_step_2_desc"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/color_text_secondary"
                        android:id="@+id/tv_ios_step_2_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:minHeight="@dimen/dp_18"
                        android:text="@string/Kidsafe_UpgradeOldVersion_Step2"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_ios_step_2_num"
                        app:layout_constraintTop_toBottomOf="@+id/tv_ios_step_1_desc"
                        style="@style/TextStyle.Start"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">
                <TextView
                    android:id="@+id/btn_cancel"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/Common_ContactUs"
                    app:layout_constraintEnd_toEndOf="@+id/btn_confirm"
                    app:layout_constraintStart_toStartOf="@+id/btn_confirm"
                    app:layout_constraintTop_toBottomOf="@+id/btn_confirm"
                    style="@style/BorderButtonStyle"/>
                <TextView
                    android:id="@+id/btn_confirm"
                    android:text="@string/GuideWarning_BuyVIP_Button2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginStart="0dp"
                    style="@style/ButtonStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="8dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/btn_pop_close"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
