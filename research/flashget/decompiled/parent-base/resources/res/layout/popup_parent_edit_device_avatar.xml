<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_parent_edit_device_avatar_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_closeButtonVisible="false"
    app:bp_title="@string/Common_Avatar">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:id="@+id/tvCamera"
            android:tag="binding_1"
            android:paddingTop="@dimen/dp_14"
            android:paddingBottom="@dimen/dp_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Common_take_photos"
            android:textDirection="locale"
            android:paddingVertical="@dimen/dp_14"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:id="@+id/tvImage"
            android:tag="binding_2"
            android:paddingTop="@dimen/dp_14"
            android:paddingBottom="@dimen/dp_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/parent_my_device_select_photo"
            android:textDirection="locale"
            android:paddingVertical="@dimen/dp_14"
            style="@style/TextStyle.Center"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="@color/color_border_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_6"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/tvCancel"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="16dp"
                android:text="@string/Common_Cancel"
                android:textDirection="locale"
                style="@style/TextStyle.Center"/>
        </LinearLayout>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
