<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_parent_edit_intercept_mode_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/BrowserSafety_BlockingMode_Title">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_intercept_black"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toTopOf="@+id/cly_allow_white">
            <TextView
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tv_intercept_black"
                android:tag="binding_2"
                android:paddingTop="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/BlockingMode_Option_BlockBlacklist"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_14"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Center"/>
            <ImageView
                android:id="@+id/img_intercept_black"
                android:tag="binding_3"
                android:visibility="gone"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/btn_list_select_pre"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_allow_white"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_30"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toTopOf="@+id/tv_complete">
            <TextView
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tv_allow_white"
                android:tag="binding_5"
                android:paddingTop="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/BlockingMode_Option_OnlyAllowWhitelist"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_14"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Center"/>
            <ImageView
                android:id="@+id/img_allow_white"
                android:tag="binding_6"
                android:visibility="gone"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/btn_list_select_pre"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_complete"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_Complete"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/ButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
