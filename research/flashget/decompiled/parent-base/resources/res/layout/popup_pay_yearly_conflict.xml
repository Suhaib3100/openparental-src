<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_white_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="24dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:src="@drawable/pic_pop_confirm_buy"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Common_ConfirmPlan"
            style="@style/TextStyle.Center"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/Payment_DowngradeWarning_Desc"
            style="@style/TextStyle.Start"/>
        <View
            android:background="@color/color_border_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_12"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:layout_gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/DownloadPrompt_Title"
            style="@style/TextStyle.Start"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">
            <TextView
                android:id="@+id/btnYear"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/PurchaseYearlySubscription_Button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="0dp"
                style="@style/ButtonStyle"/>
            <TextView
                android:id="@+id/btnNext"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/ContinueToPurchase_Button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnYear"
                style="@style/BorderButtonStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="8dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/btn_pop_close"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
