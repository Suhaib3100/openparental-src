<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_phone_mode_switch_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/Parent_CallBlockMode_Title">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_no"
            android:tag="binding_1"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_phone_no_control"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/c_161419"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CallSafety_Mode_DonotBlack_Title"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/iv_no"
                app:layout_constraintTop_toTopOf="@+id/iv_no"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_black"
            android:tag="binding_2"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">
            <ImageView
                android:id="@+id/iv_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_phone_intercept_blacklist"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/c_161419"
                android:id="@+id/tv_black_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CallSafety_Mode_BlockBlacklist_Title"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/iv_black"
                app:layout_constraintTop_toTopOf="@+id/iv_black"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/CallSafety_Mode_BlockBlacklist_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_black_title"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_unknown"
            android:tag="binding_3"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">
            <ImageView
                android:id="@+id/iv_unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_phone_intercept_unknown"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/c_161419"
                android:id="@+id/tv_unknown_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CallSafety_Mode_BlockUnknownNumbers_Title"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/iv_unknown"
                app:layout_constraintTop_toTopOf="@+id/iv_unknown"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/CallSafety_Mode_BlockUnknownNumbers_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_unknown_title"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_black_unknown"
            android:tag="binding_4"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">
            <ImageView
                android:id="@+id/iv_black_unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_phone_intercept_all"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/c_161419"
                android:id="@+id/tv_black_unknown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CallSafety_Mode_BlockBlacklistAndUnknownNumbers_Title"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/iv_black_unknown"
                app:layout_constraintTop_toTopOf="@+id/iv_black_unknown"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/CallSafety_Mode_BlockBlacklistAndUnknownNumbers_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_black_unknown"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_white"
            android:tag="binding_5"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">
            <ImageView
                android:id="@+id/iv_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_phone_allow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/c_161419"
                android:id="@+id/tv_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CallSafety_Mode_OnlyAllowWhitelist_Title"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintStart_toEndOf="@+id/iv_white"
                app:layout_constraintTop_toTopOf="@+id/iv_white"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/CallSafety_Mode_OnlyAllowWhitelist_Des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_white"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:enabled="false"
            android:id="@+id/btn_submit"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_36"
            android:text="@string/Common_Complete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvPic"
            style="@style/ButtonStyle"/>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
