                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_kid_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_40"
                android:text="@string/Common_ChildAppSettings"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_parent_load_all"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_tertiary"
                android:id="@+id/tv_kid_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/AlbumsSafety_SettingsDes"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/tv_kid_title"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_kid_second_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/Common_AutoUpload"
                app:layout_constraintStart_toStartOf="@+id/tv_kid_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_kid_tips"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_kid_upload_wifi"
                android:tag="binding_3"
                android:background="@drawable/btn_selected"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_12"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/UploadMethod_WiFiOnly"
                android:drawableEnd="@drawable/parent_setting_audio_recording_multi_selector"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/tv_kid_second_title"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_kid_upload_all"
                android:tag="binding_4"
                android:background="@drawable/btn_selected"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_12"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/Common_WIFiAndMobileData"
                android:drawableEnd="@drawable/parent_setting_audio_recording_multi_selector"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/tv_kid_upload_wifi"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_tips"
                android:background="@drawable/corners_rectangle_7993ff_9e81ff_10"
                android:paddingLeft="@dimen/dp_12"
                android:paddingTop="@dimen/dp_8"
                android:paddingRight="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/AlbumsSafety_MobileDataUploadTip"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_8"
                app:layout_constraintTop_toBottomOf="@+id/tv_kid_upload_all"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_white"
                android:gravity="center"
                android:id="@+id/tv_save_trans_setting"
                android:tag="binding_5"
                android:background="@drawable/corners_rectangle"
                android:paddingTop="@dimen/dp_7"
                android:paddingBottom="@dimen/dp_7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_48"
                android:layout_marginRight="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_36"
                android:text="@string/Common_ModifiedSettingsPopUp_Title"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:paddingVertical="@dimen/dp_7"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_tips"
                app:layout_goneMarginStart="0dp"
                style="@style/TextStyle.Center"/>
            <View
                android:background="@color/color_primary_7f"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_5"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintStart_toStartOf="@+id/tv_parent_title"
                app:layout_constraintTop_toTopOf="@+id/tv_parent_title"/>
            <View
                android:background="@color/color_primary_7f"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_5"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintStart_toStartOf="@+id/tv_kid_title"
                app:layout_constraintTop_toTopOf="@+id/tv_kid_title"/>
