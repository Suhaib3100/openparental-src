<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_photo_setting_0"
    android:background="@drawable/corners_rectangle_white_top_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/Common_DataTransferSettings_Title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_parent_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/Common_ParentAppSettings"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_parent_second_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/Common_AutoDownload"
                app:layout_constraintStart_toStartOf="@+id/tv_parent_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_parent_title"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_parent_load_wifi"
                android:tag="binding_1"
                android:background="@drawable/btn_selected"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_12"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/UploadMethod_WiFiOnly"
                android:drawableEnd="@drawable/parent_setting_audio_recording_multi_selector"
