<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_report_need_ai_kid_info_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_scrollable="false"
    app:bp_title="@string/ConfirmChildInfo_PopUp_Title">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/ConfirmChildInfo_PopUp_Des"
            android:layout_marginHorizontal="@dimen/dp_20"
            style="@style/TextStyle.Start"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginHorizontal="@dimen/dp_20">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_age_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_28"
                android:text="@string/Age_Title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:gravity="center_vertical"
                android:id="@+id/tv_age"
                android:background="@drawable/corners_rectangle_e9e8ec_12_w1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/dp_12"
                android:text="6"
                android:drawableEnd="@drawable/icon_list_arrow_down"
                android:paddingStart="12dp"
                android:paddingEnd="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/tv_age_title"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_male_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/Gender_Title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_age"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_male"
                android:background="@drawable/sex_selector1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_8"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_44"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/Common_Boy"
                android:drawablePadding="@dimen/dp_6"
                android:drawableStart="@drawable/icon_sex_male"
                android:layout_marginEnd="@dimen/dp_20"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_8"
                app:layout_constraintEnd_toStartOf="@+id/tv_female"
                app:layout_constraintStart_toStartOf="@+id/tv_male_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_male_title"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_female"
                android:background="@drawable/sex_selector1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_8"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_44"
                android:text="@string/Common_Girl"
                android:drawablePadding="@dimen/dp_6"
                android:drawableStart="@drawable/icon_sex_female"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/tv_male"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_male"
                app:layout_constraintTop_toTopOf="@+id/tv_male"
                style="@style/TextStyle.Start"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/tv_complete"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_59"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_Button_Confirm"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintTop_toBottomOf="@+id/cl_info"
            style="@style/ButtonStyle"/>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
