<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_report_need_ai_medal_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_scrollable="false"
    app:bp_title="@string/EnableAIAnalysis_Title">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv"
            android:paddingBottom="@dimen/dp_20"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginRight="@dimen/dp_20"
                    android:layout_marginHorizontal="@dimen/dp_20">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_report_smart_analysis"/>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/EnableAIAnalysis_Detail_Title1"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_9"
                    android:layout_marginRight="@dimen/dp_20"
                    android:text="@string/EnableAIAnalysis_Detail_Des1"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    style="@style/TextStyle.Start"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginRight="@dimen/dp_20"
                    android:layout_marginHorizontal="@dimen/dp_20">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_report_risk_scan"/>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/EnableAIAnalysis_Detail_Title2"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_9"
                    android:layout_marginRight="@dimen/dp_20"
                    android:text="@string/EnableAIAnalysis_Detail_Des2"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    style="@style/TextStyle.Start"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginRight="@dimen/dp_20"
                    android:layout_marginHorizontal="@dimen/dp_20">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_report_parent_guide"/>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/EnableAIAnalysis_Detail_Title3"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        style="@style/TextStyle.Start"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/color_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginTop="@dimen/dp_9"
                    android:layout_marginRight="@dimen/dp_20"
                    android:text="@string/EnableAIAnalysis_Detail_Des3"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    style="@style/TextStyle.Start"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_bottom"
            android:paddingLeft="@dimen/dp_20"
            android:paddingRight="@dimen/dp_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:paddingHorizontal="@dimen/dp_20"
            app:layout_constraintTop_toBottomOf="@+id/nsv">
            <ImageView
                android:id="@+id/img_selected"
                android:padding="@dimen/dp_3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/check_box_selector"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tvOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ReadAndAgree_Terms_Options"
                android:layout_marginStart="@dimen/dp_4"/>
        </LinearLayout>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/tv_complete"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_EnableNow"
            android:layout_marginHorizontal="@dimen/dp_20"
            app:layout_constraintTop_toBottomOf="@+id/ll_bottom"
            style="@style/ButtonStyle"/>
    </LinearLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
