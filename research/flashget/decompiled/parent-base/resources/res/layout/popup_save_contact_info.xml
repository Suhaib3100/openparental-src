<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_save_contact_info_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/CallAndSMSSafety_EditContactInformation">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CallLogs_PhoneNumber"
                style="@style/TextStyle.Start"/>
            <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_tertiary"
                android:id="@+id/etPhone"
                android:background="@drawable/corners_rectangle_f4f3f7_e9e8ec_12_w1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                app:textPassword="false"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/Common_remark_title"
                style="@style/TextStyle.Start"/>
            <com.flashget.parentalcontrol.ui.base.NewCleanableEditText
                android:textSize="14sp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_tertiary"
                android:id="@+id/etRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:hint="@string/GuideMirror_Send_Message_UpdataRemarkPlaceHolder"
                app:textPassword="false"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/Parent_CallBlockMode_Title"
                style="@style/TextStyle.Start"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/corners_rectangle_e9e8ec_12_w1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llPhoneBlack"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_17"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_17">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_CallBlacklist_Title"
                        android:layout_weight="1"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:tag="binding_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/check_box_selector"
                        android:layout_marginStart="@dimen/dp_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <View
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llPhoneWhite"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_17"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_17">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Parent_CallWhitelist_Title"
                        android:layout_weight="1"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:tag="binding_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/check_box_selector"
                        android:layout_marginStart="@dimen/dp_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <View
                    android:background="@color/color_border_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llPhoneDefault"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_17"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_17">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/Setting_RadioButton_Default"
                        android:layout_weight="1"
                        style="@style/TextStyle.Start"/>
                    <ImageView
                        android:tag="binding_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/check_box_selector"
                        android:layout_marginStart="@dimen/dp_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:enabled="false"
                android:id="@+id/tv_complete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_40"
                android:layout_marginBottom="@dimen/dp_36"
                android:text="@string/Common_Complete"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cly_close"
                style="@style/ButtonStyle"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
