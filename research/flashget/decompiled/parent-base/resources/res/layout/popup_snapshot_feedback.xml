<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_snapshot_feedback_0"
    android:background="@drawable/bg_white_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">
            <ImageView
                android:id="@+id/iv_icon"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pic_pop_snapshot_feedback"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ScheduledSnapshot_Feedback_Title"
                style="@style/TextStyle.Center"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ScheduledSnapshot_Feedback_Des1"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:id="@+id/tv_desc1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ScheduledSnapshot_Feedback_Des2"
                style="@style/TextStyle.Start"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_need"
                android:background="@drawable/corners_rectangle_e9e8ec_12_w1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/c_161419"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_Yes"
                    style="@style/TextStyle.Start"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_need_select"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/check_box_selector"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_no_need"
                android:background="@drawable/corners_rectangle_e9e8ec_12_w1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/c_161419"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Common_No"
                    style="@style/TextStyle.Start"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_no_need_select"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/check_box_selector"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">
                <TextView
                    android:enabled="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_white"
                    android:gravity="center"
                    android:id="@+id/btn_confirm"
                    android:background="@drawable/corners_rectangle"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:text="@string/fb_btn_commit"
                    android:alpha="0.4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginStart="0dp"
                    style="@style/TextStyle.Center"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="8dp"
        android:visibility="invisible"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/btn_pop_close"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
