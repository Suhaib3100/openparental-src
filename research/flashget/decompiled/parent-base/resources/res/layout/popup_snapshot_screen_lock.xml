<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_snapshot_screen_lock_0"
    android:background="@drawable/bg_white_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_20"
            android:paddingTop="@dimen/dp_24"
            android:paddingRight="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingVertical="@dimen/dp_24">
            <ImageView
                android:id="@+id/iv_icon"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pic_pop_snapshot_failed"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/Snapshot_Failed_Title"
                style="@style/TextStyle.Center"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColorHint="@color/color_text_secondary"
                android:id="@+id/tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/Snapshot_WakeTheScreen_Des"
                style="@style/TextStyle.Start"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColorHint="@color/color_text_secondary"
                android:id="@+id/tv_sub_des"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                style="@style/TextStyle.Start"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_extra"
                android:background="@drawable/corners_recetangle_f4f2f8_12"
                android:paddingLeft="@dimen/dp_12"
                android:paddingTop="@dimen/dp_8"
                android:paddingRight="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_8">
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_text_tertiary"
                    android:id="@+id/tv_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ScreenSnapshot_LockedSnapshot_Tips"
                    android:drawablePadding="@dimen/dp_4"
                    android:drawableStart="@drawable/dot_7e5ded_4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_text_tertiary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/ScreenSnapshot_LockedSnapshot_Tips1"
                    android:drawablePadding="@dimen/dp_4"
                    android:drawableStart="@drawable/dot_7e5ded_4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_tips"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/ScreenSnapshot_WakeTheScreen_Button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="0dp"
                style="@style/ButtonStyle"/>
            <CheckedTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_text_tertiary"
                android:gravity="start|center_vertical"
                android:layout_gravity="start"
                android:id="@+id/cb_dont_remind_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:button="@null"
                android:text="@string/ScreenSnapshot_WakeTheScreen_DoNotAsk"
                android:drawablePadding="@dimen/dp_5"
                android:drawableStart="@drawable/select_app_box_style"
                style="@style/TextStyle.Start"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="8dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/btn_pop_close"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
