<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#63000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/iv_dot"
        android:background="@drawable/dot_f4f3f6"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@drawable/icon_nav_more_black"
        app:layout_constraintBottom_toBottomOf="@+id/iv_dot"
        app:layout_constraintEnd_toEndOf="@+id/iv_dot"
        app:layout_constraintStart_toStartOf="@+id/iv_dot"
        app:layout_constraintTop_toTopOf="@+id/iv_dot"/>
    <View
        android:background="@drawable/red_dot"
        android:layout_width="@dimen/dp_7"
        android:layout_height="@dimen/dp_7"
        android:layout_marginStart="@dimen/dp_18"
        app:layout_constraintBottom_toTopOf="@+id/iv_more"
        app:layout_constraintStart_toStartOf="@+id/iv_more"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_dot">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text_white"
            android:id="@+id/tv_title"
            android:background="@drawable/pic_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SnapshotRecordingPage_ImageFilter_Des"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
