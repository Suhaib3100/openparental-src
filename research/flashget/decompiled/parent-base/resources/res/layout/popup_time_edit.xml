<?xml version="1.0" encoding="utf-8"?>
<com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bp_container"
    android:tag="layout/popup_time_edit_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bp_title="@string/LimitFeature_SetTime_Title">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/corners_rectangle_white_top_16dp"
        android:paddingLeft="@dimen/dp_20"
        android:paddingRight="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_20">
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_start_time"
            android:layout_width="@dimen/dp_74"
            android:layout_height="wrap_content"
            android:text="@string/Calendars_StartTime"
            app:layout_constraintBottom_toBottomOf="@+id/tv_start_time_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_start_time_content"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:gravity="center"
            android:id="@+id/tv_start_time_content"
            android:tag="binding_1"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="22:00"
            android:layout_marginStart="@dimen/dp_10"
            android:paddingVertical="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_start_time"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_text_primary"
            android:gravity="start"
            android:id="@+id/tv_end_time"
            android:layout_width="@dimen/dp_74"
            android:layout_height="wrap_content"
            android:text="@string/Calendars_EndTime"
            app:layout_constraintBottom_toBottomOf="@+id/cly_end_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cly_end_time"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_end_time"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_start_time_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_start_time_content">
            <TextView
                android:textSize="@dimen/sp_15"
                android:gravity="center"
                android:id="@+id/tv_end_time_content"
                android:tag="binding_3"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="22:00"
                android:paddingVertical="@dimen/dp_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:id="@+id/tv_across_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_end_time_content"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_text_primary"
            android:gravity="start"
            android:id="@+id/tv_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:text="@string/CallLogs_Duration"
            app:layout_constraintEnd_toEndOf="@+id/tv_start_time"
            app:layout_constraintStart_toStartOf="@+id/tv_start_time"
            app:layout_constraintTop_toBottomOf="@+id/cly_end_time"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/color_text_primary"
            android:gravity="start"
            android:id="@+id/tv_duration_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22:00"
            app:layout_constraintBottom_toBottomOf="@+id/tv_duration"
            app:layout_constraintEnd_toEndOf="@+id/tv_start_time_content"
            app:layout_constraintStart_toStartOf="@+id/tv_start_time_content"
            app:layout_constraintTop_toTopOf="@+id/tv_duration"/>
        <View
            android:id="@+id/divider"
            android:background="@color/color_border_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_25"
            app:layout_constraintTop_toBottomOf="@+id/tv_duration_content"/>
        <com.flashget.parentalcontrol.widget.wheel.WheelPicker
            android:id="@+id/h_picker"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_220"
            android:paddingStart="@dimen/dp_48"
            app:layout_constraintLeft_toRightOf="@+id/am_pm_picker"
            app:layout_constraintRight_toLeftOf="@+id/min_picker"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:wheel_selected_show_title="h"
            app:wheel_selected_title_margin="0dp"/>
        <com.flashget.parentalcontrol.widget.wheel.WheelPicker
            android:id="@+id/min_picker"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_220"
            android:paddingEnd="@dimen/dp_62"
            app:layout_constraintLeft_toRightOf="@+id/h_picker"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:wheel_selected_show_title="min"
            app:wheel_selected_title_margin="@dimen/dp_8"/>
        <com.flashget.parentalcontrol.widget.wheel.WheelPicker
            android:id="@+id/am_pm_picker"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_220"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/h_picker"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
        <View
            android:background="@drawable/corners_rectangle_197e5ded_8"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:layout_constraintBottom_toBottomOf="@+id/h_picker"
            app:layout_constraintTop_toTopOf="@+id/h_picker"/>
        <TextView
            android:id="@+id/tv_set"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginBottom="@dimen/dp_36"
            android:text="@string/Common_Button_Confirm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/min_picker"
            style="@style/ButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flashget.kid.common.ui.base.dialog.BottomPopupContentLayout>
