<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/parent_profile_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
        android:id="@+id/itemSetting"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_setting"
        app:layout_constraintTop_toTopOf="parent"
        app:mode="oneLine"
        app:title="@string/Common_Settings"/>
    <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
        android:id="@+id/itemHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_help"
        app:layout_constraintTop_toBottomOf="@+id/itemSetting"
        app:mode="oneLine"
        app:title="@string/Common_Help"/>
    <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
        android:id="@+id/itemFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_feedback_blue"
        app:layout_constraintTop_toBottomOf="@+id/itemHelp"
        app:mode="oneLine"
        app:title="@string/Common_feedback"/>
    <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
        android:id="@+id/itemRate"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_score"
        app:layout_constraintTop_toBottomOf="@+id/itemFeedback"
        app:mode="oneLine"
        app:title="@string/parent_about_rate"/>
    <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
        android:id="@+id/itemLanguage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_list_language"
        app:layout_constraintTop_toBottomOf="@+id/itemRate"
        app:mode="oneLine"
        app:title="@string/Common_Language"/>
    <com.flashget.parentalcontrol.ui.component.ProfileItemPreference
        android:id="@+id/itemAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_aboutus"
        app:isShowDivider="false"
        app:layout_constraintTop_toBottomOf="@+id/itemLanguage"
        app:mode="oneLine"
        app:subText="@string/parent_app_version"
        app:title="@string/Parent_Setting_About"/>
</androidx.constraintlayout.widget.ConstraintLayout>
