<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/device_fragment_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.046"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.954"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.087"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.913"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/device_fragment_black_text"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Parent_Device_RemoteOperation"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toTopOf="@+id/glTop"
        style="@style/TextStyle.Start"/>
    <TextView
        android:textColor="@color/device_fragment_black_text"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvRemoteObserve"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/Parent_Device_Remote_Camera_Title"
        android:maxLines="2"
        android:layout_weight="1"
        android:layout_marginEnd="10dp"
        app:drawableTopCompat="@drawable/device_ic_screen"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toStartOf="@+id/tvRemoteCamera"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintVertical_bias="0"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textColor="@color/device_fragment_black_text"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvRemoteCamera"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Parent_Device_Screenshot_Title"
        android:maxLines="2"
        android:layout_weight="1"
        android:layout_marginEnd="10dp"
        app:drawableTopCompat="@drawable/device_ic_camera"
        app:layout_constraintBottom_toTopOf="@+id/glBottom"
        app:layout_constraintEnd_toStartOf="@+id/tvRemoteOverhear"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvRemoteObserve"
        app:layout_constraintTop_toTopOf="@+id/tvRemoteObserve"
        app:layout_constraintVertical_bias="0"
        style="@style/TextStyle.Center"/>
    <TextView
        android:textColor="@color/device_fragment_black_text"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvRemoteOverhear"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Parent_Device_Listening_Title"
        android:maxLines="2"
        android:layout_weight="1"
        app:drawableTopCompat="@drawable/device_ic_listen"
        app:layout_constraintBottom_toTopOf="@+id/glBottom"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvRemoteCamera"
        app:layout_constraintTop_toTopOf="@+id/tvRemoteObserve"
        app:layout_constraintVertical_bias="0"
        style="@style/TextStyle.Center"/>
</androidx.constraintlayout.widget.ConstraintLayout>
