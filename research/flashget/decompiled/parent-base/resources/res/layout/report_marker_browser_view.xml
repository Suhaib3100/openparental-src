<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/pic_bar_tooltip"
        android:paddingBottom="@dimen/dp_7"
        android:layout_width="@dimen/dp_90"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_text_white"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_time"
            android:paddingLeft="@dimen/dp_4"
            android:paddingRight="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_1"
            android:layout_marginBottom="@dimen/dp_2"
            android:text="17:00-18:00"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dp_2"
            android:paddingHorizontal="@dimen/dp_4"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_text_white"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_visit"
            android:paddingLeft="@dimen/dp_4"
            android:paddingRight="@dimen/dp_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:text="##访问：75"
            android:paddingHorizontal="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_visit_week"
            app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
        <ImageView
            android:id="@+id/img_visit_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/dot_2bdb80"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/tv_visit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_visit"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_text_white"
            android:id="@+id/tv_block"
            android:paddingLeft="@dimen/dp_4"
            android:paddingRight="@dimen/dp_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_2"
            android:text="##访问：75"
            android:paddingHorizontal="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_block_week"
            app:layout_constraintTop_toBottomOf="@+id/tv_visit"/>
        <ImageView
            android:id="@+id/img_block_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/dot_f55e61"
            app:layout_constraintBottom_toBottomOf="@+id/tv_block"
            app:layout_constraintStart_toStartOf="@+id/img_visit_week"
            app:layout_constraintTop_toTopOf="@+id/tv_block"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
