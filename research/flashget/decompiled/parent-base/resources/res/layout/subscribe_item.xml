<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileItemLayout"
    android:background="@drawable/gradient_left2right_bp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/dp_12"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/dp_12"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glImageStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glImageEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <ImageView
        android:id="@+id/ivProfileIcon"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:src="@drawable/ic_free_trial"
        app:layout_constraintStart_toStartOf="@+id/glImageStart"
        app:layout_constraintTop_toTopOf="@+id/glTop"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_white"
        android:id="@+id/tvProfileTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textDirection="locale"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@+id/llSub"
        app:layout_constraintStart_toEndOf="@+id/ivProfileIcon"
        app:layout_constraintTop_toTopOf="@+id/glTop"
        style="@style/TextStyle.Start"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="pbProfileDays,llSub,ivProfileIcon,tvProfileTitle"/>
    <View
        android:id="@+id/vDrivider"
        android:background="@drawable/drivider_white_alpha10"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/glImageEnd"
        app:layout_constraintStart_toStartOf="@+id/glImageStart"
        app:layout_constraintTop_toBottomOf="@+id/barrier"/>
    <ProgressBar
        android:id="@+id/pbProfileDays"
        android:layout_width="122dp"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:max="365"
        android:progress="307"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/ivProfileIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvProfileTitle"
        style="@style/parent_profile_progress_bar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_text_white"
        android:id="@+id/tvProfileContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toEndOf="@+id/llSub"
        app:layout_constraintStart_toStartOf="@+id/ivProfileIcon"
        app:layout_constraintTop_toBottomOf="@+id/vDrivider"
        style="@style/TextStyle.Start"/>
    <ImageView
        android:id="@+id/right_bg"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/pic_subscribe_crown_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llSub"
        android:background="@drawable/corners_rectangle_y100"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/glImageEnd"
        app:layout_constraintTop_toTopOf="@+id/ivProfileIcon">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_primary"
            android:gravity="center"
            android:id="@+id/tvSubContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="6dp"
            style="@style/TextStyle.Center"/>
        <ImageView
            android:id="@+id/ivProfileSubIcon"
            android:background="@drawable/icon_list_more_arrow_purple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <View
        android:id="@+id/vProfileDivider"
        android:background="@color/color_border_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/glImageEnd"
        app:layout_constraintStart_toStartOf="@+id/glImageStart"/>
</androidx.constraintlayout.widget.ConstraintLayout>
