<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_rectangle_white"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <ImageView
        android:id="@+id/ivPrevDay"
        android:background="@drawable/corners_recetangle_color_border_2_20"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/date_btn_left"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dividerStart"
        android:background="@color/white_f2f0f2"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/ivPrevDay"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/llCalendar"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivCalendar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/positioning_btn_data"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8月19日  昨天"
            android:layout_marginStart="10dp"
            style="@style/TextStyle.Center"/>
    </LinearLayout>
    <View
        android:id="@+id/dividerEnd"
        android:background="@color/white_f2f0f2"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/ivNextDay"/>
    <ImageView
        android:id="@+id/ivNextDay"
        android:background="@drawable/corners_recetangle_color_border_2_20"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/date_btn_right"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
