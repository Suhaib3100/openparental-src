<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/usage_limit_bg"
    android:padding="@dimen/dp_16"
    android:paddingLeft="@dimen/dp_16"
    android:paddingRight="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_text_primary"
        android:ellipsize="end"
        android:id="@+id/tvUsageLimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="80dp"
        android:text="@string/Parent_UsageLimit_Name"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/etLimitName"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
    <View
        android:id="@+id/vDivider"
        android:background="@color/color_border_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="13sp"
        android:textColor="@color/color_text_primary"
        android:textColorHint="@color/color_text_tertiary"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/etLimitName"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:minWidth="80dp"
        android:hint="@string/Parent_UsageLimit_Name_Placeholder"
        android:lines="1"
        android:maxLength="200"
        android:inputType="text"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/tvUsageLimit"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.End"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_text_secondary"
        android:id="@+id/tvOpenUsageLimit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Parent_UsageLimit_Enable"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vDivider"
        style="@style/TextStyle.Start"/>
    <ToggleButton
        android:id="@+id/tgUsageLimit"
        android:background="@drawable/toggle_button"
        android:visibility="gone"
        android:saveEnabled="false"
        android:layout_width="38dp"
        android:layout_height="24dp"
        android:checked="false"
        android:textOn=""
        android:textOff=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vDivider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
