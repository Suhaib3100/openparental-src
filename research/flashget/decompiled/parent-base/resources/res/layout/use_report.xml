<?xml version="1.0" encoding="utf-8"?>
<com.flashget.parentalcontrol.widget.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/use_report_0"
    android:background="@drawable/corners_rectangle_white_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="96dp"
    app:layout_constraintTop_toTopOf="parent"
    app:rcClipBackground="true"
    app:rcRadius="@dimen/dp_16">
    <ImageView
        android:id="@+id/img_use"
        android:layout_width="@dimen/dp_69"
        android:layout_height="@dimen/dp_74"
        android:src="@drawable/pic_report_bar_chart"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/report_content"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img_use"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_use_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Parent_UsageReport_Title"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:drawablePadding="@dimen/dp_2"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/cly_right"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_list_more_arrow"
            app:layout_constraintBottom_toBottomOf="@+id/tv_use_title"
            app:layout_constraintEnd_toStartOf="@+id/tv_use_tips"
            app:layout_constraintStart_toEndOf="@+id/cly_right"
            app:layout_constraintTop_toTopOf="@+id/tv_use_title"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_text_white"
            android:id="@+id/tv_use_tips"
            android:background="@drawable/corners_rectagle_ff6479_9dp"
            android:paddingLeft="@dimen/dp_4"
            android:paddingTop="@dimen/dp_1"
            android:paddingRight="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New"
            android:layout_marginStart="@dimen/dp_6"
            android:paddingHorizontal="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_use_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_arrow"
            app:layout_constraintTop_toTopOf="@+id/tv_use_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_text_primary"
            android:id="@+id/tv_report_empty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/Homepage_UsageReport_Des"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_use_title"/>
        <ViewFlipper
            android:id="@+id/view_flipper"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:flipInterval="5000"
            android:autoStart="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_use_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_screen_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img_screen_time"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/icon_home_report_screen_time"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/screen_time_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/img_screen_time"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/screen_time_progress_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/color_text_primary"
                            android:ellipsize="end"
                            android:id="@+id/tv_screen_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tv_screen_duration"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/color_text_primary"
                            android:id="@+id/tv_screen_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:layout_marginStart="2dp"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_screen_time"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_screen_time"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <ProgressBar
                        android:id="@+id/pb_screen_time"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/report_hor_progress_drawable_two"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/color_text_secondary"
                        android:ellipsize="end"
                        android:id="@+id/tv_screen_time_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/kid_list_screen_usage_title"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_text_primary"
                        android:id="@+id/tv_screen_time_standalone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cly_app_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img_app"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_text_secondary"
                    android:ellipsize="end"
                    android:id="@+id/tv_most_used"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/UsageReport_MostUsed_Title"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_marginStart="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/img_app"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/tv_app_use_time"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="@+id/tv_most_used"
                    app:layout_constraintTop_toBottomOf="@+id/tv_most_used"
                    style="@style/TextStyle.Start"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_text_primary"
                    android:id="@+id/tv_app_use_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_app_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_app_name"
                    style="@style/TextStyle.Start"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ViewFlipper>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cly_right"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_use_title"
            app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
            app:layout_constraintStart_toEndOf="@+id/tv_use_title"
            app:layout_constraintTop_toTopOf="@+id/tv_use_title">
            <ImageView
                android:id="@+id/img_report_dot"
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                android:src="@drawable/dot_shape_unread_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_primary"
        android:gravity="center"
        android:id="@+id/tv_pro"
        android:tag="binding_1"
        android:background="@drawable/user_report_pro"
        android:paddingLeft="@dimen/dp_10"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRO"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Start"/>
</com.flashget.parentalcontrol.widget.RoundConstraintLayout>
