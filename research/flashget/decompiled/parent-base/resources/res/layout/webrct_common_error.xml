<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_ws_disconnect"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="25dp"
        android:paddingEnd="25dp">
        <ImageView
            android:id="@+id/ivLinkUnable"
            android:layout_width="@dimen/failed_page_anim_width"
            android:layout_height="@dimen/failed_page_anim_height"
            android:layout_marginTop="130dp"
            android:src="@drawable/pic_blankpage_no_screenshot_permission"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/sw_connection_fail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/Snapshot_ScreenLocked_Des"
            app:layout_constraintTop_toBottomOf="@+id/ivLinkUnable"
            style="@style/TextStyle.Center"/>
        <TextView
            android:id="@+id/tv_try"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/Common_Retry_Title"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_to_see"
            style="@style/FailPageBtnStyle.Main"/>
        <TextView
            android:id="@+id/tv_to_see"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="36dp"
            android:text="@string/Common_GetHelp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/FailPageBtnStyle.LightMain"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
