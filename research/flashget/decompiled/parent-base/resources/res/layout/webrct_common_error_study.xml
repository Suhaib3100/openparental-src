<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/webrct_common_error_study_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.flashget.parentalcontrol.widget.TopScrollView
        android:orientation="vertical"
        android:id="@+id/ll_ws_disconnect"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_20"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_try"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/img_error"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/webrtc_connection_img_top"
                android:src="@drawable/pic_blankpage_no_screenshot_permission"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_error_title_top"
                android:layout_marginLeft="@dimen/failed_page_content_title_margin_horizontal"
                android:layout_marginTop="@dimen/failed_page_content_icon_and_title_space"
                android:layout_marginRight="@dimen/failed_page_content_title_margin_horizontal"
                android:text=""
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/failed_page_content_title_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/img_error"
                style="@style/FailPageContentTitleStyle"/>
            <TextView
                android:textSize="@dimen/failed_page_content_title_text_size"
                android:gravity="center"
                android:id="@+id/tv_error_title"
                android:paddingBottom="@dimen/dp_10"
                android:layout_marginLeft="@dimen/failed_page_content_desc_margin_horizontal"
                android:layout_marginTop="@dimen/failed_page_content_icon_and_title_space"
                android:layout_marginRight="@dimen/failed_page_content_desc_margin_horizontal"
                android:text="@string/Snapshot_ScreenLocked_Des"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/failed_page_content_desc_margin_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tv_error_title_top"
                style="@style/FailPageContentDescStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.flashget.parentalcontrol.widget.TopScrollView>
    <TextView
        android:id="@+id/tv_try"
        android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginBottom="@dimen/failed_page_btn_sapce"
        android:text="@string/Common_Retry_Title"
        android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/tv_to_see"
        app:layout_goneMarginBottom="@dimen/failed_page_padding_bottom"
        style="@style/FailPageBtnStyle.Main"/>
    <TextView
        android:id="@+id/tv_to_see"
        android:layout_marginLeft="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginRight="@dimen/failed_page_btn_margin_horizontal"
        android:layout_marginBottom="@dimen/failed_page_padding_bottom"
        android:text="@string/Common_GetHelp"
        android:layout_marginHorizontal="@dimen/failed_page_btn_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/FailPageBtnStyle.LightMain"/>
</androidx.constraintlayout.widget.ConstraintLayout>
